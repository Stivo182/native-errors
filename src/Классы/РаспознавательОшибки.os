Перем _Кадры; // Массив из ФиксированнаяСтруктура
Перем _ТочныеОписания; // Соответствие из КлючИЗначение:
                       //  * Ключ - Строка - Описание кадра, доступное для поиска.
                       //  * Значение - Булево - Всегда Истина.
Перем _КадрыПоНативномуТипу; // Соответствие из КлючИЗначение:
                             //  * Ключ - Строка - Имя .NET-типа исключения.
                             //  * Значение - Массив из ФиксированнаяСтруктура - Кадры с этим .NET-типом.

#Область ОбработчикиСобытий

// Инициализирует распознаватель ошибки для использования библиотекой.
// Прямое создание экземпляра не поддерживается.
//
// Параметры:
//  Кадры - Массив из ФиксированнаяСтруктура - Кадры ошибки для поиска.
Процедура ПриСозданииОбъекта(Кадры)

	_Кадры = Кадры;

	_ТочныеОписания = Новый Соответствие;
	_КадрыПоНативномуТипу = Новый Соответствие;

	ИндексироватьКадры();

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Проверяет наличие типа .NET-исключения в цепочке причин.
//
// Параметры:
//  НативныйТип - Строка - Полное имя типа .NET-исключения.
//
// Возвращаемое значение:
//  Булево - Истина, если тип найден в цепочке.
Функция СодержитТип(НативныйТип) Экспорт

	Возврат _КадрыПоНативномуТипу.Получить(НативныйТип) <> Неопределено;

КонецФункции

// Возвращает первый найденный тип .NET-исключения из переданного списка.
//
// Параметры:
//  НативныеТипы - Массив из Строка - Полные имена типов .NET-исключений.
//
// Возвращаемое значение:
//  Строка, Неопределено - Найденное имя типа или Неопределено.
Функция НайтиТип(НативныеТипы) Экспорт

	Для Каждого НативныйТип Из НативныеТипы Цикл
		Если СодержитТип(НативныйТип) Тогда
			Возврат НативныйТип;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Проверяет наличие точного сообщения в цепочке причин.
//
// Параметры:
//  ШаблонСообщения - Строка - Обычная строка или шаблон НСтр с вариантами ru и en.
//
// Возвращаемое значение:
//  Булево - Истина, если сообщение найдено в цепочке.
Функция СодержитТочноеСообщение(ШаблонСообщения) Экспорт

	Возврат ТочноеСообщениеСоответствуетШаблону(ШаблонСообщения);

КонецФункции

// Проверяет префикс сообщения в цепочке причин.
//
// Параметры:
//  ШаблонПрефикса - Строка - Обычная строка или шаблон НСтр с вариантами ru и en.
//
// Возвращаемое значение:
//  Булево - Истина, если префикс найден в цепочке.
Функция СодержитПрефиксСообщения(ШаблонПрефикса) Экспорт

	Для Каждого Кадр Из _Кадры Цикл
		Если ЭтоТекстКадраДляПоиска(Кадр)
			И СтрокаНачинаетсяСШаблоном(Кадр.Описание, ШаблонПрефикса) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Проверяет наличие фрагмента сообщения в цепочке причин.
//
// Параметры:
//  ШаблонФрагмента - Строка - Обычная строка или шаблон НСтр с вариантами ru и en.
//
// Возвращаемое значение:
//  Булево - Истина, если фрагмент найден в цепочке.
Функция СодержитФрагментСообщения(ШаблонФрагмента) Экспорт

	Для Каждого Кадр Из _Кадры Цикл
		Если ЭтоТекстКадраДляПоиска(Кадр)
			И СтрокаСодержитШаблон(Кадр.Описание, ШаблонФрагмента) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Проверяет наличие фрагмента и окончания одного сообщения в цепочке причин.
//
// Параметры:
//  ШаблонФрагмента - Строка - Обычная строка или шаблон НСтр с вариантами ru и en.
//  ШаблонОкончания - Строка - Обычная строка или шаблон НСтр с вариантами ru и en.
//
// Возвращаемое значение:
//  Булево - Истина, если фрагмент и окончание найдены в одном сообщении цепочки.
Функция СодержитФрагментИОкончаниеСообщения(ШаблонФрагмента, ШаблонОкончания) Экспорт

	Для Каждого Кадр Из _Кадры Цикл
		Если ЭтоТекстКадраДляПоиска(Кадр)
			И СтрокаСодержитСогласованноеОбрамление(
			Кадр.Описание,
			ШаблонФрагмента,
			ШаблонОкончания
		) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Проверяет тип .NET-исключения и окончание сообщения в одном кадре цепочки.
//
// Параметры:
//  НативныйТип - Строка - Полное имя типа .NET-исключения.
//  ШаблонОкончания - Строка - Обычная строка или шаблон НСтр с вариантами ru и en.
//
// Возвращаемое значение:
//  Булево - Истина, если тип и окончание найдены в одном кадре.
Функция СодержитТипИОкончаниеСообщения(НативныйТип, ШаблонОкончания) Экспорт

	КадрыТипа = _КадрыПоНативномуТипу.Получить(НативныйТип);
	Если КадрыТипа = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Кадр Из КадрыТипа Цикл
		Если ЭтоТекстКадраДляПоиска(Кадр)
			И Кадр.НативныйТип = НативныйТип
			И СтрокаЗаканчиваетсяНаШаблон(Кадр.Описание, ШаблонОкончания) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Проверяет тип .NET-исключения и фрагмент сообщения в одном кадре цепочки.
//
// Параметры:
//  НативныйТип - Строка - Полное имя типа .NET-исключения.
//  ШаблонФрагмента - Строка - Обычная строка или шаблон НСтр с вариантами ru и en.
//
// Возвращаемое значение:
//  Булево - Истина, если тип и фрагмент найдены в одном кадре.
Функция СодержитТипИФрагментСообщения(НативныйТип, ШаблонФрагмента) Экспорт

	КадрыТипа = _КадрыПоНативномуТипу.Получить(НативныйТип);
	Если КадрыТипа = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Кадр Из КадрыТипа Цикл
		Если ЭтоТекстКадраДляПоиска(Кадр)
			И Кадр.НативныйТип = НативныйТип
			И СтрокаСодержитШаблон(Кадр.Описание, ШаблонФрагмента) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Проверяет тип, локализованные фрагмент и окончание сообщения.
//
// Параметры:
//  НативныйТип - Строка - Полное имя типа .NET-исключения.
//  ШаблонФрагмента - Строка - Обычная строка или шаблон НСтр фрагмента сообщения.
//  ШаблонОкончания - Строка - Обычная строка или шаблон НСтр окончания сообщения.
//
// Возвращаемое значение:
//  Булево - Истина, если тип и обрамление найдены в одном кадре.
Функция СодержитТипИОбрамлениеСообщения(
	НативныйТип,
	ШаблонФрагмента,
	ШаблонОкончания
) Экспорт

	КадрыТипа = _КадрыПоНативномуТипу.Получить(НативныйТип);
	Если КадрыТипа = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Кадр Из КадрыТипа Цикл
		Если ЭтоТекстКадраДляПоиска(Кадр)
			И СтрокаСодержитСогласованноеОбрамление(
			Кадр.Описание,
			ШаблонФрагмента,
			ШаблонОкончания
		) И Кадр.НативныйТип = НативныйТип Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Проверяет локализованные префикс и окончание сообщения с переменной средней частью.
//
// Параметры:
//  ШаблонПрефикса - Строка - Обычная строка или шаблон НСтр префикса сообщения.
//  ШаблонОкончания - Строка - Обычная строка или шаблон НСтр окончания сообщения.
//
// Возвращаемое значение:
//  Булево - Истина, если начало и окончание найдены в одном кадре.
Функция СодержитПрефиксИОкончаниеСообщения(ШаблонПрефикса, ШаблонОкончания) Экспорт

	Для Каждого Кадр Из _Кадры Цикл
		Если ЭтоТекстКадраДляПоиска(Кадр)
			И СтрокаНачинаетсяИЗаканчиваетсяВариантами(
			Кадр.Описание,
			ШаблонПрефикса,
			ШаблонОкончания
		) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

#КонецОбласти


#Область СлужебныеПроцедурыИФункции

Функция ЭтоТекстКадраДляПоиска(Кадр)
	Возврат _ТочныеОписания.Получить(Кадр.Описание) = Истина;
КонецФункции

Процедура ИндексироватьКадры()

	Для Каждого Кадр Из _Кадры Цикл
		Если Не Кадр.РазрешенДляПоиска Тогда
			Продолжить;
		КонецЕсли;

		_ТочныеОписания.Вставить(Кадр.Описание, Истина);
		Если Кадр.НативныйТип = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		КадрыТипа = _КадрыПоНативномуТипу.Получить(Кадр.НативныйТип);
		Если КадрыТипа = Неопределено Тогда
			КадрыТипа = Новый Массив;
			_КадрыПоНативномуТипу.Вставить(Кадр.НативныйТип, КадрыТипа);
		КонецЕсли;

		КадрыТипа.Добавить(Кадр);
	КонецЦикла;

КонецПроцедуры

Функция ТочноеСообщениеСоответствуетШаблону(Шаблон)

	ПервыйВариант = ПервыйВариантШаблона(Шаблон);
	Если _ТочныеОписания.Получить(ПервыйВариант) = Истина Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат ЭтоЛокализованныйШаблон(Шаблон)
		И _ТочныеОписания.Получить(НСтр(Шаблон, "en")) = Истина;

КонецФункции

Функция СтрокаНачинаетсяСШаблоном(Строка, Шаблон)

	Если СтрНачинаетсяС(Строка, ПервыйВариантШаблона(Шаблон)) Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат ЭтоЛокализованныйШаблон(Шаблон)
		И СтрНачинаетсяС(Строка, НСтр(Шаблон, "en"));

КонецФункции

Функция СтрокаЗаканчиваетсяНаШаблон(Строка, Шаблон)

	Если СтрЗаканчиваетсяНа(Строка, ПервыйВариантШаблона(Шаблон)) Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат ЭтоЛокализованныйШаблон(Шаблон)
		И СтрЗаканчиваетсяНа(Строка, НСтр(Шаблон, "en"));

КонецФункции

Функция СтрокаСодержитШаблон(Строка, Шаблон)

	Если СтрНайти(Строка, ПервыйВариантШаблона(Шаблон)) > 0 Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат ЭтоЛокализованныйШаблон(Шаблон)
		И СтрНайти(Строка, НСтр(Шаблон, "en")) > 0;

КонецФункции

Функция СтрокаСодержитСогласованноеОбрамление(Строка, ШаблонФрагмента, ШаблонОкончания)

	Если СтрокаСоответствуетОбрамлению(
		Строка,
		ПервыйВариантШаблона(ШаблонФрагмента),
		ПервыйВариантШаблона(ШаблонОкончания)
	) Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат (ЭтоЛокализованныйШаблон(ШаблонФрагмента)
		Или ЭтоЛокализованныйШаблон(ШаблонОкончания))
		И СтрокаСоответствуетОбрамлению(
			Строка,
			АнглийскийВариантШаблона(ШаблонФрагмента),
			АнглийскийВариантШаблона(ШаблонОкончания)
		);

КонецФункции

Функция СтрокаНачинаетсяИЗаканчиваетсяВариантами(Строка, ШаблонПрефикса, ШаблонОкончания)

	Если СтрокаНачинаетсяИЗаканчивается(
		Строка,
		ПервыйВариантШаблона(ШаблонПрефикса),
		ПервыйВариантШаблона(ШаблонОкончания)
	) Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат (ЭтоЛокализованныйШаблон(ШаблонПрефикса)
		Или ЭтоЛокализованныйШаблон(ШаблонОкончания))
		И СтрокаНачинаетсяИЗаканчивается(
			Строка,
			АнглийскийВариантШаблона(ШаблонПрефикса),
			АнглийскийВариантШаблона(ШаблонОкончания)
		);

КонецФункции

Функция СтрокаСоответствуетОбрамлению(Строка, Начало, Окончание)

	Возврат СтрНайти(Строка, Начало) > 0
		И (ПустаяСтрока(Окончание) Или СтрЗаканчиваетсяНа(Строка, Окончание));

КонецФункции

Функция СтрокаНачинаетсяИЗаканчивается(Строка, Начало, Окончание)

	Возврат СтрНачинаетсяС(Строка, Начало)
		И (ПустаяСтрока(Окончание) Или СтрЗаканчиваетсяНа(Строка, Окончание));

КонецФункции

Функция АнглийскийВариантШаблона(Шаблон)

	Если ЭтоЛокализованныйШаблон(Шаблон) Тогда
		Возврат НСтр(Шаблон, "en");
	КонецЕсли;

	Возврат Шаблон;

КонецФункции

Функция ПервыйВариантШаблона(Шаблон)

	Если ЭтоЛокализованныйШаблон(Шаблон) Тогда
		Возврат НСтр(Шаблон, "ru");
	КонецЕсли;

	Возврат Шаблон;

КонецФункции

Функция ЭтоЛокализованныйШаблон(Шаблон)

	Если СтрНайти(Шаблон, "=") = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	НормализованныйШаблон = СтрЗаменить(НРег(СокрЛП(Шаблон)), " ", "");
	Возврат СтрНайти(НормализованныйШаблон, "ru=") > 0
		И СтрНайти(НормализованныйШаблон, "en=") > 0;

КонецФункции


#КонецОбласти
