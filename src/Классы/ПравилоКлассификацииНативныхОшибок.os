// BSLLS:ExportVariables-off
Перем Способ Экспорт; // Число - Идентификатор способа сопоставления ошибки.
Перем НативныйТип Экспорт; // Строка - Полное имя нативного типа или пустая строка.
Перем ШаблонСообщения Экспорт; // Строка - Шаблон полного сообщения.
Перем Префикс Экспорт; // Строка - Шаблон префикса сообщения.
Перем Фрагмент Экспорт; // Строка - Шаблон фрагмента сообщения.
Перем Окончание Экспорт; // Строка - Шаблон окончания сообщения.
Перем КодОшибки Экспорт; // Строка - Код классифицированной ошибки.
Перем Сообщение Экспорт; // Строка - Нормализованное сообщение или шаблон НСтр.
Перем Идентификатор Экспорт; // Строка - Внутренний идентификатор правила.

#Область ОбработчикиСобытий

// Создаёт правило классификации нативной ошибки.
// Для обычного создания используйте ФабрикаПравилНативныхОшибок.
//
// Параметры:
//  Способ - Число - Идентификатор из СпособыСопоставленияНативныхОшибок.
//  КодОшибки - Строка - Код классифицированной ошибки.
//  Сообщение - Строка - Нормализованное сообщение или шаблон НСтр.
//  НативныйТип - Строка - Полное имя нативного типа или пустая строка. Значение по умолчанию "".
//  ШаблонСообщения - Строка - Шаблон полного сообщения. Значение по умолчанию "".
//  Префикс - Строка - Шаблон префикса сообщения. Значение по умолчанию "".
//  Фрагмент - Строка - Шаблон фрагмента сообщения. Значение по умолчанию "".
//  Окончание - Строка - Шаблон окончания сообщения. Значение по умолчанию "".
//  Идентификатор - Строка - Внутренний идентификатор правила. Значение по умолчанию "".
Процедура ПриСозданииОбъекта(
	Способ,
	КодОшибки,
	Сообщение,
	НативныйТип = "",
	ШаблонСообщения = "",
	Префикс = "",
	Фрагмент = "",
	Окончание = "",
	Идентификатор = "")

	ЭтотОбъект.Способ = Способ;
	ЭтотОбъект.НативныйТип = НативныйТип;
	ЭтотОбъект.ШаблонСообщения = ШаблонСообщения;
	ЭтотОбъект.Префикс = Префикс;
	ЭтотОбъект.Фрагмент = Фрагмент;
	ЭтотОбъект.Окончание = Окончание;
	ЭтотОбъект.КодОшибки = КодОшибки;
	ЭтотОбъект.Сообщение = Сообщение;
	ЭтотОбъект.Идентификатор = Идентификатор;

КонецПроцедуры

#КонецОбласти
