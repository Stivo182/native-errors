// BSLLS:ExportVariables-off
Перем Способ Экспорт; // Число - Идентификатор способа сопоставления ошибки.
Перем НативныйТип Экспорт; // Строка - Полное имя нативного типа или пустая строка.
Перем Начало Экспорт; // Строка - Сообщение, префикс или фрагмент сообщения.
Перем Окончание Экспорт; // Строка - Окончание сообщения.
Перем КодОшибки Экспорт; // Строка - Код классифицированной ошибки.
Перем Сообщение Экспорт; // Строка - Нормализованное сообщение ошибки.

#Область ОбработчикиСобытий

// Создаёт правило классификации нативной ошибки.
// Для обычного создания используйте ФабрикаПравилНативныхОшибок.
//
// Параметры:
//  Способ - Число - Идентификатор из СпособыСопоставленияНативныхОшибок.
//  НативныйТип - Строка - Полное имя нативного типа или пустая строка.
//  Начало - Строка - Сообщение, префикс или фрагмент сообщения.
//  Окончание - Строка - Окончание сообщения.
//  КодОшибки - Строка - Код классифицированной ошибки.
//  Сообщение - Строка - Нормализованное сообщение ошибки.
Процедура ПриСозданииОбъекта(
	Способ,
	НативныйТип,
	Начало,
	Окончание,
	КодОшибки,
	Сообщение)

	ЭтотОбъект.Способ = Способ;
	ЭтотОбъект.НативныйТип = НативныйТип;
	ЭтотОбъект.Начало = Начало;
	ЭтотОбъект.Окончание = Окончание;
	ЭтотОбъект.КодОшибки = КодОшибки;
	ЭтотОбъект.Сообщение = Сообщение;

КонецПроцедуры

#КонецОбласти
