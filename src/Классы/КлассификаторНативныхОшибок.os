#Использовать errors
#Использовать "../internal"

Перем _ПользовательскиеКлассификаторы; // Массив из Произвольный
Перем _ВстроенныеКлассификаторы; // Массив из Произвольный

#Область ОбработчикиСобытий

// Создаёт классификатор нативных ошибок.
// Классифицирует коды ошибок файловой системы, JSON, XML, двоичных данных,
// текста, потоков, HTTP, прокси и сети из КодыНативныхОшибок.
//
// Экземпляр безопасен для параллельной классификации после настройки.
// Не добавляйте классификаторы одновременно с вызовами Классифицировать.
&Желудь
Процедура ПриСозданииОбъекта()

	_ПользовательскиеКлассификаторы = Новый Массив;

	_ВстроенныеКлассификаторы = Новый Массив;
	_ВстроенныеКлассификаторы.Добавить(Новый КлассификаторОшибокФайловойСистемы);
	_ВстроенныеКлассификаторы.Добавить(Новый КлассификаторОшибокПотоков);
	_ВстроенныеКлассификаторы.Добавить(Новый КлассификаторОшибокJSON);
	_ВстроенныеКлассификаторы.Добавить(Новый КлассификаторОшибокXML);
	_ВстроенныеКлассификаторы.Добавить(Новый КлассификаторОшибокТекста);
	_ВстроенныеКлассификаторы.Добавить(Новый КлассификаторОшибокДвоичныхДанных);
	_ВстроенныеКлассификаторы.Добавить(Новый КлассификаторОшибокHTTP);

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Добавляет пользовательский классификатор перед встроенными.
// Пользовательский классификатор должен реализовывать метод
// Классифицировать(Ошибка, Распознаватель) и возвращать ИнформацияОбОшибке или Неопределено.
//
// Параметры:
//  Классификатор - Произвольный - Пользовательский классификатор.
//
// Возвращаемое значение:
//  КлассификаторНативныхОшибок - Этот классификатор.
Функция ДобавитьКлассификатор(Классификатор) Экспорт

	_ПользовательскиеКлассификаторы.Добавить(Классификатор);
	Возврат ЭтотОбъект;

КонецФункции

// Классифицирует исключение поддерживаемого нативного объекта OneScript.
//
// Параметры:
//  Ошибка - ИнформацияОбОшибке - Исходная нативная или уже структурированная ошибка.
//
// Возвращаемое значение:
//  ИнформацияОбОшибке, Неопределено - Нормализованная ошибка либо Неопределено,
//      если ошибка не распознана.
Функция Классифицировать(Ошибка) Экспорт

	Если ДиагностикаОшибок.КодОшибки(Ошибка) <> Неопределено Тогда
		Возврат Ошибка;
	КонецЕсли;

	Распознаватель = Новый РаспознавательЦепочкиОшибок(Ошибка);

	Для Каждого Классификатор Из _ПользовательскиеКлассификаторы Цикл
		Результат = Классификатор.Классифицировать(Ошибка, Распознаватель);
		Если Результат <> Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;

	Результат = КлассифицироватьВстроенными(Ошибка, Распознаватель);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КлассифицироватьВстроенными(Ошибка, Распознаватель)

	Для Каждого Классификатор Из _ВстроенныеКлассификаторы Цикл
		Результат = Классификатор.Классифицировать(Ошибка, Распознаватель);
		Если Результат <> Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

#КонецОбласти
