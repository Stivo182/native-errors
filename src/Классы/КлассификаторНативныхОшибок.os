#Использовать errors
#Использовать "../internal"

Перем _ПользовательскиеКлассификаторы; // Массив из Произвольный
Перем _ИндексыПользовательскихПравил; // Массив из ИндексПравилКлассификацииНативныхОшибок
Перем _СледующийНомерПользовательскогоПравила; // Число
Перем _ИдентификаторыПользовательскихПравил; // Соответствие из КлючИЗначение:
                                             //  * Ключ - Строка - Идентификатор пользовательского правила.
                                             //  * Значение - Соответствие из КлючИЗначение:
                                             //    ** Ключ - Строка - Код пользовательского правила.
                                             //    ** Значение - Булево - Всегда Истина.
Перем _ВстроенныеПравила; // ФиксированныйМассив из ПравилоКлассификацииНативныхОшибок, Неопределено
Перем _ИндексВстроенныхПравил; // ИндексПравилКлассификацииНативныхОшибок, Неопределено
Перем _БлокировкаИнициализации; // БлокировкаРесурса
Перем _ПубличныеКоды; // ФиксированноеСоответствие из КлючИЗначение:
                      //  * Ключ - Строка - Публичный код нативной ошибки.
                      //  * Значение - Булево - Всегда Истина.
                      // Неопределено до первого обращения.

#Область ОбработчикиСобытий

// Создает классификатор нативных ошибок.
// Классифицирует коды ошибок файловой системы, JSON, XML, двоичных данных, текста,
// потоков, HTTP, прокси, сети, URL, преобразования типов, объектов, свойств, вызовов,
// коллекций, таблиц, даты, фоновых задач, операций, числовых ошибок и динамической
// загрузки сценариев из КодыНативныхОшибок.
//
&Желудь
Процедура ПриСозданииОбъекта()

	_ПользовательскиеКлассификаторы = Новый Массив;
	_ИндексыПользовательскихПравил = Новый Массив;
	_СледующийНомерПользовательскогоПравила = 1;
	_ИдентификаторыПользовательскихПравил = Новый Соответствие;
	_БлокировкаИнициализации = Новый БлокировкаРесурса(ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Добавляет пользовательский классификатор перед встроенными.
// Пользовательский классификатор должен реализовывать метод
// Классифицировать(Ошибка, Распознаватель) и возвращать ИнформацияОбОшибке или Неопределено.
// Распознаватель создается библиотекой и предоставляет только методы поиска типов и сообщений.
//
// Параметры:
//  Классификатор - Произвольный - Пользовательский классификатор.
//
// Возвращаемое значение:
//  КлассификаторНативныхОшибок - Этот классификатор.
Функция ДобавитьПользовательскийКлассификатор(Классификатор) Экспорт

	_ПользовательскиеКлассификаторы.Добавить(Классификатор);
	Возврат ЭтотОбъект;

КонецФункции

// Добавляет пользовательские правила перед встроенными правилами.
// Правила применяются после пользовательских классификаторов.
//
// Параметры:
//  Правила - Массив из ПравилоКлассификацииНативныхОшибок - Правила классификации.
//
// Возвращаемое значение:
//  КлассификаторНативныхОшибок - Этот классификатор.
Функция ДобавитьПравила(Правила) Экспорт

	ИндексПравил = Новый ИндексПравилКлассификацииНативныхОшибок(
		Правила,
		"ПользовательскиеПравила",
		_СледующийНомерПользовательскогоПравила
	);
	_ИндексыПользовательскихПравил.Добавить(ИндексПравил);

	НомерПравила = _СледующийНомерПользовательскогоПравила;
	Для Каждого Правило Из Правила Цикл
		ЗарегистрироватьПользовательскоеПравило(Правило, НомерПравила);
		НомерПравила = НомерПравила + 1;
	КонецЦикла;

	_СледующийНомерПользовательскогоПравила = НомерПравила;

	Возврат ЭтотОбъект;

КонецФункции

// Классифицирует исключение поддерживаемого нативного объекта OneScript.
//
// Параметры:
//  Ошибка - ИнформацияОбОшибке - Исходная нативная или уже структурированная ошибка.
//
// Возвращаемое значение:
//  ИнформацияОбОшибке, Неопределено - Нормализованная ошибка либо Неопределено,
//      если ошибка не распознана.
Функция Классифицировать(Ошибка) Экспорт

	КорневойСнимок = Новый СнимокКадраОшибки(Ошибка);
	Если ЭтоПубличныйКод(КорневойСнимок.КодОшибки()) Тогда
		Возврат Ошибка;
	КонецЕсли;

	Возврат КлассифицироватьНеНормализованнуюОшибку(Ошибка, КорневойСнимок);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КлассифицироватьНеНормализованнуюОшибку(Ошибка, КорневойСнимок)

	ЦепочкаКадров = Новый ЦепочкаКадровОшибки(КорневойСнимок);
	Кадры = ЦепочкаКадров.Кадры();

	Результат = КлассифицироватьПользовательскимиКлассификаторами(Ошибка, Кадры);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Если ЭтоРезультатПользовательскогоПравила(КорневойСнимок) Тогда
		Возврат Ошибка;
	КонецЕсли;

	Результат = Неопределено;
	Если ПопробоватьКлассифицироватьСтруктурированнымиКодами(Ошибка, Кадры, Результат) Тогда
		Возврат Результат;
	КонецЕсли;

	Если ПопробоватьКлассифицироватьПользовательскимиПравилами(Ошибка, Кадры, Результат) Тогда
		Возврат Результат;
	КонецЕсли;

	Возврат КлассифицироватьВстроеннымиПравилами(Ошибка, Кадры);

КонецФункции

Функция СоздатьПубличныеКоды()

	Коды = Новый Соответствие;
	Для Каждого Код Из КодыНативныхОшибок.Все() Цикл
		Коды.Вставить(Код, Истина);
	КонецЦикла;

	Возврат Новый ФиксированноеСоответствие(Коды);

КонецФункции

Функция ЭтоПубличныйКод(Код)
	Возврат Не ПустаяСтрока(Код) И ПолучитьПубличныеКоды().Получить(Код) = Истина;
КонецФункции

Функция ПолучитьПубличныеКоды()

	Если _ПубличныеКоды = Неопределено Тогда
		_БлокировкаИнициализации.Заблокировать();

		Попытка
			Если _ПубличныеКоды = Неопределено Тогда
				_ПубличныеКоды = СоздатьПубличныеКоды();
			КонецЕсли;
		Исключение
			_БлокировкаИнициализации.Разблокировать();
			ВызватьИсключение;
		КонецПопытки;

		_БлокировкаИнициализации.Разблокировать();
	КонецЕсли;

	Возврат _ПубличныеКоды;

КонецФункции

Функция ПолучитьИндексВстроенныхПравил()

	Если _ИндексВстроенныхПравил = Неопределено Тогда
		_БлокировкаИнициализации.Заблокировать();

		Попытка
			Если _ИндексВстроенныхПравил = Неопределено Тогда
				_ИндексВстроенныхПравил = Новый ИндексПравилКлассификацииНативныхОшибок(
					ПолучитьВстроенныеПравила(),
					"ВстроенныеПравила"
				);
			КонецЕсли;
		Исключение
			_БлокировкаИнициализации.Разблокировать();
			ВызватьИсключение;
		КонецПопытки;

		_БлокировкаИнициализации.Разблокировать();
	КонецЕсли;

	Возврат _ИндексВстроенныхПравил;

КонецФункции

Функция ПолучитьВстроенныеПравила()

	Если _ВстроенныеПравила = Неопределено Тогда
		_БлокировкаИнициализации.Заблокировать();

		Попытка
			Если _ВстроенныеПравила = Неопределено Тогда
				_ВстроенныеПравила = Новый ПравилаНативныхОшибок().Все();
			КонецЕсли;
		Исключение
			_БлокировкаИнициализации.Разблокировать();
			ВызватьИсключение;
		КонецПопытки;

		_БлокировкаИнициализации.Разблокировать();
	КонецЕсли;

	Возврат _ВстроенныеПравила;

КонецФункции

Функция ЭтоРезультатПользовательскогоПравила(Снимок)

	Данные = Снимок.Данные();
	КодОшибки = Снимок.КодОшибки();
	ИдентификаторПравила = ЗначениеСвойства(Данные, "Правило", "");
	КодыПравила = _ИдентификаторыПользовательскихПравил.Получить(ИдентификаторПравила);

	Возврат ЗначениеСвойства(Данные, "Источник", "") = "ПользовательскиеПравила"
		И Не ПустаяСтрока(КодОшибки)
		И КодыПравила <> Неопределено
		И КодыПравила.Получить(КодОшибки) = Истина;

КонецФункции

Процедура ЗарегистрироватьПользовательскоеПравило(Правило, НомерПравила)

	Идентификатор = ПолучитьИдентификаторПользовательскогоПравила(Правило, НомерПравила);
	КодыПравила = _ИдентификаторыПользовательскихПравил.Получить(Идентификатор);

	Если КодыПравила = Неопределено Тогда
		КодыПравила = Новый Соответствие;
		_ИдентификаторыПользовательскихПравил.Вставить(Идентификатор, КодыПравила);
	КонецЕсли;

	КодыПравила.Вставить(Правило.КодОшибки, Истина);

КонецПроцедуры

Функция ПолучитьИдентификаторПользовательскогоПравила(Правило, НомерПравила)

	Идентификатор = "";
	Попытка
		Идентификатор = Правило.Идентификатор;
	Исключение
		Идентификатор = "";
	КонецПопытки;

	Если Не ПустаяСтрока(Идентификатор) Тогда
		Возврат Идентификатор;
	КонецЕсли;

	Возврат СтрШаблон("ПользовательскиеПравила.%1", НомерПравила);

КонецФункции

Функция КлассифицироватьПользовательскимиКлассификаторами(Ошибка, Кадры)

	Если _ПользовательскиеКлассификаторы.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Распознаватель = Новый РаспознавательОшибки(Кадры);
	Для Каждого Классификатор Из _ПользовательскиеКлассификаторы Цикл
		Результат = Классификатор.Классифицировать(Ошибка, Распознаватель);
		Если Результат <> Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция ПопробоватьКлассифицироватьСтруктурированнымиКодами(Ошибка, Кадры, Результат)

	Кандидаты = СобратьСтруктурированныеКандидаты(Кадры);
	Если Кандидаты.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Кандидат = ВыбратьКандидата(Кандидаты);
	Если Кандидат <> Неопределено Тогда
		Если ДиагностикаОшибок.КодОшибки(Ошибка) = Кандидат.Код Тогда
			Результат = Ошибка;
		Иначе
			Результат = СоздатьНормализованнуюОшибку(
				Ошибка,
				Кандидат,
				ПолучитьСообщениеСтруктурированногоКода(Кандидат.Код)
			);
		КонецЕсли;
	КонецЕсли;

	Возврат Истина;

КонецФункции

Функция ПопробоватьКлассифицироватьПользовательскимиПравилами(Ошибка, Кадры, Результат)

	Кандидат = ВыбратьКандидата(СобратьПользовательскиеКандидаты(Кадры));
	Если Кандидат = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Результат = СоздатьНормализованнуюОшибку(Ошибка, Кандидат);
	Возврат Истина;

КонецФункции

Функция КлассифицироватьВстроеннымиПравилами(Ошибка, Кадры)

	Кандидат = ВыбратьКандидата(СобратьВстроенныеКандидаты(Кадры));
	Если Кандидат = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат СоздатьНормализованнуюОшибку(Ошибка, Кандидат);

КонецФункции

Функция СобратьСтруктурированныеКандидаты(Кадры)

	Кандидаты = Новый Массив;

	Для Каждого Кадр Из Кадры Цикл
		Если ПустаяСтрока(Кадр.КодОшибки) Тогда
			Продолжить;
		КонецЕсли;

		Если Не ЭтоПубличныйКод(Кадр.КодОшибки) Тогда
			Продолжить;
		КонецЕсли;

		Источник = ЗначениеСвойства(Кадр.Данные, "Источник", "СтруктурированнаяОшибка");
		Правило = ЗначениеСвойства(Кадр.Данные, "Правило", Кадр.КодОшибки);

		Кандидаты.Добавить(НовыйКандидат(
			Кадр.КодОшибки,
			Кадр,
			300,
			Правило,
			Источник,
			Кадр.Описание
		));
	КонецЦикла;

	Возврат Кандидаты;

КонецФункции

Функция ПолучитьСообщениеСтруктурированногоКода(КодОшибки)

	Для Каждого Правило Из ПолучитьВстроенныеПравила() Цикл
		Если Правило.КодОшибки = КодОшибки Тогда
			Возврат ЛокализоватьСообщениеПравила(Правило.Сообщение);
		КонецЕсли;
	КонецЦикла;

	ВызватьИсключение ФабрикаОшибок.Создать(
		КодыСтандартныхОшибок.НарушенВнутреннийИнвариант(),
		СтрШаблон(
			НСтр("ru = 'Для кода %1 не найдено сообщение встроенного правила'; "
				+ "en = 'No built-in rule message was found for code %1'"),
			КодОшибки
		),
		Новый Структура("Инвариант, КодОшибки", "Сообщение встроенного правила найдено", КодОшибки)
	);

КонецФункции

Функция ЛокализоватьСообщениеПравила(Сообщение)

	НормализованноеСообщение = СтрЗаменить(НРег(СокрЛП(Сообщение)), " ", "");
	Если СтрНайти(НормализованноеСообщение, "ru=") > 0
		И СтрНайти(НормализованноеСообщение, "en=") > 0 Тогда
		Возврат НСтр(Сообщение);
	КонецЕсли;

	Возврат Сообщение;

КонецФункции

Функция СобратьВстроенныеКандидаты(Кадры)

	Кандидаты = Новый Массив;
	ИндексВстроенныхПравил = ПолучитьИндексВстроенныхПравил();

	Для Каждого Кадр Из Кадры Цикл
		Если ЭтоЧужойСтруктурированныйКод(Кадр) Тогда
			Продолжить;
		КонецЕсли;

		ПервыйИндексКандидата = Кандидаты.Количество();
		ИндексВстроенныхПравил.СобратьКандидаты(Кадр, Кандидаты);
		ОформитьКандидатыПравил(Кандидаты, ПервыйИндексКандидата, Кадр, 100);
	КонецЦикла;

	Возврат Кандидаты;

КонецФункции

Функция СобратьПользовательскиеКандидаты(Кадры)

	Кандидаты = Новый Массив;
	Для Каждого Кадр Из Кадры Цикл
		ПервыйИндексКандидата = Кандидаты.Количество();

		Для Каждого ИндексПравил Из _ИндексыПользовательскихПравил Цикл
			ИндексПравил.СобратьКандидаты(Кадр, Кандидаты);
		КонецЦикла;

		ОформитьКандидатыПравил(Кандидаты, ПервыйИндексКандидата, Кадр, 400);
	КонецЦикла;

	Возврат Кандидаты;

КонецФункции

Функция ЭтоЧужойСтруктурированныйКод(Кадр)

	Возврат Не ПустаяСтрока(Кадр.КодОшибки)
		И Не ЭтоПубличныйКод(Кадр.КодОшибки);

КонецФункции

Процедура ОформитьКандидатыПравил(Кандидаты, ПервыйИндексКандидата, Кадр, СилаТекста)

	Для ИндексКандидата = ПервыйИндексКандидата По Кандидаты.ВГраница() Цикл
		Результат = Кандидаты[ИндексКандидата];
		Код = Результат.Код;
		Данные = Результат.Данные;
		Источник = ЗначениеСвойства(Данные, "Источник", "ВстроенныйКлассификатор");
		Правило = ЗначениеСвойства(Данные, "Правило", Код);
		Сила = СилаТекста;
		ИспользованныйНативныйТип = ЗначениеСвойства(Данные, "НативныйТип", Неопределено);

		Если Не ПустаяСтрока(ИспользованныйНативныйТип) И Кадр.Восстановлен Тогда
			Сила = СилаТекста + 90;
		ИначеЕсли Не ПустаяСтрока(ИспользованныйНативныйТип) Тогда
			Сила = СилаТекста + 100;
		КонецЕсли;

		Кандидаты[ИндексКандидата] = НовыйКандидат(
			Код,
			Кадр,
			Сила,
			Правило,
			Источник,
			Результат.Сообщение
		);
	КонецЦикла;

КонецПроцедуры

Функция НовыйКандидат(
	Код,
	Кадр,
	Сила,
	Правило,
	Источник,
	Сообщение)

	Поля = Новый Структура(
		"Код, Кадр, Сила, Правило, Источник, Сообщение",
		Код,
		Кадр,
		Сила,
		Правило,
		Источник,
		Сообщение
	);

	Возврат Новый ФиксированнаяСтруктура(Поля);

КонецФункции

Функция ВыбратьКандидата(Кандидаты)

	Если Кандидаты.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	МаксимальнаяСила = 0;
	Для Каждого Кандидат Из Кандидаты Цикл
		Если Кандидат.Сила > МаксимальнаяСила Тогда
			МаксимальнаяСила = Кандидат.Сила;
		КонецЕсли;
	КонецЦикла;

	ЛучшиеПоКодам = Новый Соответствие;
	Для Каждого Кандидат Из Кандидаты Цикл
		Если Кандидат.Сила = МаксимальнаяСила Тогда
			ЛучшиеПоКодам.Вставить(Кандидат.Код, Кандидат);
		КонецЕсли;
	КонецЦикла;

	Оставшиеся = Новый Массив;
	Для Каждого Пара Из ЛучшиеПоКодам Цикл
		Если Не ЕстьБолееСпецифичныйКод(Пара.Ключ, ЛучшиеПоКодам) Тогда
			Оставшиеся.Добавить(Пара.Значение);
		КонецЕсли;
	КонецЦикла;

	Если Оставшиеся.Количество() = 1 Тогда
		Возврат Оставшиеся[0];
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция ЕстьБолееСпецифичныйКод(Код, КандидатыПоКодам)

	Если Код = КодыНативныхОшибок.ПроксиНеУстановилТуннель() Тогда
		Возврат КандидатыПоКодам.Получить(
			КодыНативныхОшибок.ПроксиТребуетАутентификации()
		) <> Неопределено;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

Функция СоздатьНормализованнуюОшибку(Ошибка, Кандидат, Сообщение = Неопределено)

	Данные = Новый Структура;
	Данные.Вставить("Источник", Кандидат.Источник);
	Данные.Вставить("Правило", Кандидат.Правило);

	НативныйТип = ЗначениеСвойства(
		Кандидат.Кадр.Данные,
		"НативныйТип",
		Кандидат.Кадр.НативныйТип
	);

	Если Не ПустаяСтрока(НативныйТип) Тогда
		Данные.Вставить("НативныйТип", НативныйТип);
	КонецЕсли;

	Если Сообщение = Неопределено Тогда
		Сообщение = Кандидат.Сообщение;
	КонецЕсли;

	Возврат ФабрикаОшибок.Обернуть(
		Ошибка,
		Кандидат.Код,
		Сообщение,
		Данные
	);

КонецФункции

Функция ЗначениеСвойства(Данные, Имя, ЗначениеПоУмолчанию)

	Если ТипЗнч(Данные) <> Тип("Структура")
		И ТипЗнч(Данные) <> Тип("ФиксированнаяСтруктура") Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

	Значение = Неопределено;
	Если Данные.Свойство(Имя, Значение) Тогда
		Возврат Значение;
	КонецЕсли;

	Возврат ЗначениеПоУмолчанию;

КонецФункции

#КонецОбласти
