#Использовать errors

Перем Распознаватель; // РаспознавательЦепочкиОшибок

#Область ПрограммныйИнтерфейс

// Классифицирует исключение нативных объектов HTTP OneScript.
//
// Параметры:
//  Ошибка - ИнформацияОбОшибке - Исходная нативная ошибка.
//
// Возвращаемое значение:
//  ИнформацияОбОшибке, Неопределено - Нормализованная ошибка или Неопределено, если ошибка не распознана.
Функция Классифицировать(Ошибка, Распознаватель) Экспорт

	Если ЭтоНеподдерживаемоеПользовательскоеTLS(Ошибка, Распознаватель) Тогда
		КодОшибки = КодыНативныхОшибок.HTTPПользовательскоеTLSНеПоддерживается();
		Возврат ОшибкаHTTP(
			Ошибка,
			КодОшибки,
			НСтр("ru = 'Пользовательские TLS-сертификаты не поддерживаются';"
				+ "en = 'Custom TLS certificates are not supported'"),
			Неопределено
		);
	КонецЕсли;

	Если ЭтоТаймаут(Ошибка, Распознаватель) Тогда
		КодОшибки = КодыНативныхОшибок.HTTPТаймаутЗапроса();
		Возврат ОшибкаHTTP(
			Ошибка,
			КодОшибки,
			НСтр("ru = 'Истекло время ожидания HTTP-операции'; en = 'HTTP operation timed out'"),
			"System.Net.WebException"
		);
	КонецЕсли;

	Если ЭтоОшибкаРазрешенияИмени(Ошибка, Распознаватель) Тогда
		КодОшибки = КодыНативныхОшибок.СетьИмяУзлаНеРазрешено();
		Возврат ОшибкаHTTP(
			Ошибка,
			КодОшибки,
			НСтр("ru = 'Не удалось разрешить имя сетевого узла'; en = 'Network host name resolution failed'"),
			"System.Net.Sockets.SocketException"
		);
	КонецЕсли;

	Если ЭтоОтказСоединения(Ошибка, Распознаватель) Тогда
		КодОшибки = КодыНативныхОшибок.СетьСоединениеОтклонено();
		Возврат ОшибкаHTTP(
			Ошибка,
			КодОшибки,
			НСтр("ru = 'Сетевое соединение отклонено'; en = 'Network connection was refused'"),
			"System.Net.Sockets.SocketException"
		);
	КонецЕсли;

	Если ЭтоСбросСоединения(Ошибка, Распознаватель) Тогда
		КодОшибки = КодыНативныхОшибок.СетьСоединениеСброшено();
		Возврат ОшибкаHTTP(
			Ошибка,
			КодОшибки,
			НСтр("ru = 'Сетевое соединение сброшено удаленным узлом';"
				+ "en = 'Network connection was reset by the remote host'"),
			"System.Net.Sockets.SocketException"
		);
	КонецЕсли;

	Если ЭтоТребованиеАутентификацииПрокси(Ошибка, Распознаватель) Тогда
		КодОшибки = КодыНативныхОшибок.ПроксиТребуетсяАутентификация();
		Возврат ОшибкаHTTP(
			Ошибка,
			КодОшибки,
			НСтр("ru = 'HTTPS-прокси требует аутентификацию';"
				+ "en = 'HTTPS proxy authentication is required'"),
			"System.Net.WebException"
		);
	КонецЕсли;

	Если ЭтоОшибкаТуннеляПрокси(Ошибка, Распознаватель) Тогда
		КодОшибки = КодыНативныхОшибок.ПроксиТуннельНеУстановлен();
		Возврат ОшибкаHTTP(
			Ошибка,
			КодОшибки,
			НСтр("ru = 'HTTPS-прокси не смог создать туннель';"
				+ "en = 'HTTPS proxy failed to establish a tunnel'"),
			"System.Net.WebException"
		);
	КонецЕсли;

	Если ЭтоОшибкаTLSHandshake(Ошибка, Распознаватель) Тогда
		КодОшибки = КодыНативныхОшибок.СетьОшибкаTLSHandshake();
		Возврат ОшибкаHTTP(
			Ошибка,
			КодОшибки,
			НСтр("ru = 'Не удалось установить защищенное TLS-соединение';"
				+ "en = 'Failed to establish a secure TLS connection'"),
			"System.Net.WebException"
		);
	КонецЕсли;

	Если ЭтоНекорректныйОтвет(Ошибка, Распознаватель) Тогда
		КодОшибки = КодыНативныхОшибок.HTTPНекорректныйОтвет();
		Возврат ОшибкаHTTP(
			Ошибка,
			КодОшибки,
			НСтр("ru = 'Получен некорректный HTTP-ответ'; en = 'Invalid HTTP response received'"),
			"System.Net.WebException"
		);
	КонецЕсли;

	Если ЭтоНеполныйОтвет(Ошибка, Распознаватель) Тогда
		КодОшибки = КодыНативныхОшибок.HTTPНеполныйОтвет();
		Возврат ОшибкаHTTP(
			Ошибка,
			КодОшибки,
			НСтр("ru = 'Тело HTTP-ответа получено не полностью'; en = 'HTTP response body was incomplete'"),
			"System.Net.Http.HttpIOException"
		);
	КонецЕсли;

	Если ЭтоНекорректныйМетод(Ошибка, Распознаватель) Тогда
		КодОшибки = КодыНативныхОшибок.HTTPНекорректныйМетод();
		Возврат ОшибкаHTTP(
			Ошибка,
			КодОшибки,
			НСтр("ru = 'Некорректный HTTP-метод'; en = 'Invalid HTTP method'"),
			"System.ArgumentException"
		);
	КонецЕсли;

	ИмяЗаголовка = НайтиНекорректныйЗаголовок(Ошибка, Распознаватель);
	Если ИмяЗаголовка <> Неопределено Тогда
		Возврат ОшибкаЗаголовка(Ошибка, ИмяЗаголовка);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЭтоНеподдерживаемоеПользовательскоеTLS(Ошибка, Распознаватель)
	Шаблон =
		"Защищенное соединение по произвольным сертификатам не поддерживается."
			+ " Если необходим доступ по https, просто укажите протокол https в адресе хоста.";
	Возврат Распознаватель.СодержитТочноеСообщение(Шаблон);
КонецФункции

Функция ЭтоТаймаут(Ошибка, Распознаватель)
	Шаблон = "ru = 'Время ожидания операции истекло.'; en = 'The operation has timed out.'";
	Возврат Распознаватель.СодержитТипИОкончаниеСообщения("System.Net.WebException", Шаблон);
КонецФункции

Функция ЭтоОшибкаРазрешенияИмени(Ошибка, Распознаватель)
	Шаблон = "ru = 'Этот хост неизвестен.'; en = 'No such host is known.'";
	Возврат Распознаватель.СодержитТипИОкончаниеСообщения("System.Net.Sockets.SocketException", Шаблон);
КонецФункции

Функция ЭтоОтказСоединения(Ошибка, Распознаватель)

	ШаблонНачала =
		"ru = 'Подключение не установлено, т.к. конечный компьютер отверг запрос на подключение.';"
			+ "en = 'No connection could be made because the target machine actively refused it.'";

	Возврат Распознаватель.СодержитТипИОбрамлениеСообщения(
		"System.Net.Sockets.SocketException",
		ШаблонНачала,
		"ru = ''; en = ''"
	);

КонецФункции

Функция ЭтоСбросСоединения(Ошибка, Распознаватель)

	Шаблон = "ru = 'Удаленный хост принудительно разорвал существующее подключение.';"
		+ "en = 'An existing connection was forcibly closed by the remote host.'";

	Возврат Распознаватель.СодержитТипИОкончаниеСообщения("System.Net.Sockets.SocketException", Шаблон);

КонецФункции

Функция ЭтоТребованиеАутентификацииПрокси(Ошибка, Распознаватель)
	Шаблон = "failed with status code '407'";
	Возврат Распознаватель.СодержитТипИФрагментСообщения(
		"System.Net.WebException",
		Шаблон
	);
КонецФункции

Функция ЭтоОшибкаТуннеляПрокси(Ошибка, Распознаватель)
	Шаблон = "The proxy tunnel request to proxy";
	Возврат Распознаватель.СодержитТипИФрагментСообщения(
		"System.Net.WebException",
		Шаблон
	);
КонецФункции

Функция ЭтоОшибкаTLSHandshake(Ошибка, Распознаватель)

	Шаблон = "The SSL connection could not be established, see inner exception.";

	Возврат Распознаватель.СодержитТипИОкончаниеСообщения("System.Net.WebException", Шаблон);

КонецФункции

Функция ЭтоНекорректныйОтвет(Ошибка, Распознаватель)

	ШаблонНачала = "Received an invalid status line:";

	Если Распознаватель.СодержитТипИОбрамлениеСообщения(
		"System.Net.WebException",
		ШаблонНачала,
		""
	) Тогда
		Возврат Истина;
	КонецЕсли;

	ШаблонНачала = "Received an invalid status code:";
	Если Распознаватель.СодержитТипИОбрамлениеСообщения(
		"System.Net.WebException",
		ШаблонНачала,
		""
	) Тогда
		Возврат Истина;
	КонецЕсли;

	ШаблонНачала = "Received an invalid header name:";
	Если Распознаватель.СодержитТипИОбрамлениеСообщения(
		"System.Net.WebException",
		ШаблонНачала,
		""
	) Тогда
		Возврат Истина;
	КонецЕсли;

	ШаблонНачала = "Received an invalid header line:";
	Если Распознаватель.СодержитТипИОбрамлениеСообщения(
		"System.Net.WebException",
		ШаблонНачала,
		""
	) Тогда
		Возврат Истина;
	КонецЕсли;

	ШаблонНачала = "Received chunk header length could not be parsed:";

	Если Распознаватель.СодержитТипИОбрамлениеСообщения(
		"System.Net.Http.HttpIOException",
		ШаблонНачала,
		"(InvalidResponse)"
	) Тогда
		Возврат Истина;
	КонецЕсли;

	ШаблонНачала = "Received an invalid chunk terminator:";

	Возврат Распознаватель.СодержитТипИОбрамлениеСообщения(
		"System.Net.Http.HttpIOException",
		ШаблонНачала,
		"(InvalidResponse)"
	);

КонецФункции

Функция ЭтоНеполныйОтвет(Ошибка, Распознаватель)

	ШаблонНачала = "The response ended prematurely, with at least";
	ШаблонОкончания = "(ResponseEnded)";

	Если Распознаватель.СодержитТипИОбрамлениеСообщения(
		"System.Net.Http.HttpIOException",
		ШаблонНачала,
		ШаблонОкончания
	) Тогда
		Возврат Истина;
	КонецЕсли;

	Шаблон = "The response ended prematurely. (ResponseEnded)";

	Возврат Распознаватель.СодержитТипИОкончаниеСообщения(
		"System.Net.Http.HttpIOException",
		Шаблон
	);

КонецФункции

Функция ЭтоНекорректныйМетод(Ошибка, Распознаватель)

	Шаблон = "Cannot set null or blank methods on request. (Parameter 'value')";

	Возврат Распознаватель.СодержитТипИОкончаниеСообщения("System.ArgumentException", Шаблон);

КонецФункции

Функция НайтиНекорректныйЗаголовок(Ошибка, Распознаватель)

	Имена = Новый Массив;
	Имена.Добавить("Content-Length");
	Имена.Добавить("Date");
	Имена.Добавить("If-Modified-Since");
	Имена.Добавить("Range");

	Для Каждого Имя Из Имена Цикл
		Шаблон = СтрШаблон("ru = 'Заголовок %1 задан неправильно'; en = 'Header %1 is invalid'", Имя);
		Если Распознаватель.СодержитТочноеСообщение(Шаблон) Тогда
			Возврат Имя;
		КонецЕсли;
	КонецЦикла;

	Шаблон = "Chunked encoding must be set via the SendChunked property. (Parameter 'value')";
	Если ЭтоОшибкаОграниченногоЗаголовка(Ошибка, Шаблон, Распознаватель) Тогда
		Возврат "Transfer-Encoding";
	КонецЕсли;

	Шаблон = "Keep-Alive and Close may not be set using this property. (Parameter 'value')";
	Если ЭтоОшибкаОграниченногоЗаголовка(Ошибка, Шаблон, Распознаватель) Тогда
		Возврат "Connection";
	КонецЕсли;

	Шаблон = "The specified value is not a valid Host header string. (Parameter 'value')";
	Если ЭтоОшибкаОграниченногоЗаголовка(Ошибка, Шаблон, Распознаватель) Тогда
		Возврат "Host";
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция ЭтоОшибкаОграниченногоЗаголовка(Ошибка, Шаблон, Распознаватель)
	Возврат Распознаватель.СодержитТипИОкончаниеСообщения(
		"System.ArgumentException",
		Шаблон
	);
КонецФункции

Функция ОшибкаЗаголовка(Ошибка, ИмяЗаголовка)

	КодОшибки = КодыНативныхОшибок.HTTPНекорректныйЗаголовок();
	Данные = Новый Структура(
		"Источник, Правило, Заголовок",
		"HTTPСоединение",
		КодОшибки,
		ИмяЗаголовка
	);

	Возврат ФабрикаОшибок.Обернуть(
		Ошибка,
		КодОшибки,
		НСтр("ru = 'Некорректный HTTP-заголовок'; en = 'Invalid HTTP header'"),
		Данные
	);

КонецФункции

Функция ОшибкаHTTP(Ошибка, КодОшибки, Сообщение, НативныйТип)
	Данные = Новый Структура("Источник, Правило", "HTTPСоединение", КодОшибки);
	Если НативныйТип <> Неопределено Тогда
		Данные.Вставить("НативныйТип", НативныйТип);
	КонецЕсли;
	Возврат ФабрикаОшибок.Обернуть(Ошибка, КодОшибки, Сообщение, Данные);
КонецФункции

#КонецОбласти
