#Использовать errors

#Область ПрограммныйИнтерфейс

// Классифицирует исключение нативных объектов чтения и записи текста.
//
// Параметры:
//  Ошибка - ИнформацияОбОшибке - Исходная нативная ошибка.
//  Распознаватель - РаспознавательЦепочкиОшибок - Распознаватель цепочки ошибки.
//
// Возвращаемое значение:
//  ИнформацияОбОшибке, Неопределено - Нормализованная ошибка или Неопределено, если ошибка не распознана.
Функция Классифицировать(Ошибка, Распознаватель) Экспорт

	ШаблонНеОткрыт = "ru = 'Файл не открыт'; en = 'File is not open'";
	Если Распознаватель.СодержитТочноеСообщение(ШаблонНеОткрыт) Тогда
		Возврат ОшибкаТекстНеОткрыт(Ошибка);
	КонецЕсли;
	ШаблонПрефикса =
		"ru = 'Неправильное имя кодировки';"
			+ "en = 'Invalid encoding name'";
	ЭтоОшибкаOneScript = Распознаватель.СодержитПрефиксСообщения(ШаблонПрефикса);
	ШаблонОкончания =
		"' is not a supported encoding name. For information on defining a custom encoding,"
			+ " see the documentation for the Encoding.RegisterProvider method. (Parameter 'name')";
	ЭтоОшибкаDotNet = Распознаватель.СодержитТипИОкончаниеСообщения(
		"System.ArgumentException",
		ШаблонОкончания
	);
	Если Не ЭтоОшибкаOneScript И Не ЭтоОшибкаDotNet Тогда
		Возврат Неопределено;
	КонецЕсли;

	КодОшибки = КодыНативныхОшибок.ТекстНеизвестнаяКодировка();
	Данные = Новый Структура;
	Данные.Вставить("Источник", "ЧтениеТекста");
	Данные.Вставить("Правило", КодОшибки);

	Возврат ФабрикаОшибок.Обернуть(
		Ошибка,
		КодОшибки,
		НСтр(
			"ru = 'Неизвестная кодировка текста';"
				+ "en = 'Unknown text encoding'"
		),
		Данные
	);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОшибкаТекстНеОткрыт(Ошибка)
	КодОшибки = КодыНативныхОшибок.ТекстНеОткрыт();
	Данные = Новый Структура("Источник, Правило", "Текст", КодОшибки);
	Возврат ФабрикаОшибок.Обернуть(
		Ошибка,
		КодОшибки,
		НСтр("ru = 'Текстовый объект не открыт'; en = 'Text object is not open'"),
		Данные
	);
КонецФункции

#КонецОбласти
