#Использовать errors

Перем _Правила; // Массив из Структура

#Область ОбработчикиСобытий

// Создает классификатор ошибок преобразования типов, объектов, коллекций, таблиц и даты.
//
// Классифицируемые коды ошибок:
//  type.conversion_not_supported
//  collection.index_out_of_range
//  collection.key_not_found
//  collection.indexed_value_read_only
//  collection.invalid_constructor_argument
//  table.invalid_column_name
//  table.column_already_exists
//  table.column_role_conflict
//  table.invalid_offset
//  object.property_not_found
//  object.property_not_writable
//  object.method_not_found
//  type.constructor_not_found
//  type.object_required
//  call.too_many_arguments
//  call.too_few_arguments
//  background_tasks.failed
//  date.invalid_components
Процедура ПриСозданииОбъекта()

	_Правила = СоздатьПравилаКлассификации();

КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Классифицирует ошибки объектов, коллекций и универсальных операций платформы.
//
// Параметры:
//  Ошибка - ИнформацияОбОшибке - Исходная нативная ошибка.
//  Распознаватель - РаспознавательЦепочкиОшибок - Распознаватель цепочки ошибки.
//
// Возвращаемое значение:
//  ИнформацияОбОшибке, Неопределено - Нормализованная ошибка или Неопределено, если ошибка не распознана.
Функция Классифицировать(Ошибка, Распознаватель) Экспорт

	Для Каждого Правило Из _Правила Цикл
		Если Не Распознано(Распознаватель, Правило) Тогда
			Продолжить;
		КонецЕсли;

		Возврат СоздатьНормализованнуюОшибку(Ошибка, Правило);
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьПравилаКлассификации()

	Правила = Новый Массив;
	ДобавитьПравило(
		Правила,
		"ПрефиксОкончание",
		"(null) Преобразование к типу '",
		" не поддерживается",
		КодыНативныхОшибок.ПреобразованиеТипаНеПоддерживается(),
		"ПреобразованиеТипов",
		"Неподдерживаемое преобразование типа"
	);
	ДобавитьПравило(
		Правила,
		"ПрефиксОкончание",
		"OneScript.StandardLibrary.Collections.StructureImpl: Структура Преобразование к типу '",
		" не поддерживается",
		КодыНативныхОшибок.ПреобразованиеТипаНеПоддерживается(),
		"ПреобразованиеТипов",
		"Неподдерживаемое преобразование типа"
	);
	ДобавитьПравило(
		Правила,
		"Префикс",
		"Метод объекта не обнаружен (",
		"",
		КодыНативныхОшибок.МетодОбъектаНеНайден(),
		"Объекты",
		"Метод объекта не найден");
	ДобавитьПравило(
		Правила,
		"Точное",
		"Значение не является значением объектного типа",
		"",
		КодыНативныхОшибок.ТребуетсяЗначениеОбъектногоТипа(),
		"Типы",
		"Требуется значение объектного типа");
	ДобавитьПравило(
		Правила,
		"Точное",
		"Слишком много фактических параметров",
		"",
		КодыНативныхОшибок.ВызовСлишкомМногоАргументов(),
		"Вызовы",
		"Передано слишком много аргументов вызова");
	ДобавитьПравило(
		Правила,
		"Точное",
		"Недостаточно фактических параметров",
		"",
		КодыНативныхОшибок.ВызовНедостаточноАргументов(),
		"Вызовы",
		"Передано недостаточно аргументов вызова");
	ДобавитьПравило(
		Правила,
		"Точное",
		"ru = 'Задания завершились с ошибками'; en = 'Tasks are completed with errors'",
		"",
		КодыНативныхОшибок.ФоновыеЗадачиЗавершилисьСОшибками(),
		"МенеджерФоновыхЗаданий",
		"ru = 'Фоновые задачи завершились с ошибками'; en = 'Background tasks failed'");
	ДобавитьПравило(
		Правила,
		"Префикс",
		"Тип не определен. Конструктор не найден (",
		"",
		КодыНативныхОшибок.КонструкторТипаНеНайден(),
		"Типы",
		"Конструктор типа не найден");
	ДобавитьПравило(
		Правила,
		"ТипИОкончание",
		"System.ArgumentOutOfRangeException",
		"Year, Month, and Day parameters describe an un-representable DateTime.",
		КодыНативныхОшибок.ДатаНекорректныеКомпоненты(),
		"Дата",
		"Date components describe an un-representable DateTime");
	ДобавитьПравило(
		Правила,
		"Точное",
		"ru = 'Значение индекса выходит за пределы диапазона'; "
			+ "en = 'Index is out of range'",
		"",
		КодыНативныхОшибок.КоллекцияИндексВнеДиапазона(),
		"Коллекции",
		"ru = 'Индекс коллекции вне диапазона'; en = 'Collection index is out of range'");
	ДобавитьПравило(
		Правила,
		"Точное",
		"Значение, соответствующее ключу, не задано",
		"",
		КодыНативныхОшибок.КоллекцияКлючНеНайден(),
		"Коллекции",
		"Значение по ключу коллекции не найдено");
	ДобавитьПравило(
		Правила,
		"Точное",
		"Индексированное значение доступно только для чтения",
		"",
		КодыНативныхОшибок.КоллекцияИндексированноеЗначениеТолькоДляЧтения(),
		"Коллекции",
		"Индексированное значение коллекции доступно только для чтения");
	ДобавитьПравило(
		Правила,
		"ПрефиксОкончание",
		"В качестве параметра для конструктора можно передавать только ",
		" или Ключи и Значения",
		КодыНативныхОшибок.КоллекцияНекорректныйАргументКонструктора(),
		"Коллекции",
		"Некорректный аргумент конструктора коллекции");
	ДобавитьПравило(
		Правила,
		"Точное",
		"Неправильное смещение внутри коллекции",
		"",
		КодыНативныхОшибок.ТаблицаНекорректноеСмещение(),
		"ТаблицаЗначений",
		"Некорректное смещение таблицы");
	ДобавитьПравило(
		Правила,
		"Префикс",
		"ru = 'Неверное имя колонки'; en = 'Wrong column name'",
		"",
		КодыНативныхОшибок.ТаблицаНекорректноеИмяКолонки(),
		"ТаблицаЗначений",
		"ru = 'Некорректное имя колонки таблицы'; en = 'Invalid table column name'");
	ДобавитьПравило(
		Правила,
		"ПрефиксОкончание",
		"ru = 'Колонка '; en = 'Column '",
		"ru = ' уже есть'; en = ' already exists'",
		КодыНативныхОшибок.ТаблицаКолонкаУжеСуществует(),
		"ТаблицаЗначений",
		"ru = 'Колонка таблицы уже существует'; en = 'Table column already exists'");
	ДобавитьПравило(
		Правила,
		"ПрефиксОкончание",
		"ru = 'Колонка '; en = 'Column '",
		"ru = ' колонкой суммирования'; en = ' summation column'",
		КодыНативныхОшибок.ТаблицаКонфликтРолиКолонки(),
		"ТаблицаЗначений",
		"ru = 'Конфликт роли колонки таблицы'; en = 'Table column role conflict'");
	ДобавитьПравило(
		Правила,
		"Префикс",
		"ru = 'Свойство объекта не обнаружено ('; en = 'Object property is not found ('",
		"",
		КодыНативныхОшибок.СвойствоОбъектаНеНайдено(),
		"СвойстваОбъектов",
		"ru = 'Свойство объекта не найдено'; en = 'Object property is not found'");
	ДобавитьПравило(
		Правила,
		"ПрефиксОкончание",
		"ru = 'Свойство '; en = 'Property '",
		"ru = ' недоступно для записи'; en = ' is not writable'",
		КодыНативныхОшибок.СвойствоОбъектаНедоступноДляЗаписи(),
		"СвойстваОбъектов",
		"ru = 'Свойство объекта недоступно для записи'; "
			+ "en = 'Object property is not writable'");
	Возврат Правила;

КонецФункции

Процедура ДобавитьПравило(
	Правила,
	Способ,
	Начало,
	Окончание,
	КодОшибки,
	Источник,
	Описание)

	Правило = Новый Структура(
		"Способ, Начало, Окончание, КодОшибки, Источник, Описание",
		Способ,
		Начало,
		Окончание,
		КодОшибки,
		Источник,
		Описание);
	Правила.Добавить(Правило);

КонецПроцедуры

Функция СоздатьНормализованнуюОшибку(Ошибка, Правило)

	Данные = Новый Структура(
		"Источник, Правило",
		Правило.Источник,
		Правило.КодОшибки);
	Описание = Правило.Описание;
	Если ЭтоЛокализованныйШаблон(Описание) Тогда
		Описание = НСтр(Описание);
	КонецЕсли;
	Возврат ФабрикаОшибок.Обернуть(
		Ошибка,
		Правило.КодОшибки,
		Описание,
		Данные);

КонецФункции

Функция ЭтоЛокализованныйШаблон(Шаблон)

	НормализованныйШаблон = НРег(СокрЛП(Шаблон));
	Возврат СтрНайти(НормализованныйШаблон, "ru =") > 0
		И СтрНайти(НормализованныйШаблон, "en =") > 0;

КонецФункции

Функция Распознано(Распознаватель, Правило)

	Если Правило.Способ = "Точное" Тогда
		Возврат Распознаватель.СодержитТочноеСообщение(Правило.Начало);
	ИначеЕсли Правило.Способ = "Префикс" Тогда
		Возврат Распознаватель.СодержитПрефиксСообщения(
			Правило.Начало);
	ИначеЕсли Правило.Способ = "ПрефиксОкончание" Тогда
		Возврат Распознаватель.СодержитПрефиксИОкончаниеСообщения(
			Правило.Начало,
			Правило.Окончание);
	ИначеЕсли Правило.Способ = "ТипИОкончание" Тогда
		Возврат Распознаватель.СодержитТипИОкончаниеСообщения(
			Правило.Начало,
			Правило.Окончание);
	КонецЕсли;

	Возврат Ложь;

КонецФункции

#КонецОбласти
