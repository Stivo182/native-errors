Перем _КадрыОшибки; // Массив из ИнформацияОбОшибке
Перем _Описания; // Массив из Строка
Перем _ТочныеОписания; // Соответствие из Строка в Булево
Перем _ОписанияПоНативномуТипу; // Соответствие из Строка в Массив из Строка

#Область ОбработчикиСобытий

// Инициализирует распознаватель цепочки ошибок.
//
// Параметры:
//  Ошибка - ИнформацияОбОшибке - Исходная ошибка для последующих проверок.
Процедура ПриСозданииОбъекта(Ошибка)

	_КадрыОшибки = СобратьКадры(Ошибка);
	_Описания = Новый Массив;
	_ТочныеОписания = Новый Соответствие;
	_ОписанияПоНативномуТипу = Новый Соответствие;

	ИндексироватьКадрыОшибки();

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Проверяет наличие типа .NET-исключения в цепочке причин.
//
// Параметры:
//  НативныйТип - Строка - Полное имя типа .NET-исключения.
//
// Возвращаемое значение:
//  Булево - Истина, если тип найден в цепочке.
Функция СодержитТип(НативныйТип) Экспорт

	Возврат _ОписанияПоНативномуТипу.Получить(НативныйТип) <> Неопределено;

КонецФункции

// Возвращает первый найденный тип .NET-исключения из переданного списка.
//
// Параметры:
//  НативныеТипы - Массив из Строка - Полные имена типов .NET-исключений.
//
// Возвращаемое значение:
//  Строка, Неопределено - Найденное имя типа или Неопределено.
Функция НайтиТип(НативныеТипы) Экспорт

	Для Каждого НативныйТип Из НативныеТипы Цикл
		Если _ОписанияПоНативномуТипу.Получить(НативныйТип) <> Неопределено Тогда
			Возврат НативныйТип;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Проверяет наличие точного сообщения в цепочке причин.
//
// Параметры:
//  ШаблонСообщения - Строка - Обычная строка или шаблон НСтр с вариантами ru и en.
//
// Возвращаемое значение:
//  Булево - Истина, если сообщение найдено в цепочке.
Функция СодержитТочноеСообщение(ШаблонСообщения) Экспорт

	Возврат ТочноеСообщениеСоответствуетШаблону(ШаблонСообщения);

КонецФункции

// Проверяет префикс сообщения в цепочке причин.
//
// Параметры:
//  ШаблонПрефикса - Строка - Обычная строка или шаблон НСтр с вариантами ru и en.
//
// Возвращаемое значение:
//  Булево - Истина, если префикс найден в цепочке.
Функция СодержитПрефиксСообщения(ШаблонПрефикса) Экспорт

	Для Каждого Описание Из _Описания Цикл
		Если СтрокаНачинаетсяСШаблоном(Описание, ШаблонПрефикса) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Проверяет тип .NET-исключения и окончание сообщения в одном кадре цепочки.
//
// Параметры:
//  НативныйТип - Строка - Полное имя типа .NET-исключения.
//  ШаблонОкончания - Строка - Обычная строка или шаблон НСтр с вариантами ru и en.
//
// Возвращаемое значение:
//  Булево - Истина, если тип и окончание найдены в одном кадре.
Функция СодержитТипИОкончаниеСообщения(НативныйТип, ШаблонОкончания) Экспорт

	ОписанияТипа = _ОписанияПоНативномуТипу.Получить(НативныйТип);
	Если ОписанияТипа = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Описание Из ОписанияТипа Цикл
		Если СтрокаЗаканчиваетсяНаШаблон(Описание, ШаблонОкончания) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Проверяет тип .NET-исключения и фрагмент сообщения в одном кадре цепочки.
//
// Параметры:
//  НативныйТип - Строка - Полное имя типа .NET-исключения.
//  ШаблонФрагмента - Строка - Обычная строка или шаблон НСтр с вариантами ru и en.
//
// Возвращаемое значение:
//  Булево - Истина, если тип и фрагмент найдены в одном кадре.
Функция СодержитТипИФрагментСообщения(НативныйТип, ШаблонФрагмента) Экспорт

	ОписанияТипа = _ОписанияПоНативномуТипу.Получить(НативныйТип);
	Если ОписанияТипа = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Описание Из ОписанияТипа Цикл
		Если СтрокаСодержитШаблон(Описание, ШаблонФрагмента) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Проверяет тип и локализованные начало и окончание переменной части сообщения.
//
// Параметры:
//  НативныйТип - Строка - Полное имя типа .NET-исключения.
//  ШаблонНачала - Строка - Обычная строка или шаблон НСтр начала сообщения.
//  ШаблонОкончания - Строка - Обычная строка или шаблон НСтр окончания сообщения.
//
// Возвращаемое значение:
//  Булево - Истина, если тип и обрамление найдены в одном кадре.
Функция СодержитТипИОбрамлениеСообщения(
	НативныйТип,
	ШаблонНачала,
	ШаблонОкончания
) Экспорт

	ОписанияТипа = _ОписанияПоНативномуТипу.Получить(НативныйТип);
	Если ОписанияТипа = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Описание Из ОписанияТипа Цикл
		Если СтрокаСодержитСогласованноеОбрамление(
			Описание,
			ШаблонНачала,
			ШаблонОкончания
		) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Проверяет локализованные префикс и окончание сообщения с переменной средней частью.
//
// Параметры:
//  ШаблонНачала - Строка - Обычная строка или шаблон НСтр начала сообщения.
//  ШаблонОкончания - Строка - Обычная строка или шаблон НСтр окончания сообщения.
//
// Возвращаемое значение:
//  Булево - Истина, если начало и окончание найдены в одном кадре.
Функция СодержитПрефиксИОкончаниеСообщения(ШаблонНачала, ШаблонОкончания) Экспорт

	Для Каждого Описание Из _Описания Цикл
		Если СтрокаНачинаетсяИЗаканчиваетсяВариантами(
			Описание,
			ШаблонНачала,
			ШаблонОкончания
		) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ИндексироватьКадрыОшибки()

	Для Каждого КадрОшибки Из _КадрыОшибки Цикл
		Описание = КадрОшибки.Описание;
		ИндексироватьОписание(Описание);

		ПодробныеОписания = ИзвлечьОписанияИзПодробногоПредставления(Описание);
		Для Каждого ПодробноеОписание Из ПодробныеОписания Цикл
			ИндексироватьОписание(ПодробноеОписание);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура ИндексироватьОписание(Описание)

	_Описания.Добавить(Описание);
	_ТочныеОписания.Вставить(Описание, Истина);

	НативныйТип = ИзвлечьНативныйТип(Описание);
	Если НативныйТип <> Неопределено Тогда
		ДобавитьОписаниеНативногоТипа(НативныйТип, Описание);
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьОписаниеНативногоТипа(НативныйТип, Описание)

	Описания = _ОписанияПоНативномуТипу.Получить(НативныйТип);
	Если Описания = Неопределено Тогда
		Описания = Новый Массив;
		_ОписанияПоНативномуТипу.Вставить(НативныйТип, Описания);
	КонецЕсли;

	Описания.Добавить(Описание);

КонецПроцедуры

Функция ИзвлечьНативныйТип(Описание)

	ПрефиксРусскогоИсключения = "Внешнее исключение (";
	ПрефиксАнглийскогоИсключения = "External exception (";

	Если СтрНачинаетсяС(Описание, ПрефиксРусскогоИсключения) Тогда
		Префикс = ПрефиксРусскогоИсключения;
	ИначеЕсли СтрНачинаетсяС(Описание, ПрефиксАнглийскогоИсключения) Тогда
		Префикс = ПрефиксАнглийскогоИсключения;
	Иначе
		Возврат Неопределено;
	КонецЕсли;

	ПозицияОкончанияТипа = СтрНайти(Описание, "):");
	Если ПозицияОкончанияТипа = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	ДлинаТипа = ПозицияОкончанияТипа - СтрДлина(Префикс) - 1;
	Если ДлинаТипа <= 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Сред(Описание, СтрДлина(Префикс) + 1, ДлинаТипа);

КонецФункции

// Возвращает сообщения из текста,
// сформированного ПодробноеПредставлениеОшибки().
Функция ИзвлечьОписанияИзПодробногоПредставления(Описание)

	Результат = Новый Массив;

	Если ИзвлечьНативныйТип(Описание) <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Если Не ЭтоПодробноеПредставлениеОшибки(Описание) Тогда
		Возврат Результат;
	КонецЕсли;

	ОжидаетсяОписаниеПричины = Ложь;

	Для Каждого Строка Из СтрРазделить(Описание, Символы.ПС, Ложь) Цикл
		Если ЭтоМаркерПричиныПодробногоПредставления(Строка) Тогда
			ОжидаетсяОписаниеПричины = Истина;
			Продолжить;
		КонецЕсли;

		ПозицияРусскогоМаркера = СтрНайти(Строка, "Внешнее исключение (");
		ПозицияАнглийскогоМаркера = СтрНайти(Строка, "External exception (");
		ПозицияМаркера = ПозицияРусскогоМаркера;

		Если ПозицияАнглийскогоМаркера > ПозицияМаркера Тогда
			ПозицияМаркера = ПозицияАнглийскогоМаркера;
		КонецЕсли;

		Если ПозицияМаркера > 0 Тогда
			Кандидат = Сред(Строка, ПозицияМаркера);
		ИначеЕсли ОжидаетсяОписаниеПричины И Не ПустаяСтрока(Строка) Тогда
			Кандидат = Строка;
		Иначе
			Кандидат = ИзвлечьСообщениеИзСтрокиПодробногоПредставления(Строка);
		КонецЕсли;

		Если Кандидат <> Неопределено Тогда
			Результат.Добавить(ОбрезатьЗакрывающиеСкобки(Кандидат));
			ОжидаетсяОписаниеПричины = Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ЭтоМаркерПричиныПодробногоПредставления(Строка)

	НормализованнаяСтрока = НРег(СокрЛП(Строка));
	Возврат НормализованнаяСтрока = "по причине:"
		Или НормализованнаяСтрока = "caused by:";

КонецФункции

Функция ЭтоПодробноеПредставлениеОшибки(Описание)

	Возврат СтрНачинаетсяС(Описание, "{Модуль ")
		Или СтрНачинаетсяС(Описание, "{Module ");

КонецФункции

Функция ИзвлечьСообщениеИзСтрокиПодробногоПредставления(Строка)

	ПредпоследнийРазделитель = СтрНайти(Строка, " / ", НаправлениеПоиска.СКонца,, 2);
	Если ПредпоследнийРазделитель = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	ПоследнийРазделитель = СтрНайти(Строка, " / ", НаправлениеПоиска.СКонца);
	Возврат Сред(Строка, ПоследнийРазделитель + СтрДлина(" / "));

КонецФункции

Функция ОбрезатьЗакрывающиеСкобки(Описание)

	Результат = СокрЛП(Описание);
	Пока СтрЗаканчиваетсяНа(Результат, "}") Цикл
		Результат = СокрП(Лев(Результат, СтрДлина(Результат) - 1));
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция СобратьКадры(Ошибка)

	Кадры = Новый Массив;
	ТекущаяОшибка = Ошибка;

	Пока ЭтоКадрОшибки(ТекущаяОшибка) Цикл
		Кадры.Добавить(ТекущаяОшибка);
		ТекущаяОшибка = ТекущаяОшибка.Причина;
	КонецЦикла;

	Возврат Кадры;

КонецФункции

Функция ЭтоКадрОшибки(Значение)
	Возврат ТипЗнч(Значение) = Тип("ИнформацияОбОшибке");
КонецФункции

Функция ТочноеСообщениеСоответствуетШаблону(Шаблон)

	ПервыйВариант = ПервыйВариантШаблона(Шаблон);
	Если _ТочныеОписания.Получить(ПервыйВариант) = Истина Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат ЭтоЛокализованныйШаблон(Шаблон)
		И _ТочныеОписания.Получить(НСтр(Шаблон, "en")) = Истина;

КонецФункции

Функция СтрокаНачинаетсяСШаблоном(Строка, Шаблон)

	Если СтрНачинаетсяС(Строка, ПервыйВариантШаблона(Шаблон)) Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат ЭтоЛокализованныйШаблон(Шаблон)
		И СтрНачинаетсяС(Строка, НСтр(Шаблон, "en"));

КонецФункции

Функция СтрокаЗаканчиваетсяНаШаблон(Строка, Шаблон)

	Если СтрЗаканчиваетсяНа(Строка, ПервыйВариантШаблона(Шаблон)) Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат ЭтоЛокализованныйШаблон(Шаблон)
		И СтрЗаканчиваетсяНа(Строка, НСтр(Шаблон, "en"));

КонецФункции

Функция СтрокаСодержитШаблон(Строка, Шаблон)

	Если СтрНайти(Строка, ПервыйВариантШаблона(Шаблон)) > 0 Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат ЭтоЛокализованныйШаблон(Шаблон)
		И СтрНайти(Строка, НСтр(Шаблон, "en")) > 0;

КонецФункции

Функция СтрокаСодержитСогласованноеОбрамление(Строка, ШаблонНачала, ШаблонОкончания)

	Если СтрокаСоответствуетОбрамлению(
		Строка,
		ПервыйВариантШаблона(ШаблонНачала),
		ПервыйВариантШаблона(ШаблонОкончания)
	) Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат ЭтоЛокализованныйШаблон(ШаблонНачала)
		И ЭтоЛокализованныйШаблон(ШаблонОкончания)
		И СтрокаСоответствуетОбрамлению(Строка, НСтр(ШаблонНачала, "en"), НСтр(ШаблонОкончания, "en"));

КонецФункции

Функция СтрокаНачинаетсяИЗаканчиваетсяВариантами(Строка, ШаблонНачала, ШаблонОкончания)

	Если СтрокаНачинаетсяИЗаканчивается(
		Строка,
		ПервыйВариантШаблона(ШаблонНачала),
		ПервыйВариантШаблона(ШаблонОкончания)
	) Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат ЭтоЛокализованныйШаблон(ШаблонНачала)
		И ЭтоЛокализованныйШаблон(ШаблонОкончания)
		И СтрокаНачинаетсяИЗаканчивается(
			Строка,
			НСтр(ШаблонНачала, "en"),
			НСтр(ШаблонОкончания, "en")
		);

КонецФункции

Функция СтрокаСоответствуетОбрамлению(Строка, Начало, Окончание)

	Возврат СтрНайти(Строка, Начало) > 0
		И (ПустаяСтрока(Окончание) Или СтрЗаканчиваетсяНа(Строка, Окончание));

КонецФункции

Функция СтрокаНачинаетсяИЗаканчивается(Строка, Начало, Окончание)

	Возврат СтрНачинаетсяС(Строка, Начало)
		И (ПустаяСтрока(Окончание) Или СтрЗаканчиваетсяНа(Строка, Окончание));

КонецФункции

Функция ПервыйВариантШаблона(Шаблон)

	Если ЭтоЛокализованныйШаблон(Шаблон) Тогда
		Возврат НСтр(Шаблон, "ru");
	КонецЕсли;

	Возврат Шаблон;

КонецФункции

Функция ЭтоЛокализованныйШаблон(Шаблон)
	Возврат СтрНачинаетсяС(СокрЛП(Шаблон), "ru =");
КонецФункции

