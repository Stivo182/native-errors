#Использовать errors

#Область ПрограммныйИнтерфейс

// Классифицирует исключение нативных объектов двоичных данных и буферов.
//
// Параметры:
//  Ошибка - ИнформацияОбОшибке - Исходная нативная ошибка.
//  Распознаватель - РаспознавательЦепочкиОшибок - Распознаватель цепочки ошибки.
//
// Возвращаемое значение:
//  ИнформацияОбОшибке, Неопределено - Нормализованная ошибка или Неопределено, если ошибка не распознана.
Функция Классифицировать(Ошибка, Распознаватель) Экспорт

	Если ЭтоНекорректныйHex(Распознаватель, Ошибка) Тогда
		Возврат ОшибкаНекорректногоHex(Ошибка);
	КонецЕсли;

	ШаблонТолькоЧтение =
		"ru = 'Буфер находится в режиме ""Только чтение""';"
			+ "en = 'Buffer is read-only'";
	Если Распознаватель.СодержитТочноеСообщение(ШаблонТолькоЧтение) Тогда
		Возврат ОшибкаБуфераТолькоДляЧтения(Ошибка);
	КонецЕсли;

	Если ЭтоВыходЗаГраницыБуфера(Распознаватель, Ошибка) Тогда
		Возврат ОшибкаГраницБуфера(Ошибка);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЭтоНекорректныйHex(Распознаватель, Ошибка)
	ШаблонСообщения =
		"ru = 'Неверный формат шестнадцатеричной строки';"
			+ "en = 'Invalid hexadecimal string format'";
	Возврат Распознаватель.СодержитТипИОкончаниеСообщения(
		"System.FormatException",
		ШаблонСообщения
	);
КонецФункции

Функция ЭтоВыходЗаГраницыБуфера(Распознаватель, Ошибка)
	ШаблонПереполнения =
		"ru = 'Переполнение при работе с буфером';"
			+ "en = 'Buffer overflow'";
	Если Распознаватель.СодержитТипИОкончаниеСообщения(
		"System.IndexOutOfRangeException",
		ШаблонПереполнения
	) Тогда
		Возврат Истина;
	КонецЕсли;

	ШаблонЧтения =
		"ru = 'Исходный массив недостаточно длинный.';"
			+ "en = 'Source array was not long enough. Check the source index, length, "
			+ "and the array''s lower bounds. (Parameter ''sourceArray'')'";
	ШаблонЗаписи =
		"ru = 'Конечный массив недостаточно длинный.';"
			+ "en = 'Destination array was not long enough. Check the destination index, length, "
			+ "and the array''s lower bounds. (Parameter ''destinationArray'')'";
	Возврат Распознаватель.СодержитТипИОкончаниеСообщения(
		"System.ArgumentException",
		ШаблонЧтения
	) Или Распознаватель.СодержитТипИОкончаниеСообщения(
		"System.ArgumentException",
		ШаблонЗаписи
	);
КонецФункции

Функция ОшибкаГраницБуфера(Ошибка)
	КодОшибки = КодыНативныхОшибок.ДвоичныеДанныеВыходЗаГраницыБуфера();
	Данные = Новый Структура;
	Данные.Вставить("Источник", "БуферДвоичныхДанных");
	Данные.Вставить("Правило", КодОшибки);

	Возврат ФабрикаОшибок.Обернуть(
		Ошибка,
		КодОшибки,
		НСтр(
			"ru = 'Операция выходит за границы двоичного буфера';"
				+ "en = 'Operation exceeds binary buffer bounds'"
		),
		Данные
	);

КонецФункции

Функция ОшибкаНекорректногоHex(Ошибка)
	КодОшибки = КодыНативныхОшибок.ДвоичныеДанныеНекорректныйHex();
	Данные = Новый Структура;
	Данные.Вставить("Источник", "ПреобразованиеHex");
	Данные.Вставить("НативныйТип", "System.FormatException");
	Данные.Вставить("Правило", КодОшибки);

	Возврат ФабрикаОшибок.Обернуть(
		Ошибка,
		КодОшибки,
		НСтр(
			"ru = 'Некорректные шестнадцатеричные данные';"
				+ "en = 'Invalid hexadecimal data'"
		),
		Данные
	);

КонецФункции

Функция ОшибкаБуфераТолькоДляЧтения(Ошибка)
	КодОшибки = КодыНативныхОшибок.ДвоичныеДанныеТолькоДляЧтения();
	Данные = Новый Структура;
	Данные.Вставить("Источник", "БуферДвоичныхДанных");
	Данные.Вставить("Правило", КодОшибки);

	Возврат ФабрикаОшибок.Обернуть(
		Ошибка,
		КодОшибки,
		НСтр("ru = 'Двоичный буфер доступен только для чтения'; en = 'Binary buffer is read-only'"),
		Данные
	);

КонецФункции

#КонецОбласти
