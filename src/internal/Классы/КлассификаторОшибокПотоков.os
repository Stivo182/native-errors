#Использовать errors

#Область ПрограммныйИнтерфейс

// Классифицирует исключение нативных потоков OneScript.
//
// Параметры:
//  Ошибка - ИнформацияОбОшибке - Исходная нативная ошибка.
//  Распознаватель - РаспознавательЦепочкиОшибок - Распознаватель цепочки ошибки.
//
// Возвращаемое значение:
//  ИнформацияОбОшибке, Неопределено - Нормализованная ошибка или Неопределено, если ошибка не распознана.
Функция Классифицировать(Ошибка, Распознаватель) Экспорт

	ШаблонПотокаБезЗаписи =
		"ru = 'Попытка записи в поток не поддерживающий запись';"
			+ "en = 'Cannot write to a stream that does not support writing'";
	Если Распознаватель.СодержитТочноеСообщение(ШаблонПотокаБезЗаписи) Тогда
		Возврат ОшибкаПотокаБезЗаписи(Ошибка);
	КонецЕсли;

	ШаблонЗакрытогоПотокаOneScript =
		"ru = 'Ошибка обращения к закрытому потоку';"
			+ "en = 'Cannot access a closed stream'";
	Если Распознаватель.СодержитТочноеСообщение(ШаблонЗакрытогоПотокаOneScript) Тогда
		Возврат ОшибкаЗакрытогоПотока(Ошибка);
	КонецЕсли;

	ШаблонЗакрытогоПотока =
		"ru = 'Доступ к закрытому потоку невозможен.';"
			+ "en = 'Cannot access a closed Stream.'";
	Если Распознаватель.СодержитТипИОкончаниеСообщения(
		"System.ObjectDisposedException",
		ШаблонЗакрытогоПотока
	) Тогда
		Возврат ОшибкаЗакрытогоПотока(Ошибка);
	КонецЕсли;

	ШаблонДиапазонаБуфера =
		"ru = 'Смещение и длина находились вне границ массива.';"
			+ "en = 'Offset and length were out of bounds for the array or count is greater than the number "
			+ "of elements from index to the end of the source collection. (Parameter ''count'')'";
	Если Распознаватель.СодержитТипИОкончаниеСообщения(
		"System.ArgumentOutOfRangeException",
		ШаблонДиапазонаБуфера
	) Тогда
		Возврат ОшибкаДиапазонаБуфера(Ошибка);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОшибкаЗакрытогоПотока(Ошибка)
	КодОшибки = КодыНативныхОшибок.ПотокЗакрыт();
	Данные = Новый Структура;
	Данные.Вставить("Источник", "Поток");
	Данные.Вставить("НативныйТип", "System.ObjectDisposedException");
	Данные.Вставить("Правило", КодОшибки);

	Возврат ФабрикаОшибок.Обернуть(
		Ошибка,
		КодОшибки,
		НСтр(
			"ru = 'Поток закрыт';"
				+ "en = 'Stream is closed'"
		),
		Данные
	);

КонецФункции

Функция ОшибкаДиапазонаБуфера(Ошибка)
	КодОшибки = КодыНативныхОшибок.ПотокВыходЗаГраницыБуфера();
	Данные = Новый Структура;
	Данные.Вставить("Источник", "Поток");
	Данные.Вставить("НативныйТип", "System.ArgumentOutOfRangeException");
	Данные.Вставить("Правило", КодОшибки);

	Возврат ФабрикаОшибок.Обернуть(
		Ошибка,
		КодОшибки,
		НСтр(
			"ru = 'Диапазон буфера выходит за допустимые границы';"
				+ "en = 'Buffer range is outside the allowed bounds'"
		),
		Данные
	);

КонецФункции

Функция ОшибкаПотокаБезЗаписи(Ошибка)
	КодОшибки = КодыНативныхОшибок.ПотокНеПоддерживаетЗапись();
	Данные = Новый Структура("Источник, Правило", "Поток", КодОшибки);
	Возврат ФабрикаОшибок.Обернуть(
		Ошибка,
		КодОшибки,
		НСтр("ru = 'Поток не поддерживает запись'; en = 'Stream does not support writing'"),
		Данные
	);
КонецФункции

#КонецОбласти
