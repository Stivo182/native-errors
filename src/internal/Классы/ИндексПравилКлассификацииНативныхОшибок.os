#Использовать errors

Перем _ПравилаПоТипу; // ФиксированноеСоответствие из КлючИЗначение:
                      //  * Ключ - Строка - Полное имя нативного типа исключения.
                      //  * Значение - ФиксированныйМассив из ФиксированнаяСтруктура - Правила этого типа.
Перем _ПравилаПоСообщению; // ФиксированноеСоответствие из КлючИЗначение:
                           //  * Ключ - Строка - Точное сообщение ошибки.
                           //  * Значение - ФиксированныйМассив из ФиксированнаяСтруктура - Правила сообщения.
Перем _ПравилаПрефиксов; // ФиксированныйМассив из ФиксированнаяСтруктура
Перем _Источник; // Строка - Источник набора правил.

#Область ОбработчикиСобытий

// Создает неизменяемый индекс правил классификации.
// Локализованные шаблоны разбираются один раз при создании индекса.
//
// Параметры:
//  Правила - Массив из ПравилоКлассификацииНативныхОшибок - Правила классификации.
//  Источник - Строка - Источник набора правил.
//  НачальныйНомерПравила - Число - Номер первого правила для автоматического идентификатора.
//
// Исключения:
//  Если передан неизвестный способ сопоставления.
Процедура ПриСозданииОбъекта(Правила, Источник, НачальныйНомерПравила = 1)

	_Источник = Источник;
	ПоТипу = Новый Соответствие;
	ПоСообщению = Новый Соответствие;
	Префиксы = Новый Массив;

	НомерПравила = НачальныйНомерПравила;
	Для Каждого Правило Из Правила Цикл
		ПроверитьПравило(Правило);
		ПодготовленноеПравило = ПодготовитьПравило(Правило, НомерПравила);

		Если Правило.Способ = СпособыСопоставленияНативныхОшибок.Точное() Тогда
			Если ПодготовленноеПравило.ЕстьРусскийВариант Тогда
				ДобавитьВИндекс(ПоСообщению, ПодготовленноеПравило.ШаблонСообщения, ПодготовленноеПравило);
			КонецЕсли;
			Если ПодготовленноеПравило.ЕстьАнглийскийВариант
				И (Не ПодготовленноеПравило.ЕстьРусскийВариант
					Или ПодготовленноеПравило.ШаблонСообщенияEN <> ПодготовленноеПравило.ШаблонСообщения) Тогда
				ДобавитьВИндекс(ПоСообщению, ПодготовленноеПравило.ШаблонСообщенияEN, ПодготовленноеПравило);
			КонецЕсли;
		ИначеЕсли Правило.Способ = СпособыСопоставленияНативныхОшибок.Префикс()
			Или Правило.Способ = СпособыСопоставленияНативныхОшибок.ПрефиксОкончание()
			Или Правило.Способ = СпособыСопоставленияНативныхОшибок.ПрефиксИФрагмент() Тогда
			Префиксы.Добавить(ПодготовленноеПравило);
		ИначеЕсли Правило.Способ = СпособыСопоставленияНативныхОшибок.ПоТипу()
			Или Правило.Способ = СпособыСопоставленияНативныхОшибок.ТипИОкончание()
			Или Правило.Способ = СпособыСопоставленияНативныхОшибок.ТипИФрагмент()
			Или Правило.Способ = СпособыСопоставленияНативныхОшибок.ТипИОбрамление() Тогда
			ДобавитьВИндекс(ПоТипу, Правило.НативныйТип, ПодготовленноеПравило);
		Иначе
			ВызватьИсключение ФабрикаОшибок.Создать(
				КодыСтандартныхОшибок.НедопустимоеЗначениеАргумента(),
				СтрШаблон(
					НСтр("ru = 'Неизвестный способ сопоставления правила: %1'; "
						+ "en = 'Unknown rule matching method: %1'"),
					Правило.Способ
				),
				Новый Структура("Способ", Правило.Способ)
			);
		КонецЕсли;

		НомерПравила = НомерПравила + 1;
	КонецЦикла;

	_ПравилаПоТипу = ЗафиксироватьИндекс(ПоТипу);
	_ПравилаПоСообщению = ЗафиксироватьИндекс(ПоСообщению);
	_ПравилаПрефиксов = Новый ФиксированныйМассив(Префиксы);

КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Добавляет совпавшие коды одного кадра в массив кандидатов.
// Одинаковые коды объединяются с сохранением подтвержденного нативного типа.
// Индекс и данные кандидатов не изменяются между вызовами.
//
// Параметры:
//  Кадр - ФиксированнаяСтруктура - Кадр ошибки:
//    * Описание - Строка - Сообщение кадра.
//    * НативныйТип - Строка, Неопределено - Полное имя нативного типа исключения.
//    * РазрешенДляПоиска - Булево - Признак доступности кадра для сопоставления.
//  Кандидаты - Массив из ФиксированнаяСтруктура - Пополняемые кандидаты:
//    * Код - Строка - Код классифицированной ошибки.
//    * Сообщение - Строка - Нормализованное описание ошибки.
//    * Данные - ФиксированнаяСтруктура - Диагностические данные:
//      * Источник - Строка - Источник набора правил.
//      * Правило - Строка - Код совпавшего правила.
//      * НативныйТип - Строка - Проверенный правилом нативный тип, если использовался.
Процедура СобратьКандидаты(Кадр, Кандидаты) Экспорт

	Если Не Кадр.РазрешенДляПоиска Тогда
		Возврат;
	КонецЕсли;

	ДобавленныеКоды = Новый Соответствие;

	// Типовые правила проверяются первыми, чтобы текстовый дубль не ослабил кандидат.
	Если Не ПустаяСтрока(Кадр.НативныйТип) Тогда
		ПравилаТипа = _ПравилаПоТипу.Получить(Кадр.НативныйТип);
		Если ПравилаТипа <> Неопределено Тогда
			СобратьСовпадения(ПравилаТипа, Кадр.Описание, Кандидаты, ДобавленныеКоды);
		КонецЕсли;
	КонецЕсли;

	ТочныеПравила = _ПравилаПоСообщению.Получить(Кадр.Описание);
	Если ТочныеПравила <> Неопределено Тогда
		Для Каждого Правило Из ТочныеПравила Цикл
			ДобавитьКандидат(Правило.Кандидат, Кандидаты, ДобавленныеКоды);
		КонецЦикла;
	КонецЕсли;

	СобратьСовпадения(_ПравилаПрефиксов, Кадр.Описание, Кандидаты, ДобавленныеКоды);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьВИндекс(Индекс, Ключ, Правило)

	ПравилаКлюча = Индекс.Получить(Ключ);
	Если ПравилаКлюча = Неопределено Тогда
		ПравилаКлюча = Новый Массив;
		Индекс.Вставить(Ключ, ПравилаКлюча);
	КонецЕсли;

	ПравилаКлюча.Добавить(Правило);

КонецПроцедуры

Функция ЗафиксироватьИндекс(Индекс)

	Результат = Новый Соответствие;
	Для Каждого Пара Из Индекс Цикл
		Результат.Вставить(Пара.Ключ, Новый ФиксированныйМассив(Пара.Значение));
	КонецЦикла;

	Возврат Новый ФиксированноеСоответствие(Результат);

КонецФункции

Функция ПодготовитьПравило(Правило, НомерПравила)

	ШаблонСообщения = ЛокализоватьШаблон(Правило.ШаблонСообщения, "ru");
	Префикс = ЛокализоватьШаблон(Правило.Префикс, "ru");
	Фрагмент = ЛокализоватьШаблон(Правило.Фрагмент, "ru");
	Окончание = ЛокализоватьШаблон(Правило.Окончание, "ru");
	ШаблонСообщенияEN = ЛокализоватьШаблон(Правило.ШаблонСообщения, "en");
	ПрефиксEN = ЛокализоватьШаблон(Правило.Префикс, "en");
	ФрагментEN = ЛокализоватьШаблон(Правило.Фрагмент, "en");
	ОкончаниеEN = ЛокализоватьШаблон(Правило.Окончание, "en");
	ЕстьРусскийВариант = ДоступенВариант(Правило, "ru");
	ЕстьАнглийскийВариант = ДоступенВариант(Правило, "en");

	Возврат Новый ФиксированнаяСтруктура(
		Новый Структура(
			"Способ, ШаблонСообщения, Префикс, Фрагмент, Окончание, ШаблонСообщенияEN, ПрефиксEN, "
				+ "ФрагментEN, ОкончаниеEN, "
				+ "ЕстьРусскийВариант, ЕстьАнглийскийВариант, Кандидат",
			Правило.Способ,
			ШаблонСообщения,
			Префикс,
			Фрагмент,
			Окончание,
			ШаблонСообщенияEN,
			ПрефиксEN,
			ФрагментEN,
			ОкончаниеEN,
			ЕстьРусскийВариант,
			ЕстьАнглийскийВариант,
			ПодготовитьКандидат(Правило, НомерПравила)
		)
	);

КонецФункции

Функция ПодготовитьКандидат(Правило, НомерПравила)

	Данные = Новый Структура(
		"Источник, Правило",
		_Источник,
		ИдентификаторПравила(Правило, НомерПравила)
	);
	Если Не ПустаяСтрока(Правило.НативныйТип) Тогда
		Данные.Вставить("НативныйТип", Правило.НативныйТип);
	КонецЕсли;

	Сообщение = Правило.Сообщение;
	Если ЭтоЛокализованныйШаблон(Сообщение) Тогда
		Сообщение = НСтр(Сообщение);
	КонецЕсли;

	Возврат Новый ФиксированнаяСтруктура(
		Новый Структура("Код, Сообщение, Данные", Правило.КодОшибки, Сообщение, Новый ФиксированнаяСтруктура(Данные))
	);

КонецФункции

Функция ИдентификаторПравила(Правило, НомерПравила)

	Идентификатор = "";
	Попытка
		Идентификатор = Правило.Идентификатор;
	Исключение
		Идентификатор = "";
	КонецПопытки;

	Если Не ПустаяСтрока(Идентификатор) Тогда
		Возврат Идентификатор;
	КонецЕсли;

	Возврат СтрШаблон("%1.%2", _Источник, НомерПравила);

КонецФункции

Процедура ПроверитьПравило(Правило)

	Способ = Правило.Способ;
	Если Способ = СпособыСопоставленияНативныхОшибок.Точное() Тогда
		ПроверитьНепустоеПоле(Правило.ШаблонСообщения, "ШаблонСообщения");
	ИначеЕсли Способ = СпособыСопоставленияНативныхОшибок.Префикс()
		Или Способ = СпособыСопоставленияНативныхОшибок.ПрефиксОкончание() Тогда
		ПроверитьНепустоеПоле(Правило.Префикс, "Префикс");
	ИначеЕсли Способ = СпособыСопоставленияНативныхОшибок.ПрефиксИФрагмент() Тогда
		ПроверитьНепустоеПоле(Правило.Префикс, "Префикс");
		ПроверитьНепустоеПоле(Правило.Фрагмент, "Фрагмент");
	ИначеЕсли Способ = СпособыСопоставленияНативныхОшибок.ПоТипу() Тогда
		ПроверитьНепустоеПоле(Правило.НативныйТип, "НативныйТип");
	ИначеЕсли Способ = СпособыСопоставленияНативныхОшибок.ТипИОкончание() Тогда
		ПроверитьНепустоеПоле(Правило.НативныйТип, "НативныйТип");
		ПроверитьНепустоеПоле(Правило.Окончание, "Окончание");
	ИначеЕсли Способ = СпособыСопоставленияНативныхОшибок.ТипИФрагмент()
		Или Способ = СпособыСопоставленияНативныхОшибок.ТипИОбрамление() Тогда
		ПроверитьНепустоеПоле(Правило.НативныйТип, "НативныйТип");
		ПроверитьНепустоеПоле(Правило.Фрагмент, "Фрагмент");
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьНепустоеПоле(Значение, ИмяПоля)

	Если ПустаяСтрока(Значение) Тогда
		ВызватьИсключение ФабрикаОшибок.Создать(
			КодыСтандартныхОшибок.НедопустимоеЗначениеАргумента(),
			СтрШаблон(
				НСтр("ru = 'Не заполнено обязательное поле правила: %1'; "
					+ "en = 'Required rule field is not specified: %1'"),
				ИмяПоля
			),
			Новый Структура("ИмяПоля", ИмяПоля)
		);
	КонецЕсли;

КонецПроцедуры

Процедура СобратьСовпадения(Правила, Описание, Кандидаты, ДобавленныеКоды)

	Для Каждого Правило Из Правила Цикл
		Если Правило.ЕстьРусскийВариант
			И Соответствует(
			Описание,
			Правило.Способ,
			Правило.ШаблонСообщения,
			Правило.Префикс,
			Правило.Фрагмент,
			Правило.Окончание
		)
			Или Правило.ЕстьАнглийскийВариант
				И Соответствует(
					Описание,
					Правило.Способ,
					Правило.ШаблонСообщенияEN,
					Правило.ПрефиксEN,
					Правило.ФрагментEN,
					Правило.ОкончаниеEN
				) Тогда
			ДобавитьКандидат(Правило.Кандидат, Кандидаты, ДобавленныеКоды);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьКандидат(Кандидат, Кандидаты, ДобавленныеКоды)

	Если ДобавленныеКоды.Получить(Кандидат.Код) = Истина Тогда
		Возврат;
	КонецЕсли;

	Кандидаты.Добавить(Кандидат);
	ДобавленныеКоды.Вставить(Кандидат.Код, Истина);

КонецПроцедуры

Функция Соответствует(Описание, Способ, ШаблонСообщения, Префикс, Фрагмент, Окончание)

	Если Способ = СпособыСопоставленияНативныхОшибок.Точное() Тогда
		Возврат Описание = ШаблонСообщения;
	ИначеЕсли Способ = СпособыСопоставленияНативныхОшибок.ПоТипу() Тогда
		Возврат Истина;
	ИначеЕсли Способ = СпособыСопоставленияНативныхОшибок.ТипИОкончание() Тогда
		Возврат СтрЗаканчиваетсяНа(Описание, Окончание);
	ИначеЕсли Способ = СпособыСопоставленияНативныхОшибок.ТипИФрагмент() Тогда
		Возврат СтрНайти(Описание, Фрагмент) > 0;
	ИначеЕсли Способ = СпособыСопоставленияНативныхОшибок.ТипИОбрамление() Тогда
		Возврат СтрНайти(Описание, Фрагмент) > 0
			И (ПустаяСтрока(Окончание) Или СтрЗаканчиваетсяНа(Описание, Окончание));
	ИначеЕсли Способ = СпособыСопоставленияНативныхОшибок.Префикс() Тогда
		Возврат СтрНачинаетсяС(Описание, Префикс);
	ИначеЕсли Способ = СпособыСопоставленияНативныхОшибок.ПрефиксИФрагмент() Тогда
		Возврат СтрНачинаетсяС(Описание, Префикс)
			И СтрНайти(Описание, Фрагмент) > 0;
	КонецЕсли;

	Возврат СтрНачинаетсяС(Описание, Префикс)
		И (ПустаяСтрока(Окончание) Или СтрЗаканчиваетсяНа(Описание, Окончание));

КонецФункции

Функция ЛокализоватьШаблон(Шаблон, Язык)

	Если Не ЭтоЛокализованныйШаблон(Шаблон) Тогда
		Возврат Шаблон;
	КонецЕсли;

	Если Не СодержитЯзыковойВариант(Шаблон, Язык) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат НСтр(Шаблон, Язык);

КонецФункции

Функция ДоступенВариант(Правило, Язык)

	Если Правило.Способ = СпособыСопоставленияНативныхОшибок.Точное() Тогда
		Возврат ДоступенШаблон(Правило.ШаблонСообщения, Язык);
	ИначеЕсли Правило.Способ = СпособыСопоставленияНативныхОшибок.Префикс() Тогда
		Возврат ДоступенШаблон(Правило.Префикс, Язык);
	ИначеЕсли Правило.Способ = СпособыСопоставленияНативныхОшибок.ПрефиксОкончание() Тогда
		Возврат ДоступенШаблон(Правило.Префикс, Язык)
			И ДоступенШаблон(Правило.Окончание, Язык);
	ИначеЕсли Правило.Способ = СпособыСопоставленияНативныхОшибок.ПрефиксИФрагмент() Тогда
		Возврат ДоступенШаблон(Правило.Префикс, Язык)
			И ДоступенШаблон(Правило.Фрагмент, Язык);
	ИначеЕсли Правило.Способ = СпособыСопоставленияНативныхОшибок.ТипИОкончание() Тогда
		Возврат ДоступенШаблон(Правило.Окончание, Язык);
	ИначеЕсли Правило.Способ = СпособыСопоставленияНативныхОшибок.ТипИФрагмент() Тогда
		Возврат ДоступенШаблон(Правило.Фрагмент, Язык);
	ИначеЕсли Правило.Способ = СпособыСопоставленияНативныхОшибок.ТипИОбрамление() Тогда
		Возврат ДоступенШаблон(Правило.Фрагмент, Язык)
			И ДоступенШаблон(Правило.Окончание, Язык);
	КонецЕсли;

	Возврат Истина;

КонецФункции

Функция ДоступенШаблон(Шаблон, Язык)

	Возврат Не ЭтоЛокализованныйШаблон(Шаблон)
		Или СодержитЯзыковойВариант(Шаблон, Язык);

КонецФункции

Функция ЭтоЛокализованныйШаблон(Шаблон)

	Если СтрНайти(Шаблон, "=") = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат СодержитЯзыковойВариант(Шаблон, "ru")
		Или СодержитЯзыковойВариант(Шаблон, "en");

КонецФункции

Функция СодержитЯзыковойВариант(Шаблон, Язык)

	НормализованныйШаблон = СтрЗаменить(НРег(СокрЛП(Шаблон)), " ", "");
	Возврат СтрНайти(НормализованныйШаблон, Язык + "=") > 0;

КонецФункции

#КонецОбласти
