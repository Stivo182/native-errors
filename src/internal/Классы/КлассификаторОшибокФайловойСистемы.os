#Использовать errors

#Область ПрограммныйИнтерфейс

// Классифицирует исключение нативных объектов файловой системы OneScript.
//
// Параметры:
//  Ошибка - ИнформацияОбОшибке - Исходная нативная ошибка.
//  Распознаватель - РаспознавательЦепочкиОшибок - Распознаватель цепочки ошибки.
//
// Возвращаемое значение:
//  ИнформацияОбОшибке, Неопределено - Нормализованная ошибка или Неопределено, если ошибка не распознана.
Функция Классифицировать(Ошибка, Распознаватель) Экспорт

	Если Распознаватель.СодержитТип("System.UnauthorizedAccessException") Тогда
		Возврат ОшибкаОтказаВДоступе(Ошибка);
	КонецЕсли;

	Если ЭтоОшибкаСуществующегоФайла(Ошибка, Распознаватель) Тогда
		Возврат ОшибкаСуществующегоФайла(Ошибка);
	КонецЕсли;

	Если ЭтоОшибкаИспользуемогоФайла(Ошибка, Распознаватель) Тогда
		Возврат ОшибкаИспользуемогоФайла(Ошибка);
	КонецЕсли;

	НативныеТипы = Новый Массив;
	НативныеТипы.Добавить("System.IO.FileNotFoundException");
	НативныеТипы.Добавить("System.IO.DirectoryNotFoundException");

	НативныйТип = Распознаватель.НайтиТип(НативныеТипы);
	Если НативныйТип <> Неопределено Тогда
		Возврат ОшибкаОтсутствующегоРесурса(Ошибка, НативныйТип);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЭтоОшибкаСуществующегоФайла(Ошибка, Распознаватель)

	ШаблонНачала = "ru = 'Файл '''; en = 'The file '''";
	ШаблонОкончания = "ru = ''' уже существует.'; en = ''' already exists.'";

	Возврат Распознаватель.СодержитТипИОбрамлениеСообщения(
		"System.IO.IOException",
		ШаблонНачала,
		ШаблонОкончания
	);

КонецФункции

Функция ЭтоОшибкаИспользуемогоФайла(Ошибка, Распознаватель)

	ШаблонНачала =
		"ru = 'Процесс не может получить доступ к файлу ''';"
			+ "en = 'The process cannot access the file '''";
	ШаблонОкончания =
		"ru = ''', так как этот файл используется другим процессом.';"
			+ "en = ''' because it is being used by another process.'";

	Возврат Распознаватель.СодержитТипИОбрамлениеСообщения(
		"System.IO.IOException",
		ШаблонНачала,
		ШаблонОкончания
	);

КонецФункции

Функция ОшибкаОтсутствующегоРесурса(Ошибка, НативныйТип)

	КодОшибки = КодыНативныхОшибок.ФайловаяСистемаРесурсНеНайден();
	Данные = Новый Структура;
	Данные.Вставить("Источник", "ФайловаяСистема");
	Данные.Вставить("НативныйТип", НативныйТип);
	Данные.Вставить("Правило", КодОшибки);

	Возврат ФабрикаОшибок.Обернуть(
		Ошибка,
		КодОшибки,
		НСтр(
			"ru = 'Файл или каталог не найден';"
				+ "en = 'File or directory not found'"
		),
		Данные
	);

КонецФункции

Функция ОшибкаСуществующегоФайла(Ошибка)

	КодОшибки = КодыНативныхОшибок.ФайловаяСистемаРесурсУжеСуществует();
	Данные = ДанныеФайловойОшибки("System.IO.IOException", КодОшибки);

	Возврат ФабрикаОшибок.Обернуть(
		Ошибка,
		КодОшибки,
		НСтр("ru = 'Файл уже существует'; en = 'File already exists'"),
		Данные
	);

КонецФункции

Функция ОшибкаИспользуемогоФайла(Ошибка)

	КодОшибки = КодыНативныхОшибок.ФайловаяСистемаРесурсЗанят();
	Данные = ДанныеФайловойОшибки("System.IO.IOException", КодОшибки);

	Возврат ФабрикаОшибок.Обернуть(
		Ошибка,
		КодОшибки,
		НСтр("ru = 'Файл уже используется'; en = 'File is already in use'"),
		Данные
	);

КонецФункции

Функция ОшибкаОтказаВДоступе(Ошибка)

	КодОшибки = КодыНативныхОшибок.ФайловаяСистемаДоступЗапрещен();
	Данные = ДанныеФайловойОшибки("System.UnauthorizedAccessException", КодОшибки);

	Возврат ФабрикаОшибок.Обернуть(
		Ошибка,
		КодОшибки,
		НСтр("ru = 'Доступ к файлу или каталогу запрещён'; en = 'Access to file or directory is denied'"),
		Данные
	);

КонецФункции

Функция ДанныеФайловойОшибки(НативныйТип, Правило)

	Данные = Новый Структура;
	Данные.Вставить("Источник", "ФайловаяСистема");
	Данные.Вставить("НативныйТип", НативныйТип);
	Данные.Вставить("Правило", Правило);

	Возврат Данные;

КонецФункции

#КонецОбласти
