#Использовать errors

#Область ПрограммныйИнтерфейс

// Классифицирует исключение нативных объектов чтения и записи JSON.
//
// Параметры:
//  Ошибка - ИнформацияОбОшибке - Исходная нативная ошибка.
//  Распознаватель - РаспознавательЦепочкиОшибок - Распознаватель цепочки ошибки.
//
// Возвращаемое значение:
//  ИнформацияОбОшибке, Неопределено - Нормализованная ошибка или Неопределено, если ошибка не распознана.
Функция Классифицировать(Ошибка, Распознаватель) Экспорт

	ШаблонЧтениеНеОткрыто =
		"ru = 'Источник данных JSON не открыт'; en = 'JSON data source is not opened'";
	Если Распознаватель.СодержитТочноеСообщение(ШаблонЧтениеНеОткрыто) Тогда
		Возврат ОшибкаСостоянияJSON(Ошибка, КодыНативныхОшибок.JSONЧтениеНеОткрыто());
	КонецЕсли;
	ШаблонЗаписьНеОткрыта =
		"ru = 'Приемник данных JSON не открыт'; en = 'JSON data target is not opened'";
	Если Распознаватель.СодержитТочноеСообщение(ШаблонЗаписьНеОткрыта) Тогда
		Возврат ОшибкаСостоянияJSON(Ошибка, КодыНативныхОшибок.JSONЗаписьНеОткрыта());
	КонецЕсли;
	ШаблонЗначениеНедоступно =
		"ru = 'Текущее значение JSON не может быть получено'; en = 'Cannot get current JSON value'";
	Если Распознаватель.СодержитТочноеСообщение(ШаблонЗначениеНедоступно) Тогда
		Возврат ОшибкаСостоянияJSON(Ошибка, КодыНативныхОшибок.JSONТекущееЗначениеНедоступно());
	КонецЕсли;

	Если ЭтоНеподдерживаемыйТипЗначения(Распознаватель, Ошибка) Тогда
		Возврат ОшибкаНеподдерживаемогоТипа(Ошибка);
	КонецЕсли;

	ШаблонПрефикса =
		"ru = 'Недопустимое состояние потока чтения JSON в строке';"
			+ "en = 'Invalid JSON reader state at line'";
	Если Распознаватель.СодержитПрефиксСообщения(ШаблонПрефикса) Тогда
		Возврат ОшибкаНекорректногоJSON(Ошибка);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЭтоНеподдерживаемыйТипЗначения(Распознаватель, Ошибка)
	ШаблонНачала =
		"ru = 'Запись значения типа ';"
			+ "en = 'Cannot write value of type '";
	ШаблонОкончания = "ru = ' не поддерживается'; en = ''";
	Возврат Распознаватель.СодержитПрефиксИОкончаниеСообщения(
		ШаблонНачала,
		ШаблонОкончания
	);
КонецФункции

Функция ОшибкаНекорректногоJSON(Ошибка)
	КодОшибки = КодыНативныхОшибок.JSONНекорректныйСинтаксис();
	Данные = Новый Структура;
	Данные.Вставить("Источник", "ЧтениеJSON");
	Данные.Вставить("Правило", КодОшибки);

	Возврат ФабрикаОшибок.Обернуть(
		Ошибка,
		КодОшибки,
		НСтр(
			"ru = 'Некорректные данные JSON';"
				+ "en = 'Invalid JSON data'"
		),
		Данные
	);

КонецФункции

Функция ОшибкаСостоянияJSON(Ошибка, КодОшибки)
	Данные = Новый Структура("Источник, Правило", "JSON", КодОшибки);
	Возврат ФабрикаОшибок.Обернуть(
		Ошибка,
		КодОшибки,
		НСтр("ru = 'Недопустимое состояние объекта JSON'; en = 'Invalid JSON object state'"),
		Данные
	);
КонецФункции

Функция ОшибкаНеподдерживаемогоТипа(Ошибка)
	КодОшибки = КодыНативныхОшибок.JSONНеподдерживаемыйТипЗначения();
	Данные = Новый Структура("Источник, Правило", "ЗаписьJSON", КодОшибки);
	Возврат ФабрикаОшибок.Обернуть(
		Ошибка,
		КодОшибки,
		НСтр("ru = 'Тип значения не поддерживается ЗаписьюJSON'; en = 'Value type is not supported by JSONWriter'"),
		Данные
	);
КонецФункции

#КонецОбласти
