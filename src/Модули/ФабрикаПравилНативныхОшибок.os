#Область ПрограммныйИнтерфейс

// Создает правило точного сопоставления сообщения.
//
// Параметры:
//  ШаблонСообщения - Строка - Полное сообщение или шаблон НСтр.
//  КодОшибки - Строка - Машинный код результата.
//  Сообщение - Строка - Нормализованное сообщение или шаблон НСтр.
//
// Возвращаемое значение:
//  ПравилоКлассификацииНативныхОшибок - Созданное правило.
Функция Точное(ШаблонСообщения, КодОшибки, Сообщение) Экспорт

	Возврат СоздатьПравило(
		СпособыСопоставленияНативныхОшибок.Точное(),
		КодОшибки,
		Сообщение,
		"",
		ШаблонСообщения
	);

КонецФункции

// Создает правило сопоставления префикса сообщения.
//
// Параметры:
//  ШаблонПрефикса - Строка - Префикс сообщения или шаблон НСтр.
//  КодОшибки - Строка - Машинный код результата.
//  Сообщение - Строка - Нормализованное сообщение или шаблон НСтр.
//
// Возвращаемое значение:
//  ПравилоКлассификацииНативныхОшибок - Созданное правило.
Функция Префикс(ШаблонПрефикса, КодОшибки, Сообщение) Экспорт

	Возврат СоздатьПравило(
		СпособыСопоставленияНативныхОшибок.Префикс(),
		КодОшибки,
		Сообщение,
		"",
		"",
		ШаблонПрефикса
	);

КонецФункции

// Создает правило сопоставления префикса и окончания сообщения.
//
// Параметры:
//  ШаблонПрефикса - Строка - Префикс сообщения или шаблон НСтр.
//  ШаблонОкончания - Строка - Окончание сообщения или шаблон НСтр.
//  КодОшибки - Строка - Машинный код результата.
//  Сообщение - Строка - Нормализованное сообщение или шаблон НСтр.
//
// Возвращаемое значение:
//  ПравилоКлассификацииНативныхОшибок - Созданное правило.
Функция ПрефиксОкончание(
	ШаблонПрефикса,
	ШаблонОкончания,
	КодОшибки,
	Сообщение) Экспорт

	Возврат СоздатьПравило(
		СпособыСопоставленияНативныхОшибок.ПрефиксОкончание(),
		КодОшибки,
		Сообщение,
		"",
		"",
		ШаблонПрефикса,
		"",
		ШаблонОкончания
	);

КонецФункции

// Создает правило сопоставления префикса и фрагмента сообщения.
//
// Параметры:
//  ШаблонПрефикса - Строка - Префикс сообщения или шаблон НСтр.
//  ШаблонФрагмента - Строка - Обязательный фрагмент сообщения или шаблон НСтр.
//  КодОшибки - Строка - Машинный код результата.
//  Сообщение - Строка - Нормализованное сообщение или шаблон НСтр.
//
// Возвращаемое значение:
//  ПравилоКлассификацииНативныхОшибок - Созданное правило.
Функция ПрефиксИФрагмент(
	ШаблонПрефикса,
	ШаблонФрагмента,
	КодОшибки,
	Сообщение) Экспорт

	Возврат СоздатьПравило(
		СпособыСопоставленияНативныхОшибок.ПрефиксИФрагмент(),
		КодОшибки,
		Сообщение,
		"",
		"",
		ШаблонПрефикса,
		ШаблонФрагмента
	);

КонецФункции

// Создает правило сопоставления нативного типа.
//
// Параметры:
//  НативныйТип - Строка - Полное имя нативного типа.
//  КодОшибки - Строка - Машинный код результата.
//  Сообщение - Строка - Нормализованное сообщение или шаблон НСтр.
//
// Возвращаемое значение:
//  ПравилоКлассификацииНативныхОшибок - Созданное правило.
Функция ПоТипу(НативныйТип, КодОшибки, Сообщение) Экспорт

	Возврат СоздатьПравило(
		СпособыСопоставленияНативныхОшибок.ПоТипу(),
		КодОшибки,
		Сообщение,
		НативныйТип
	);

КонецФункции

// Создает правило сопоставления нативного типа и окончания сообщения.
//
// Параметры:
//  НативныйТип - Строка - Полное имя нативного типа.
//  ШаблонОкончания - Строка - Окончание сообщения или шаблон НСтр.
//  КодОшибки - Строка - Машинный код результата.
