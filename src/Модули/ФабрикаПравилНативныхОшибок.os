		Сообщение,
		НативныйТип,
		"",
		"",
		"",
		ШаблонОкончания
	);

КонецФункции

// Создает правило сопоставления нативного типа и фрагмента сообщения.
//
// Параметры:
//  НативныйТип - Строка - Полное имя нативного типа.
//  ШаблонФрагмента - Строка - Фрагмент сообщения или шаблон НСтр.
