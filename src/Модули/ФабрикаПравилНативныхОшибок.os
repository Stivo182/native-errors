КонецФункции

// Создает правило сопоставления нативного типа, фрагмента и окончания сообщения.
//
// Параметры:
//  НативныйТип - Строка - Полное имя нативного типа.
//  ШаблонФрагмента - Строка - Фрагмент сообщения или шаблон НСтр.
//  ШаблонОкончания - Строка - Окончание сообщения или шаблон НСтр.
//  КодОшибки - Строка - Машинный код результата.
//  Сообщение - Строка - Нормализованное сообщение или шаблон НСтр.
//
// Возвращаемое значение:
//  ПравилоКлассификацииНативныхОшибок - Созданное правило.
Функция ТипИОбрамление(
	НативныйТип,
	ШаблонФрагмента,
	ШаблонОкончания,
	КодОшибки,
	Сообщение) Экспорт

	Возврат СоздатьПравило(
		СпособыСопоставленияНативныхОшибок.ТипИОбрамление(),
		КодОшибки,
		Сообщение,
		НативныйТип,
		"",
		"",
		ШаблонФрагмента,
		ШаблонОкончания
	);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьПравило(
	Способ,
	КодОшибки,
	Сообщение,
	НативныйТип = "",
	ШаблонСообщения = "",
	Префикс = "",
	Фрагмент = "",
	Окончание = "")

	Возврат Новый ПравилоКлассификацииНативныхОшибок(
		Способ,
		КодОшибки,
		Сообщение,
		НативныйТип,
		ШаблонСообщения,
		Префикс,
		Фрагмент,
		Окончание
	);

КонецФункции

#КонецОбласти
