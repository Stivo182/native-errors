#Область ПрограммныйИнтерфейс

// Создаёт правило точного сопоставления сообщения.
//
// Параметры:
//  ШаблонСообщения - Строка - Полное сообщение или шаблон НСтр.
//  КодОшибки - Строка - Машинный код результата.
//  Сообщение - Строка - Нормализованное сообщение или шаблон НСтр.
//
// Возвращаемое значение:
//  ПравилоКлассификацииНативныхОшибок - Созданное правило.
Функция Точное(ШаблонСообщения, КодОшибки, Сообщение) Экспорт

	Возврат СоздатьПравило(
		СпособыСопоставленияНативныхОшибок.Точное(),
		"",
		ШаблонСообщения,
		"",
		КодОшибки,
		Сообщение
	);

КонецФункции

// Создаёт правило сопоставления префикса сообщения.
//
// Параметры:
//  ШаблонПрефикса - Строка - Префикс сообщения или шаблон НСтр.
//  КодОшибки - Строка - Машинный код результата.
//  Сообщение - Строка - Нормализованное сообщение или шаблон НСтр.
//
// Возвращаемое значение:
//  ПравилоКлассификацииНативныхОшибок - Созданное правило.
Функция Префикс(ШаблонПрефикса, КодОшибки, Сообщение) Экспорт

	Возврат СоздатьПравило(
		СпособыСопоставленияНативныхОшибок.Префикс(),
		"",
		ШаблонПрефикса,
		"",
		КодОшибки,
		Сообщение
	);

КонецФункции

// Создаёт правило сопоставления префикса и окончания сообщения.
//
// Параметры:
//  ШаблонПрефикса - Строка - Префикс сообщения или шаблон НСтр.
//  ШаблонОкончания - Строка - Окончание сообщения или шаблон НСтр.
//  КодОшибки - Строка - Машинный код результата.
//  Сообщение - Строка - Нормализованное сообщение или шаблон НСтр.
//
// Возвращаемое значение:
//  ПравилоКлассификацииНативныхОшибок - Созданное правило.
Функция ПрефиксОкончание(
	ШаблонПрефикса,
	ШаблонОкончания,
	КодОшибки,
	Сообщение) Экспорт

	Возврат СоздатьПравило(
		СпособыСопоставленияНативныхОшибок.ПрефиксОкончание(),
		"",
		ШаблонПрефикса,
		ШаблонОкончания,
		КодОшибки,
		Сообщение
	);

КонецФункции

// Создаёт правило сопоставления нативного типа.
//
// Параметры:
//  НативныйТип - Строка - Полное имя нативного типа.
//  КодОшибки - Строка - Машинный код результата.
//  Сообщение - Строка - Нормализованное сообщение или шаблон НСтр.
//
// Возвращаемое значение:
//  ПравилоКлассификацииНативныхОшибок - Созданное правило.
Функция ПоТипу(НативныйТип, КодОшибки, Сообщение) Экспорт

	Возврат СоздатьПравило(
		СпособыСопоставленияНативныхОшибок.ПоТипу(),
		НативныйТип,
		"",
		"",
		КодОшибки,
		Сообщение
	);

КонецФункции

// Создаёт правило сопоставления нативного типа и окончания сообщения.
//
// Параметры:
//  НативныйТип - Строка - Полное имя нативного типа.
//  ШаблонОкончания - Строка - Окончание сообщения или шаблон НСтр.
//  КодОшибки - Строка - Машинный код результата.
//  Сообщение - Строка - Нормализованное сообщение или шаблон НСтр.
//
// Возвращаемое значение:
//  ПравилоКлассификацииНативныхОшибок - Созданное правило.
Функция ТипИОкончание(НативныйТип, ШаблонОкончания, КодОшибки, Сообщение) Экспорт

	Возврат СоздатьПравило(
		СпособыСопоставленияНативныхОшибок.ТипИОкончание(),
		НативныйТип,
		"",
		ШаблонОкончания,
		КодОшибки,
		Сообщение
	);

КонецФункции

// Создаёт правило сопоставления нативного типа и фрагмента сообщения.
//
// Параметры:
//  НативныйТип - Строка - Полное имя нативного типа.
//  ШаблонФрагмента - Строка - Фрагмент сообщения или шаблон НСтр.
//  КодОшибки - Строка - Машинный код результата.
//  Сообщение - Строка - Нормализованное сообщение или шаблон НСтр.
//
// Возвращаемое значение:
//  ПравилоКлассификацииНативныхОшибок - Созданное правило.
Функция ТипИФрагмент(НативныйТип, ШаблонФрагмента, КодОшибки, Сообщение) Экспорт

	Возврат СоздатьПравило(
		СпособыСопоставленияНативныхОшибок.ТипИФрагмент(),
		НативныйТип,
		ШаблонФрагмента,
		"",
		КодОшибки,
		Сообщение
	);

КонецФункции

// Создаёт правило сопоставления нативного типа, фрагмента и окончания сообщения.
//
// Параметры:
//  НативныйТип - Строка - Полное имя нативного типа.
//  ШаблонФрагмента - Строка - Фрагмент сообщения или шаблон НСтр.
//  ШаблонОкончания - Строка - Окончание сообщения или шаблон НСтр.
//  КодОшибки - Строка - Машинный код результата.
//  Сообщение - Строка - Нормализованное сообщение или шаблон НСтр.
//
// Возвращаемое значение:
//  ПравилоКлассификацииНативныхОшибок - Созданное правило.
Функция ТипИОбрамление(
	НативныйТип,
	ШаблонФрагмента,
	ШаблонОкончания,
	КодОшибки,
	Сообщение) Экспорт

	Возврат СоздатьПравило(
		СпособыСопоставленияНативныхОшибок.ТипИОбрамление(),
		НативныйТип,
		ШаблонФрагмента,
		ШаблонОкончания,
		КодОшибки,
		Сообщение
	);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьПравило(
	Способ,
	НативныйТип,
	Начало,
	Окончание,
	КодОшибки,
	Сообщение)

	Возврат Новый ПравилоКлассификацииНативныхОшибок(
		Способ,
		НативныйТип,
		Начало,
		Окончание,
		КодОшибки,
		Сообщение
	);

КонецФункции

#КонецОбласти
