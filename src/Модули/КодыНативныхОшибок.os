Функция СетьОшибкаРазрешенияИмениУзла() Экспорт
	Возврат "network.name_resolution_failed";
КонецФункции

// Возвращает код ошибки отказа в установке сетевого соединения.
//
// Возвращаемое значение:
//  Строка - Стабильный машинный код ошибки.
Функция СетьСоединениеОтклонено() Экспорт
	Возврат "network.connection_refused";
КонецФункции

// Возвращает код ошибки принудительного сброса сетевого соединения удалённым узлом.
//
// Возвращаемое значение:
//  Строка - Стабильный машинный код ошибки.
Функция СетьСоединениеСброшено() Экспорт
	Возврат "network.connection_reset";
КонецФункции

// Возвращает код ошибки установки защищённого TLS-соединения.
//
// Возвращаемое значение:
//  Строка - Стабильный машинный код ошибки.
Функция СетьОшибкаСогласованияTLS() Экспорт
	Возврат "network.tls_handshake_failed";
КонецФункции

#КонецОбласти

#Область Перечень

// Возвращает все поддерживаемые коды ошибок.
//
// Возвращаемое значение:
//  ФиксированныйМассив - Стабильные машинные коды ошибок.
Функция Все() Экспорт

	Коды = Новый Массив;
	Коды.Добавить(ФайловаяСистемаРесурсНеНайден());
	Коды.Добавить(ФайловаяСистемаРесурсУжеСуществует());
	Коды.Добавить(ФайловаяСистемаРесурсЗанят());
