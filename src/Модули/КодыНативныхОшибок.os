	Коды.Добавить(ТекстовыйОбъектНеОткрыт());
	Коды.Добавить(ПотокЗакрыт());
	Коды.Добавить(ПотокНеПоддерживаетЗапись());
	Коды.Добавить(ПотокВыходЗаГраницыБуфера());
