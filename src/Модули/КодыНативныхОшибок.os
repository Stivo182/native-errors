#Область ФайловаяСистема

// Ошибки отсутствующего файла или каталога.
//
// Возвращаемое значение:
//  Строка - Стабильный машинный код ошибки.
Функция ФайловаяСистемаРесурсНеНайден() Экспорт
	Возврат "filesystem.not_found";
КонецФункции

// Ошибки уже существующего файла.
//
// Возвращаемое значение:
//  Строка - Стабильный машинный код ошибки.
Функция ФайловаяСистемаРесурсУжеСуществует() Экспорт
	Возврат "filesystem.already_exists";
КонецФункции

// Ошибки занятого файла.
//
// Возвращаемое значение:
//  Строка - Стабильный машинный код ошибки.
Функция ФайловаяСистемаРесурсЗанят() Экспорт
	Возврат "filesystem.resource_busy";
КонецФункции

// Ошибки отказа в доступе к файлу или каталогу.
//
// Возвращаемое значение:
//  Строка - Стабильный машинный код ошибки.
Функция ФайловаяСистемаДоступЗапрещен() Экспорт
	Возврат "filesystem.permission_denied";
КонецФункции

#КонецОбласти

