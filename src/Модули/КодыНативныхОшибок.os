	Коды.Добавить(ФоновыеЗадачиЗавершилисьСОшибками());
	Коды.Добавить(СвойствоОбъектаНеНайдено());
	Коды.Добавить(СвойствоОбъектаНедоступноДляЗаписи());
	Коды.Добавить(НекорректноеИмяСвойстваОбъекта());
	Коды.Добавить(ТаблицаНекорректноеИмяКолонки());
	Коды.Добавить(ТаблицаКолонкаУжеСуществует());
	Коды.Добавить(ТаблицаКонфликтРолейКолонки());
	Коды.Добавить(ИндексКоллекцииВнеДиапазона());
	Коды.Добавить(КлючКоллекцииНеНайден());
	Коды.Добавить(ЭлементНеПринадлежитКоллекции());
	Коды.Добавить(ИндексированноеЗначениеКоллекцииТолькоДляЧтения());
	Коды.Добавить(НекорректныйАргументКонструктораКоллекции());
	Коды.Добавить(ТаблицаНекорректноеСмещение());
	Коды.Добавить(ПреобразованиеТипаНеПоддерживается());
	Коды.Добавить(КонструкторТипаНеНайден());
	Коды.Добавить(НекорректныеКомпонентыДаты());
	Коды.Добавить(JSONНекорректныйСинтаксис());
	Коды.Добавить(JSONЧтениеНеОткрыто());
	Коды.Добавить(JSONЗаписьНеОткрыта());
	Коды.Добавить(JSONТекущееЗначениеНедоступно());
	Коды.Добавить(JSONНеподдерживаемыйТипЗначения());
	Коды.Добавить(JSONФорматДатыНеПоддерживается());
	Коды.Добавить(JSONНекорректноеПредставлениеДаты());
	Коды.Добавить(JSONЛокальнаяДатаНеПоддерживается());
	Коды.Добавить(XMLНекорректныйСинтаксис());
	Коды.Добавить(XMLЗаписьНеОткрыта());
	Коды.Добавить(XMLНекорректноеСостояниеЗаписи());
	Коды.Добавить(АрхивНеОткрыт());
	Коды.Добавить(ДвоичныеДанныеНекорректнаяHexСтрока());
	Коды.Добавить(ДвоичныеДанныеВыходЗаГраницыБуфера());
