#Область Тесты

&Тест
Процедура ТестДолжен_ПроверятьОжидаемоеПравилоИзАннотации() Экспорт

	// Подготовка
	Правило = НайтиПравилоПоТипу("System.IO.FileNotFoundException");
	Контекст = СоздатьИсточникОтсутствующегоФайла(Правило.Идентификатор);

	// Действие и Проверка
	МатрицаИсточниковОшибок.Проверить(Контекст, 1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеВызыватьИсточникНедоступнойВерсииOneScript() Экспорт

	// Подготовка
	Правило = НайтиПравилоПоТипу("System.IO.FileNotFoundException");
	Контекст = СоздатьНедоступныйИсточникОтсутствующегоФайла(Правило.Идентификатор);

	// Действие и Проверка
	МатрицаИсточниковОшибок.Проверить(Контекст, 1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеВызыватьИсточникНедоступнойОС() Экспорт

	// Подготовка
	Правило = НайтиПравилоПоТипу("System.IO.FileNotFoundException");
	Контекст = СоздатьНедоступныйИсточникОтсутствующегоФайлаДляОС(Правило.Идентификатор);

	// Действие и Проверка
	МатрицаИсточниковОшибок.Проверить(Контекст, 1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонятьДругоеПравилоСТемЖеКодом() Экспорт

	// Подготовка
	Правило = НайтиПравилоПоТипу("System.IO.DirectoryNotFoundException");
	Контекст = СоздатьИсточникОтсутствующегоФайла(Правило.Идентификатор);
	Параметры = Новый Массив;
	Параметры.Добавить(Контекст);
	Параметры.Добавить(1);

	// Действие и Проверка
	Ожидаем.Что(МатрицаИсточниковОшибок).Метод("Проверить", Параметры)
		.ВыбрасываетИсключение("Не пройдена проверка источника");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИзвлекатьПравилоКодИИмяИсточника() Экспорт

	// Подготовка
	Правило = НайтиПравилоПоТипу("System.IO.FileNotFoundException");
	Контекст = СоздатьИсточникОтсутствующегоФайла(Правило.Идентификатор);

	// Действие
	Источники = МатрицаИсточниковОшибок.ИсточникиПравил(Контекст);

	// Проверка
	Ожидаем.Что(Источники.Количество()).Равно(1);
	Ожидаем.Что(Источники[0].Правило).Равно(Правило.Идентификатор);
	Ожидаем.Что(Источники[0].КодОшибки).Равно(КодыНативныхОшибок.ФайловаяСистемаРесурсНеНайден());
	Ожидаем.Что(Источники[0].Метод).Равно("ПолучитьОшибку");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПроверятьКаждуюАннотациюПравила() Экспорт

	// Подготовка
	ПравилоФайла = НайтиПравилоПоТипу("System.IO.FileNotFoundException");
	ПравилоКаталога = НайтиПравилоПоТипу("System.IO.DirectoryNotFoundException");
	Контекст = СоздатьИсточникОтсутствующегоФайла(ПравилоФайла.Идентификатор, ПравилоКаталога.Идентификатор);
	Параметры = Новый Массив;
	Параметры.Добавить(Контекст);
	Параметры.Добавить(1);

	// Действие и Проверка
	Ожидаем.Что(МатрицаИсточниковОшибок).Метод("Проверить", Параметры)
		.ВыбрасываетИсключение("Не совпало правило " + ПравилоКаталога.Идентификатор);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыбиратьПравилоТекущейЛокали() Экспорт

	// Подготовка
	ПравилоФайла = НайтиПравилоПоТипу("System.IO.FileNotFoundException");
	ПравилоКаталога = НайтиПравилоПоТипу("System.IO.DirectoryNotFoundException");
	Если НСтр("ru = 'ru'; en = 'en'") = "ru" Тогда
		Шаблон = СтрШаблон("ru = '%1'; en = '%2'", ПравилоФайла.Идентификатор, ПравилоКаталога.Идентификатор);
	Иначе
		Шаблон = СтрШаблон("ru = '%1'; en = '%2'", ПравилоКаталога.Идентификатор, ПравилоФайла.Идентификатор);
	КонецЕсли;
	Контекст = СоздатьИсточникОтсутствующегоФайла(Шаблон);

	// Действие и Проверка
	МатрицаИсточниковОшибок.Проверить(Контекст, 1);
	Ожидаем.Что(МатрицаИсточниковОшибок.ИсточникиПравил(Контекст).Количество()).Равно(2);
	КонтекстБезПробелов = СоздатьИсточникОтсутствующегоФайла(СтрЗаменить(Шаблон, " ", ""));
	МатрицаИсточниковОшибок.Проверить(КонтекстБезПробелов, 1);
	Ожидаем.Что(МатрицаИсточниковОшибок.ИсточникиПравил(КонтекстБезПробелов).Количество()).Равно(2);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НайтиПравилоПоТипу(НативныйТип)

	Для Каждого Правило Из Новый ПравилаНативныхОшибок().Все() Цикл
		Если Правило.НативныйТип = НативныйТип Тогда
			Возврат Правило;
		КонецЕсли;
	КонецЦикла;

	ВызватьИсключение "Не найдено правило типа " + НативныйТип;

КонецФункции

Функция СоздатьИсточникОтсутствующегоФайла(ИдентификаторПравила, ВтороеПравило = "")

	ТекстСценария = "&ОжидаемыйКодОшибки(""ФайловаяСистемаРесурсНеНайден"")
		|&ОжидаемоеПравилоОшибки(""%1"")
		|%2
		|Функция ПолучитьОшибку() Экспорт
		|    Попытка
		|        Чтение = Новый ЧтениеТекста(ПолучитьИмяВременногоФайла());
		|    Исключение
		|        Возврат ИнформацияОбОшибке();
		|    КонецПопытки;
		|    ВызватьИсключение ""Ошибка отсутствующего файла не возникла"";
		|КонецФункции";

	АннотацияВторогоПравила = ?(
		ПустаяСтрока(ВтороеПравило),
		"",
		СтрШаблон("&ОжидаемоеПравилоОшибки(""%1"")", ВтороеПравило)
	);
	Возврат ЗагрузитьСценарийИзСтроки(СтрШаблон(
		ТекстСценария,
		ИдентификаторПравила,
		АннотацияВторогоПравила
	));

КонецФункции

Функция СоздатьНедоступныйИсточникОтсутствующегоФайла(ИдентификаторПравила)

	ТекстСценария = "&ВключенДляOneScript(""<0.0.0"")
		|&ОжидаемыйКодОшибки(""ФайловаяСистемаРесурсНеНайден"")
		|&ОжидаемоеПравилоОшибки(""%1"")
		|Функция ПолучитьОшибку() Экспорт
		|    ВызватьИсключение ""Источник недоступной версии не должен вызываться"";
		|КонецФункции";

	Возврат ЗагрузитьСценарийИзСтроки(СтрШаблон(ТекстСценария, ИдентификаторПравила));

КонецФункции

Функция СоздатьНедоступныйИсточникОтсутствующегоФайлаДляОС(ИдентификаторПравила)

	ТекстСценария = "&ВключенНаОС(""%1"")
		|&ОжидаемыйКодОшибки(""ФайловаяСистемаРесурсНеНайден"")
		|&ОжидаемоеПравилоОшибки(""%2"")
		|Функция ПолучитьОшибку() Экспорт
		|    ВызватьИсключение ""Источник недоступной ОС не должен вызываться"";
		|КонецФункции";

	Возврат ЗагрузитьСценарийИзСтроки(СтрШаблон(
		ТекстСценария,
		ПолучитьНедоступнуюОС(),
		ИдентификаторПравила
	));

КонецФункции

Функция ПолучитьНедоступнуюОС()

	ТекущаяОС = Новый СистемнаяИнформация().ТипПлатформы;
	Если ТекущаяОС = ТипПлатформы.Windows_x86 Или ТекущаяОС = ТипПлатформы.Windows_x86_64 Тогда
		Возврат "Linux";
	КонецЕсли;

	Возврат "Windows";

КонецФункции

#КонецОбласти
