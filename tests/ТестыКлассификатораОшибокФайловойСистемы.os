Процедура ТестДолжен_НеКлассифицироватьНеточныеСигнатурыСозданияСуществующегоФайла() Экспорт

	// Подготовка
	Описания = Новый Массив;
	Описания.Добавить("Cannot create a file when that file already exists.");
	Описания.Добавить("External exception (System.ArgumentException): "
		+ "Cannot create a file when that file already exists.");
	Описания.Добавить("External exception (System.IO.IOException): "
		+ "Cannot create a file when that directory already exists.");
	Описания.Добавить("Внешнее исключение (System.ArgumentException): "
		+ "Невозможно создать файл, так как он уже существует.");
	Описания.Добавить("Внешнее исключение (System.IO.IOException): Невозможно открыть файл, так как он уже существует.");

	// Действие и Проверка
	Для Каждого Описание Из Описания Цикл
		Ошибка = Новый ИнформацияОбОшибке(Описание, Новый Структура("Источник", "Тест"));
		ТестовыйПробросПодробногоПредставления.ПроверитьНеклассифицированностьВариантами(Ошибка);
	КонецЦикла;

КонецПроцедуры

&Тест
