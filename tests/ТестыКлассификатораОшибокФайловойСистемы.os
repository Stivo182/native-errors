	);
	Ошибка = Новый ИнформацияОбОшибке(
		"External exception (System.IO.IOException): Other filesystem error.",
		Новый Структура("Источник", "Тест"),
		Причина
	);

	// Действие и Проверка
	ТестовыйПробросПодробногоПредставления.ПроверитьНеклассифицированностьВариантами(Ошибка);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьОшибкуЧтенияОтсутствующегоФайла(Путь)

	Попытка
		Чтение = Новый ЧтениеТекста(Путь);
		Чтение.Прочитать();
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка открытия отсутствующего файла не возникла";

КонецФункции

&ОжидаемыйКодОшибки("ФайловаяСистемаРесурсНеНайден")
&ОжидаемоеПравилоОшибки("filesystem.not_found.file_type")
Функция ПолучитьОшибкуОтсутствующегоФайла() Экспорт

	Путь = ОбъединитьПути(
		ТекущийСценарий().Каталог,
		"fixtures/гарантированно-отсутствующий-файл-native-errors.txt"
	);
	Ожидаем.Что(Новый Файл(Путь).Существует()).Равно(Ложь);

	Возврат ПолучитьОшибкуЧтенияОтсутствующегоФайла(Путь);

КонецФункции

&ОжидаемыйКодОшибки("ФайловаяСистемаРесурсНеНайден")
&ОжидаемоеПравилоОшибки("filesystem.not_found.directory_type")
Функция ПолучитьОшибкуОтсутствующегоКаталогаВПути() Экспорт

	ПутьКаталога = ОбъединитьПути(
		ТекущийСценарий().Каталог,
		"fixtures/гарантированно-отсутствующий-каталог-native-errors"
	);
	Путь = ОбъединитьПути(ПутьКаталога, "file.txt");
	Ожидаем.Что(Новый Файл(ПутьКаталога).Существует()).Равно(Ложь);

	Возврат ПолучитьОшибкуЧтенияОтсутствующегоФайла(Путь);

КонецФункции

&ОжидаемыйКодОшибки("ФайловаяСистемаРесурсНеНайден")
&ОжидаемоеПравилоОшибки("filesystem.not_found.file_type")
Функция ПолучитьОшибкуПодключенияОтсутствующейВнешнейКомпоненты() Экспорт

	Путь = ОбъединитьПути(
		КаталогВременныхФайлов(),
		"гарантированно-отсутствующая-внешняя-компонента-native-errors.dll"
	);
	Ожидаем.Что(Новый Файл(Путь).Существует()).Равно(Ложь);

	Попытка
		ПодключитьВнешнююКомпоненту(Путь);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка подключения отсутствующей внешней компоненты не возникла";

КонецФункции

&ОжидаемыйКодОшибки("ФайловаяСистемаРесурсУжеСуществует")
&ОжидаемоеПравилоОшибки("filesystem.already_exists.file_path")
Функция ПолучитьОшибкуСозданияСуществующегоФайла() Экспорт

	ИмяФайла = ПолучитьИмяВременногоФайла();
	Запись = Новый ЗаписьТекста(ИмяФайла);
	Запись.Закрыть();

	Попытка
		Поток = Новый ФайловыйПоток(
			ИмяФайла,
			РежимОткрытияФайла.СоздатьНовый,
			ДоступКФайлу.Запись
		);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	УдалитьФайлы(ИмяФайла);
	Если Ошибка <> Неопределено Тогда
		Возврат Ошибка;
	КонецЕсли;

	ВызватьИсключение "Ожидаемая ошибка создания существующего файла не возникла";

КонецФункции

&ОжидаемыйКодОшибки("ФайловаяСистемаРесурсЗанят")
&ОжидаемоеПравилоОшибки("filesystem.resource_busy")
Функция ПолучитьОшибкуИспользуемогоФайла() Экспорт

	ИмяФайла = ПолучитьИмяВременногоФайла();
	Запись = Новый ЗаписьТекста(ИмяФайла);
	Запись.Закрыть();
	ПервыйПоток = Новый ФайловыйПоток(
		ИмяФайла,
		РежимОткрытияФайла.Открыть,
		ДоступКФайлу.Запись
	);

	Попытка
		ВторойПоток = Новый ФайловыйПоток(
			ИмяФайла,
			РежимОткрытияФайла.Открыть,
			ДоступКФайлу.Запись
		);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	ПервыйПоток.Закрыть();
	УдалитьФайлы(ИмяФайла);
	Если Ошибка <> Неопределено Тогда
		Возврат Ошибка;
	КонецЕсли;

	ВызватьИсключение "Ожидаемая ошибка используемого файла не возникла";

КонецФункции

&ОжидаемыйКодОшибки("ФайловаяСистемаДоступЗапрещен")
&ОжидаемоеПравилоОшибки("filesystem.access_denied")
Функция ПолучитьОшибкуОткрытияКаталогаКакФайла() Экспорт

	Каталог = ОбъединитьПути(
		КаталогВременныхФайлов(),
		"native-errors-directory-as-file-" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "")
	);
	СоздатьКаталог(Каталог);

	Попытка
		Запись = Новый ЗаписьТекста(Каталог);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	УдалитьФайлы(Каталог);
	Если Ошибка <> Неопределено Тогда
		Возврат Ошибка;
	КонецЕсли;

	ВызватьИсключение "Ожидаемая ошибка открытия каталога как файла не возникла";

КонецФункции

&ОжидаемыйКодОшибки("ФайловаяСистемаРесурсУжеСуществует")
&ОжидаемоеПравилоОшибки("filesystem.already_exists.directory_path")
Функция ПолучитьОшибкуСозданияКаталогаПоверхФайла() Экспорт

	Путь = ПолучитьИмяВременногоФайла();
	Запись = Новый ЗаписьТекста(Путь);
	Запись.Закрыть();
	ИсходнаяОшибка = Неопределено;

	Попытка
		СоздатьКаталог(Путь);
	Исключение
		ИсходнаяОшибка = ИнформацияОбОшибке();
	КонецПопытки;

	УдалитьФайлы(Путь);
	Если ИсходнаяОшибка <> Неопределено Тогда
		Возврат ИсходнаяОшибка;
	КонецЕсли;

	ВызватьИсключение "Ожидаемая ошибка создания каталога поверх файла не возникла";

КонецФункции

&ОжидаемыйКодОшибки("ФайловаяСистемаРесурсУжеСуществует")
&ОжидаемоеПравилоОшибки("filesystem.already_exists.file_win32")
Функция ПолучитьОшибкуПеремещенияПоверхСуществующегоФайла() Экспорт

	Источник = ПолучитьИмяВременногоФайла();
	Приемник = ПолучитьИмяВременногоФайла();
	Запись = Новый ЗаписьТекста(Источник);
	Запись.Закрыть();
	Запись = Новый ЗаписьТекста(Приемник);
	Запись.Закрыть();
	ИсходнаяОшибка = Неопределено;

	Попытка
		ПереместитьФайл(Источник, Приемник);
	Исключение
		ИсходнаяОшибка = ИнформацияОбОшибке();
	КонецПопытки;

	УдалитьФайлы(Источник);
	УдалитьФайлы(Приемник);
	Если ИсходнаяОшибка <> Неопределено Тогда
		Возврат ИсходнаяОшибка;
	КонецЕсли;

	ВызватьИсключение "Ожидаемая ошибка перемещения поверх существующего файла не возникла";

КонецФункции

#КонецОбласти
