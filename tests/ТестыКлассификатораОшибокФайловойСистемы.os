КонецФункции

&Тест
Процедура ТестДолжен_НеКлассифицироватьНеточныеСигнатурыСуществующегоРесурса() Экспорт

	// Подготовка
	Описания = Новый Массив;
	Описания.Добавить("Cannot create 'path' because a file or directory with the same name already exists.");
	Описания.Добавить("External exception (System.ArgumentException): "
		+ "Cannot create 'path' because a file or directory with the same name already exists.");
	Описания.Добавить("External exception (System.IO.IOException): "
		+ "Cannot open 'path' because a file or directory with the same name already exists.");
	Описания.Добавить("External exception (System.IO.IOException): "
		+ "Cannot create 'path' because a file or directory with the same name does not exist.");

	// Действие и Проверка
	Для Каждого Описание Из Описания Цикл
		Ошибка = Новый ИнформацияОбОшибке(Описание, Новый Структура("Источник", "Тест"));
		ТестовыйПробросПодробногоПредставления.ПроверитьНеклассифицированностьВариантами(Ошибка);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеСопоставлятьОбрамлениеСообщенияОСуществующемРесурсеИзРазныхКадров() Экспорт

	// Подготовка
	Причина = Новый ИнформацияОбОшибке(
		"External exception (System.IO.IOException): ' because a file or directory with the same name already exists.",
		Новый Структура("Источник", "Тест")
	);
	Ошибка = Новый ИнформацияОбОшибке(
		"External exception (System.IO.IOException): Cannot create 'path' for another reason.",
		Новый Структура("Источник", "Тест"),
		Причина
	);

	// Действие и Проверка
	ТестовыйПробросПодробногоПредставления.ПроверитьНеклассифицированностьВариантами(Ошибка);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеКлассифицироватьНеточныеСигнатурыСозданияСуществующегоФайла() Экспорт

	// Подготовка
	Описания = Новый Массив;
	Описания.Добавить("Cannot create a file when that file already exists.");
	Описания.Добавить("External exception (System.ArgumentException): "
		+ "Cannot create a file when that file already exists.");
	Описания.Добавить("External exception (System.IO.IOException): "
		+ "Cannot create a file when that directory already exists.");
	Описания.Добавить("Внешнее исключение (System.ArgumentException): "
		+ "Невозможно создать файл, так как он уже существует.");
	Описания.Добавить("Внешнее исключение (System.IO.IOException): Невозможно открыть файл, так как он уже существует.");

	// Действие и Проверка
	Для Каждого Описание Из Описания Цикл
		Ошибка = Новый ИнформацияОбОшибке(Описание, Новый Структура("Источник", "Тест"));
		ТестовыйПробросПодробногоПредставления.ПроверитьНеклассифицированностьВариантами(Ошибка);
	КонецЦикла;

КонецПроцедуры

