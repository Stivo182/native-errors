#Использовать "./internal"

Перем _Проброс; // ТестовыйПробросПодробногоПредставления

#Область ОбработчикиСобытий

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПередВсеми() Экспорт

	_Проброс = Новый ТестовыйПробросПодробногоПредставления;

КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_КлассифицироватьОтсутствующийФайл() Экспорт

	// Подготовка
	Путь = ОбъединитьПути(
		ТекущийСценарий().Каталог,
		"fixtures/гарантированно-отсутствующий-файл-native-errors.txt"
	);
	Ожидаем.Что(Новый Файл(Путь).Существует()).Равно(Ложь);
	ИсходнаяОшибка = ПолучитьОшибкуЧтенияОтсутствующегоФайла(Путь);

	// Действие
	НормализованнаяОшибка = Новый КлассификаторНативныхОшибок.Классифицировать(ИсходнаяОшибка);

	// Проверка
	Ожидаем.Что(НормализованнаяОшибка).ИмеетТип("ИнформацияОбОшибке");
	Снимок = Новый СнимокКадраОшибки(НормализованнаяОшибка);
	Ожидаем.Что(Снимок.КодОшибки()).Равно(КодыНативныхОшибок.ФайловаяСистемаРесурсНеНайден());
	Ожидаем.Что(НормализованнаяОшибка.Причина).Идентично(ИсходнаяОшибка);
	Проброс = _Проброс;
	Проброс.ПроверитьКодВариантами(Новый КлассификаторНативныхОшибок, ИсходнаяОшибка,
		КодыНативныхОшибок.ФайловаяСистемаРесурсНеНайден());

КонецПроцедуры

