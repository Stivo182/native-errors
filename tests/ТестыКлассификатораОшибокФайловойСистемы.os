КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьОшибкуЧтенияОтсутствующегоФайла(Путь)

	Попытка
		Чтение = Новый ЧтениеТекста(Путь);
		Чтение.Прочитать();
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка открытия отсутствующего файла не возникла";

КонецФункции

Функция ПолучитьОшибкуСозданияСуществующегоФайла()

	ИмяФайла = ПолучитьИмяВременногоФайла();
	Запись = Новый ЗаписьТекста(ИмяФайла);
	Запись.Закрыть();

	Попытка
		Поток = Новый ФайловыйПоток(
			ИмяФайла,
			РежимОткрытияФайла.СоздатьНовый,
			ДоступКФайлу.Запись
		);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	УдалитьФайлы(ИмяФайла);
	Если Ошибка <> Неопределено Тогда
		Возврат Ошибка;
	КонецЕсли;

	ВызватьИсключение "Ожидаемая ошибка создания существующего файла не возникла";

КонецФункции

Функция ПолучитьОшибкуИспользуемогоФайла()

	ИмяФайла = ПолучитьИмяВременногоФайла();
	Запись = Новый ЗаписьТекста(ИмяФайла);
	Запись.Закрыть();
	ПервыйПоток = Новый ФайловыйПоток(
		ИмяФайла,
		РежимОткрытияФайла.Открыть,
		ДоступКФайлу.Запись
	);

	Попытка
		ВторойПоток = Новый ФайловыйПоток(
			ИмяФайла,
			РежимОткрытияФайла.Открыть,
			ДоступКФайлу.Запись
		);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	ПервыйПоток.Закрыть();
	УдалитьФайлы(ИмяФайла);
	Если Ошибка <> Неопределено Тогда
		Возврат Ошибка;
	КонецЕсли;

	ВызватьИсключение "Ожидаемая ошибка используемого файла не возникла";

КонецФункции

Функция ПолучитьОшибкуОткрытияКаталогаКакФайла()

	Каталог = ОбъединитьПути(
		КаталогВременныхФайлов(),
		"native-errors-directory-as-file-" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "")
	);
	СоздатьКаталог(Каталог);

	Попытка
		Запись = Новый ЗаписьТекста(Каталог);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	УдалитьФайлы(Каталог);
	Если Ошибка <> Неопределено Тогда
		Возврат Ошибка;
	КонецЕсли;

	ВызватьИсключение "Ожидаемая ошибка открытия каталога как файла не возникла";

КонецФункции

#КонецОбласти
