&ОжидаемыйКодОшибки("XMLПовторноеОбъявлениеЭлементаВСхеме")
&ОжидаемоеПравилоОшибки("xml.schema_duplicate_element")
Функция ПолучитьОшибкуПовторногоОбъявленияЭлементаВСхемеXML() Экспорт

	Схема = Новый СхемаXML;
	ИмяТипа = Новый РасширенноеИмяXML(
		"http://www.w3.org/2001/XMLSchema",
		"string"
	);
	ПервыйЭлемент = Новый ОбъявлениеЭлементаXS;
	ПервыйЭлемент.Имя = "duplicate";
	ПервыйЭлемент.ИмяТипа = ИмяТипа;
	Схема.Содержимое.Добавить(ПервыйЭлемент);
	ВторойЭлемент = Новый ОбъявлениеЭлементаXS;
	ВторойЭлемент.Имя = "duplicate";
	ВторойЭлемент.ИмяТипа = ИмяТипа;
	Схема.Содержимое.Добавить(ВторойЭлемент);

	Попытка
		Результат = Схема.ТекстXML();
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка повторного объявления элемента схемы XML не возникла";

КонецФункции

#КонецОбласти
