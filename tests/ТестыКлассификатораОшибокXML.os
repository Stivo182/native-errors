	Запись = Новый ЗаписьXML;
	Запись.УстановитьСтроку();

	Попытка
		Запись.ЗаписатьКонецЭлемента();
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка завершения не открытого элемента XML не возникла";

