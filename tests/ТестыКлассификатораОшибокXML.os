#Использовать asserts
#Использовать errors
#Использовать "../src"
#Использовать "./internal"

Перем _Проброс; // ТестовыйПробросПодробногоПредставления

#Область ОбработчикиСобытий

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПередВсеми() Экспорт

	_Проброс = Новый ТестовыйПробросПодробногоПредставления;

КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_КлассифицироватьЗаписьXMLДоОткрытия() Экспорт

	// Действие
	Попытка
		Запись = Новый ЗаписьXML;
		Запись.ЗаписатьНачалоЭлемента("root");
	Исключение
		ИсходнаяОшибка = ИнформацияОбОшибке();
	КонецПопытки;

	Ошибка = Новый КлассификаторНативныхОшибок.Классифицировать(ИсходнаяОшибка);
	
	// Проверка
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно(КодыНативныхОшибок.XMLЗаписьНеОткрыта());
	Ожидаем.Что(Ошибка.Причина).Идентично(ИсходнаяОшибка);
	Проброс = _Проброс;
	Проброс.ПроверитьКодВариантами(Новый КлассификаторНативныхОшибок, ИсходнаяОшибка,
		КодыНативныхОшибок.XMLЗаписьНеОткрыта());

КонецПроцедуры

&Тест
Процедура ТестДолжен_КлассифицироватьНекорректныйXML() Экспорт

	// Подготовка
	ИсходнаяОшибка = ПолучитьОшибкуНекорректногоXML();

	// Действие
	НормализованнаяОшибка = Новый КлассификаторНативныхОшибок.Классифицировать(ИсходнаяОшибка);

	// Проверка
	Ожидаем.Что(НормализованнаяОшибка).ИмеетТип("ИнформацияОбОшибке");
	Снимок = Новый СнимокКадраОшибки(НормализованнаяОшибка);
	Ожидаем.Что(Снимок.КодОшибки()).Равно(КодыНативныхОшибок.XMLНекорректныйСинтаксис());
	Ожидаем.Что(НормализованнаяОшибка.Причина).Идентично(ИсходнаяОшибка);
	Проброс = _Проброс;
	Проброс.ПроверитьКодВариантами(Новый КлассификаторНативныхОшибок, ИсходнаяОшибка,
		КодыНативныхОшибок.XMLНекорректныйСинтаксис());

КонецПроцедуры

&Тест
Процедура ТестДолжен_КлассифицироватьОшибочныйПорядокЗаписиXML() Экспорт

	// Подготовка
	ИсходнаяОшибка = ПолучитьОшибкуПорядкаЗаписиXML();

	// Действие
	НормализованнаяОшибка = Новый КлассификаторНативныхОшибок.Классифицировать(ИсходнаяОшибка);

	// Проверка
	Ожидаем.Что(НормализованнаяОшибка).ИмеетТип("ИнформацияОбОшибке");
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(НормализованнаяОшибка))
		.Равно(КодыНативныхОшибок.XMLНекорректноеСостояниеЗаписи());
	Ожидаем.Что(НормализованнаяОшибка.Причина).Идентично(ИсходнаяОшибка);
	Проброс = _Проброс;
	Проброс.ПроверитьКодВариантами(Новый КлассификаторНативныхОшибок, ИсходнаяОшибка,
		КодыНативныхОшибок.XMLНекорректноеСостояниеЗаписи());

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьОшибкуНекорректногоXML()

	Попытка
		Чтение = Новый ЧтениеXML;
		Чтение.УстановитьСтроку("<root><child></root>");
		Пока Чтение.Прочитать() Цикл
		КонецЦикла;
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка чтения XML не возникла";

КонецФункции

Функция ПолучитьОшибкуПорядкаЗаписиXML()

	Попытка
		Запись = Новый ЗаписьXML;
		Запись.УстановитьСтроку();
		Запись.ЗаписатьНачалоЭлемента("a");
		Запись.ЗаписатьТипДокумента("A", "B");
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка порядка записи XML не возникла";

КонецФункции

#КонецОбласти
