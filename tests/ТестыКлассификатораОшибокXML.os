#Использовать "./internal"

#Область ОбработчикиСобытий

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_КлассифицироватьАннотированныеИсточникиОшибок() Экспорт

	// Подготовка
	МатрицаИсточниковОшибок.Проверить(ЭтотОбъект, 4);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&ОжидаемыйКодОшибки("XMLЗаписьНеОткрыта")
Функция ПолучитьОшибкуЗаписиXMLДоОткрытия() Экспорт

	Попытка
		Запись = Новый ЗаписьXML;
		Запись.ЗаписатьНачалоЭлемента("root");
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка записи XML до открытия не возникла";

КонецФункции

&ОжидаемыйКодОшибки("XMLНекорректныйСинтаксис")
Функция ПолучитьОшибкуНекорректногоXML() Экспорт

	Попытка
		Чтение = Новый ЧтениеXML;
		Чтение.УстановитьСтроку("<root><child></root>");
		Пока Чтение.Прочитать() Цикл
		КонецЦикла;
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка чтения XML не возникла";

КонецФункции

&ОжидаемыйКодОшибки("XMLСистемныйИдентификаторНеЗадан")
Функция ПолучитьОшибкуОтсутствующегоСистемногоИдентификатораXML() Экспорт

	Попытка
		Запись = Новый ЗаписьXML;
		Запись.УстановитьСтроку();
		Запись.ЗаписатьТипДокумента("A", "B", , "D");
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка отсутствующего системного идентификатора XML не возникла";

КонецФункции

&ОжидаемыйКодОшибки("XMLНекорректноеСостояниеЗаписи")
Функция ПолучитьОшибкуПорядкаЗаписиXML() Экспорт

	Попытка
		Запись = Новый ЗаписьXML;
		Запись.УстановитьСтроку();
		Запись.ЗаписатьНачалоЭлемента("a");
		Запись.ЗаписатьТипДокумента("A", "B");
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка порядка записи XML не возникла";

КонецФункции

#КонецОбласти
