#Использовать asserts
#Использовать errors
#Использовать "../src"
#Использовать "./internal"

Перем _Проброс; // ТестовыйПробросПодробногоПредставления

#Область ОбработчикиСобытий

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПередВсеми() Экспорт

	_Проброс = Новый ТестовыйПробросПодробногоПредставления;

КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_КлассифицироватьНеизвестнуюКодировку() Экспорт

	// Подготовка
	ИсходнаяОшибка = ПолучитьОшибкуНеизвестнойКодировки();

	// Действие
	НормализованнаяОшибка = Новый КлассификаторНативныхОшибок.Классифицировать(ИсходнаяОшибка);

	// Проверка
	Ожидаем.Что(НормализованнаяОшибка).ИмеетТип("ИнформацияОбОшибке");
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(НормализованнаяОшибка))
		.Равно(КодыНативныхОшибок.ТекстНеизвестнаяКодировка());
	Ожидаем.Что(НормализованнаяОшибка.Причина).Идентично(ИсходнаяОшибка);
	Проброс = _Проброс;
	Проброс.ПроверитьКодВариантами(Новый КлассификаторНативныхОшибок, ИсходнаяОшибка,
		КодыНативныхОшибок.ТекстНеизвестнаяКодировка());

КонецПроцедуры

&Тест
Процедура ТестДолжен_КлассифицироватьЧтениеДоОткрытия() Экспорт

	// Действие
	Попытка
		Чтение = Новый ЧтениеТекста;
		Результат = Чтение.Прочитать();
	Исключение
		ИсходнаяОшибка = ИнформацияОбОшибке();
	КонецПопытки;

	НормализованнаяОшибка = Новый КлассификаторНативныхОшибок.Классифицировать(ИсходнаяОшибка);

	// Проверка
	Ожидаем.Что(НормализованнаяОшибка).ИмеетТип("ИнформацияОбОшибке");
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(НормализованнаяОшибка))
		.Равно(КодыНативныхОшибок.ТекстНеОткрыт());
	Ожидаем.Что(НормализованнаяОшибка.Причина).Идентично(ИсходнаяОшибка);
	Проброс = _Проброс;
	Проброс.ПроверитьКодВариантами(Новый КлассификаторНативныхОшибок, ИсходнаяОшибка,
		КодыНативныхОшибок.ТекстНеОткрыт());

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьОшибкуНеизвестнойКодировки()

	Попытка
		Чтение = Новый ЧтениеТекста(ТекущийСценарий().Источник, "X-NATIVE-ERRORS-UNKNOWN");
		Чтение.Прочитать();
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка неизвестной кодировки не возникла";

КонецФункции

#КонецОбласти
