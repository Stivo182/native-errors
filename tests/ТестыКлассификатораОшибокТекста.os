#Область СлужебныеПроцедурыИФункции

&ОжидаемыйКодОшибки("ТекстоваяКодировкаНеизвестна")
&ОжидаемоеПравилоОшибки("text.unknown_encoding.onescript")
Функция ПолучитьОшибкуНеизвестнойКодировки() Экспорт

	Попытка
		Чтение = Новый ЧтениеТекста(ТекущийСценарий().Источник, "X-NATIVE-ERRORS-UNKNOWN");
		Чтение.Прочитать();
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка неизвестной кодировки не возникла";

КонецФункции

&ОжидаемыйКодОшибки("URLЯвнаяКодировкаНеПоддерживается")
&ОжидаемоеПравилоОшибки("url.explicit_encoding_not_supported")
Функция ПолучитьОшибкуЯвнойКодировкиURL() Экспорт

	Попытка
		РаскодироватьСтроку(
			"%D0%A2",
			СпособКодированияСтроки.КодировкаURL,
			"windows-1251"
		);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка явной кодировки URL не возникла";

КонецФункции

&ОжидаемыйКодОшибки("ТекстовыйОбъектНеОткрыт")
&ОжидаемоеПравилоОшибки("text.not_open")
Функция ПолучитьОшибкуЧтенияТекстаДоОткрытия() Экспорт

	Попытка
		Чтение = Новый ЧтениеТекста;
		Результат = Чтение.Прочитать();
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка чтения текста до открытия не возникла";

КонецФункции

&ОжидаемыйКодОшибки("ПотокНедоступенДляЧтения")
&ОжидаемоеПравилоОшибки("stream.not_readable")
Функция ПолучитьОшибкуОткрытияЗакрытогоПотокаЧтениемТекста() Экспорт

	Поток = Новый ПотокВПамяти;
	Поток.Закрыть();

	Попытка
		Чтение = Новый ЧтениеТекста(Поток);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка открытия закрытого потока чтением текста не возникла";

КонецФункции

&ОжидаемыйКодОшибки("ФайловаяСистемаРесурсНеНайден")
&ОжидаемоеПравилоОшибки("filesystem.not_found.file_type")
Функция ПолучитьОшибкуОткрытияОтсутствующегоФайлаЧтениемТекста() Экспорт

	Путь = ОбъединитьПути(
		ТекущийСценарий().Каталог,
		"native-errors-missing-text-file"
	);

	Попытка
		Чтение = Новый ЧтениеТекста(Путь);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка открытия отсутствующего файла чтением текста не возникла";

КонецФункции

&ОжидаемыйКодОшибки("ТекстовыйОбъектНеОткрыт")
&ОжидаемоеПравилоОшибки("text.not_open")
Функция ПолучитьОшибкуЗаписиТекстаДоОткрытия() Экспорт

	Попытка
		Запись = Новый ЗаписьТекста;
		Запись.Записать("Текст");
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка записи текста до открытия не возникла";

КонецФункции

#КонецОбласти
