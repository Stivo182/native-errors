&Тест
Процедура ТестДолжен_СоздаватьРаспознавательИзКадровЦепочки() Экспорт

	// Подготовка
	Ошибка = СоздатьЦепочкуНативныхОшибок();
	Цепочка = Новый ЦепочкаКадровОшибки(Новый СнимокКадраОшибки(Ошибка));

	// Действие
	Распознаватель = Новый РаспознавательОшибки(Цепочка.Кадры());

	// Проверка
	Ожидаем.Что(Распознаватель.СодержитТип("System.Net.Sockets.SocketException")).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздаватьЦепочкуСГотовымКорневымСнимком() Экспорт

	// Подготовка
	Ошибка = СоздатьЦепочкуНативныхОшибок();
	КорневойСнимок = Новый СнимокКадраОшибки(Ошибка);

	// Действие
	Цепочка = Новый ЦепочкаКадровОшибки(КорневойСнимок);
	Кадры = Цепочка.Кадры();

	// Проверка
	Ожидаем.Что(Кадры[0].ИсходнаяОшибка).Идентично(Ошибка);
	Ожидаем.Что(Кадры[0].Описание).Равно(КорневойСнимок.Сообщение());
	Ожидаем.Что(Кадры[0].КодОшибки).Равно(КорневойСнимок.КодОшибки());
	Ожидаем.Что(Кадры[0].Данные).Идентично(КорневойСнимок.Данные());

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИскатьНативныеТипыВПорядкеПереданногоСписка() Экспорт

	// Подготовка
	Ошибка = СоздатьЦепочкуНативныхОшибок();
	Распознаватель = СоздатьРаспознаватель(Ошибка);
	НативныеТипы = Новый Массив;
	НативныеТипы.Добавить("System.Net.Sockets.SocketException");
	НативныеТипы.Добавить("System.Net.WebException");

	// Действие
	НайденныйТип = Распознаватель.НайтиТип(НативныеТипы);

	// Проверка
	Ожидаем.Что(НайденныйТип).Равно("System.Net.Sockets.SocketException");

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеСопоставлятьТипИОкончаниеИзРазныхКадров() Экспорт

	// Подготовка
	Причина = СоздатьВнешнююОшибку("External exception (System.IO.IOException): inner suffix");
	Ошибка = СоздатьВнешнююОшибку(
		"External exception (System.Net.WebException): outer message",
		Причина
	);
	Распознаватель = СоздатьРаспознаватель(Ошибка);

	// Действие
	Результат = Распознаватель.СодержитТипИОкончаниеСообщения(
		"System.Net.WebException",
		"inner suffix"
	);

	// Проверка
	Ожидаем.Что(Результат).Равно(Ложь);

КонецПроцедуры

