&Тест
Процедура ТестДолжен_ВозвращатьНезависимуюКопиюКадров() Экспорт

	// Подготовка
	Данные = Новый Структура("Ключ", "Значение");
	Ошибка = ФабрикаОшибок.Создать("test.code", "Точное сообщение", Данные);
	Цепочка = Новый ЦепочкаКадровОшибки(Новый СнимокКадраОшибки(Ошибка));

	// Действие
	Кадры = Цепочка.Кадры();
	Кадр = Кадры[0];
	Кадры.Очистить();

	// Проверка
	Ожидаем.Что(ТипЗнч(Кадр)).Равно(Тип("ФиксированнаяСтруктура"));
	Ожидаем.Что(Кадр.Глубина).Равно(0);
	Ожидаем.Что(Кадр.ИсходнаяОшибка).Идентично(Ошибка);
	Ожидаем.Что(Кадр.Описание).Равно("Точное сообщение");
	Ожидаем.Что(Кадр.НативныйТип).Идентично(Неопределено);
	Ожидаем.Что(Кадр.КодОшибки).Равно("test.code");
	Ожидаем.Что(Кадр.Данные).Идентично(Данные);
	Ожидаем.Что(Кадр.Восстановлен).ЭтоЛожь();
	Ожидаем.Что(Цепочка.Кадры().Количество()).Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздаватьНезависимыйРаспознавательОдногоКадра() Экспорт

	// Подготовка
	Причина = СоздатьВнешнююОшибку("External exception (System.IO.IOException): внутренняя ошибка");
	Ошибка = СоздатьВнешнююОшибку(
		"External exception (System.Net.WebException): внешняя ошибка",
		Причина
	);
	Цепочка = Новый ЦепочкаКадровОшибки(Новый СнимокКадраОшибки(Ошибка));
	Кадры = Цепочка.Кадры();

	// Действие
	КадрыОдногоКадра = Новый Массив;
	КадрыОдногоКадра.Добавить(Кадры[1]);
	РаспознавательКадра = Новый РаспознавательОшибки(КадрыОдногоКадра);
	Распознаватель = Новый РаспознавательОшибки(Кадры);

	// Проверка
	Ожидаем.Что(РаспознавательКадра.СодержитТип("System.IO.IOException")).ЭтоИстина();
	Ожидаем.Что(РаспознавательКадра.СодержитТип("System.Net.WebException")).ЭтоЛожь();
	Ожидаем.Что(Распознаватель.СодержитТип("System.Net.WebException")).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтделятьФизическийКадрОтВосстановленногоТекста() Экспорт

	// Подготовка
	Данные = Новый Структура("Ключ", "Значение");
	Ошибка = ФабрикаОшибок.Создать(
		"domain.failure",
		"{Модуль Тест / Ошибка в строке: 1 / Точное сообщение}",
		Данные
	);
	Цепочка = Новый ЦепочкаКадровОшибки(Новый СнимокКадраОшибки(Ошибка));

	// Действие
	Кадры = Цепочка.Кадры();
	Ожидаем.Что(Кадры.Количество()).Равно(2);
	ФизическийКадр = Кадры[0];
	ВосстановленныйКадр = Кадры[1];

	// Проверка
	Ожидаем.Что(ФизическийКадр.Описание).Равно(
		"{Модуль Тест / Ошибка в строке: 1 / Точное сообщение}"
	);
	Ожидаем.Что(ФизическийКадр.КодОшибки).Равно("domain.failure");
	Ожидаем.Что(ФизическийКадр.Данные).Идентично(Данные);
	Ожидаем.Что(ФизическийКадр.Восстановлен).ЭтоЛожь();
	Ожидаем.Что(ВосстановленныйКадр.Описание).Равно("Точное сообщение");
	Ожидаем.Что(ВосстановленныйКадр.КодОшибки).Равно("");
	Ожидаем.Что(ВосстановленныйКадр.Данные).Идентично(Неопределено);
	Ожидаем.Что(ВосстановленныйКадр.Восстановлен).ЭтоИстина();

КонецПроцедуры

