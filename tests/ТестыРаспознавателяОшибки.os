&Тест
Процедура ТестДолжен_НаходитьАнглийскоеОбрамлениеСообщенияНативногоТипа() Экспорт

	// Подготовка
	Ошибка = СоздатьВнешнююОшибку(
		"External exception (System.IO.IOException): English start значение English end"
	);
	Распознаватель = СоздатьРаспознаватель(Ошибка);

	// Действие
	НайденоОбрамление = Распознаватель.СодержитТипИОбрамлениеСообщения(
		"System.IO.IOException",
		"en = 'English start'; ru = 'Русское начало'",
		"en = 'English end'; ru = 'Русское окончание'"
	);
	НеНайденоОбрамление = Распознаватель.СодержитТипИОбрамлениеСообщения(
		"System.Net.WebException",
		"English start",
		"English end"
	);

	// Проверка
	Ожидаем.Что(НайденоОбрамление).ЭтоИстина();
	Ожидаем.Что(НеНайденоОбрамление).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_НаходитьАнглийскиеПрефиксИОкончаниеСообщения() Экспорт

	// Подготовка
	Ошибка = СоздатьВнешнююОшибку("English start значение English end");
	Распознаватель = СоздатьРаспознаватель(Ошибка);

	// Действие
	НайденоСообщение = Распознаватель.СодержитПрефиксИОкончаниеСообщения(
		"en = 'English start'; ru = 'Русское начало'",
		"en = 'English end'; ru = 'Русское окончание'"
	);
	НеНайденоСообщение = Распознаватель.СодержитПрефиксИОкончаниеСообщения(
		"English start",
		"Отсутствующее окончание"
	);

	// Проверка
	Ожидаем.Что(НайденоСообщение).ЭтоИстина();
	Ожидаем.Что(НеНайденоСообщение).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИндексироватьНативныеИсключенияИзПодробногоПредставления() Экспорт

	// Подготовка
	Описание = "{Модуль Тест / Ошибка в строке: 1 / "
		+ "Внешнее исключение (System.Net.WebException): внешняя ошибка}" + Символы.ПС
		+ "по причине:" + Символы.ПС
		+ "External exception (System.IO.IOException): глубинная ошибка";
	Ошибка = СоздатьВнешнююОшибку(Описание);
	Распознаватель = СоздатьРаспознаватель(Ошибка);

	// Действие
	НайденВнешнийТип = Распознаватель.СодержитТип("System.Net.WebException");
	НайденГлубинныйТип = Распознаватель.СодержитТип("System.IO.IOException");

	// Проверка
	Ожидаем.Что(НайденВнешнийТип).ЭтоИстина();
	Ожидаем.Что(НайденГлубинныйТип).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИндексироватьПричиныИзПодробногоПредставления() Экспорт

	// Подготовка
	Описание = "{Модуль Тест / Ошибка в строке: 1 / "
		+ "Внешнее исключение (System.Net.WebException): внешняя ошибка}" + Символы.ПС
		+ "по причине:" + Символы.ПС
		+ "промежуточная причина" + Символы.ПС + Символы.ПС
		+ "по причине:" + Символы.ПС
		+ "глубинная причина";
	Ошибка = СоздатьВнешнююОшибку(Описание);
	Распознаватель = СоздатьРаспознаватель(Ошибка);

	// Действие
	НайденаПромежуточнаяПричина = Распознаватель.СодержитТочноеСообщение(
		"промежуточная причина");
	НайденаГлубиннаяПричина = Распознаватель.СодержитТочноеСообщение(
		"глубинная причина");

	// Проверка
	Ожидаем.Что(НайденаПромежуточнаяПричина).ЭтоИстина();
	Ожидаем.Что(НайденаГлубиннаяПричина).ЭтоИстина();

КонецПроцедуры

#КонецОбласти
#Область СлужебныеПроцедурыИФункции

Функция СоздатьЦепочкуНативныхОшибок()

	Причина = СоздатьВнешнююОшибку(
		"External exception (System.Net.WebException): web exception"
	);
	Возврат СоздатьВнешнююОшибку(
		"External exception (System.Net.Sockets.SocketException): socket exception",
		Причина
	);

КонецФункции

Функция СоздатьРаспознаватель(Ошибка)

	Цепочка = Новый ЦепочкаКадровОшибки(Новый СнимокКадраОшибки(Ошибка));
	Возврат Новый РаспознавательОшибки(Цепочка.Кадры());

КонецФункции

Функция СоздатьВнешнююОшибку(Описание, Причина = Неопределено)

	Параметры = Новый Структура("Источник", "Тест");
	Если Причина = Неопределено Тогда
		Возврат Новый ИнформацияОбОшибке(Описание, Параметры);
	КонецЕсли;

	Возврат Новый ИнформацияОбОшибке(Описание, Параметры, Причина);

КонецФункции

Функция ПолучитьОшибкуЧтенияJSONДоОткрытия()

	Попытка
		Чтение = Новый ЧтениеJSON;
		Результат = Чтение.Прочитать();
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка чтения JSON не возникла";

КонецФункции

#КонецОбласти
