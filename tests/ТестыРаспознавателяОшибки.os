	// Действие
	НайденРусскийТип = Распознаватель.СодержитТип("System.Net.WebException");
	НайденАнглийскийТип = Распознаватель.СодержитТип("System.IO.IOException");

	// Проверка
	Ожидаем.Что(НайденРусскийТип).Равно(Истина);
	Ожидаем.Что(НайденАнглийскийТип).Равно(Истина);

