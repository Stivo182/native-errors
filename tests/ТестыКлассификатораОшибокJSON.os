&ОжидаемыйКодОшибки("ФайловаяСистемаРесурсНеНайден")
Функция ПолучитьОшибкуОткрытияОтсутствующегоФайлаИзвлеченияДанныхJSON() Экспорт

	Путь = ОбъединитьПути(
		ТекущийСценарий().Каталог,
		"fixtures/гарантированно-отсутствующий-файл-извлечения-данных-json.txt"
	);
	Ожидаем.Что(Новый Файл(Путь).Существует()).ЭтоЛожь();

	Попытка
		Извлечение = Новый ИзвлечениеДанныхJSON;
		Извлечение.ОткрытьФайл(Путь);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка открытия файла извлечения данных JSON не возникла";

КонецФункции

