#Использовать errors
#Использовать "../src"
#Использовать "./internal"

#Область ОбработчикиСобытий

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_КлассифицироватьАннотированныеИсточникиОшибок() Экспорт

	// Действие и Проверка
	МатрицаИсточниковОшибок.Проверить(ЭтотОбъект, 7);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&ОжидаемыйКодОшибки("JSONЧтениеНеОткрыто")
Функция ПолучитьОшибкуЧтенияJSONДоОткрытия() Экспорт

	Попытка
		Чтение = Новый ЧтениеJSON;
		Результат = Чтение.Прочитать();
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка чтения JSON до открытия не возникла";

КонецФункции

&ОжидаемыйКодОшибки("JSONЗаписьНеОткрыта")
Функция ПолучитьОшибкуЗаписиJSONДоОткрытия() Экспорт

	Попытка
		Запись = Новый ЗаписьJSON;
		Запись.ЗаписатьНачалоОбъекта();
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка записи JSON до открытия не возникла";

КонецФункции

&ОжидаемыйКодОшибки("JSONТекущееЗначениеНедоступно")
Функция ПолучитьОшибкуНедоступногоТекущегоЗначенияJSON() Экспорт

	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку("{}");
		Значение = Чтение.ТекущееЗначение;
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка недоступного текущего значения JSON не возникла";

КонецФункции

&ОжидаемыйКодОшибки("JSONНекорректныйСинтаксис")
Функция ПолучитьОшибкуНекорректногоJSON() Экспорт

	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку("{ ""field"": }");
		ПрочитатьJSON(Чтение);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка чтения JSON не возникла";

КонецФункции

&ОжидаемыйКодОшибки("JSONНеподдерживаемыйТипЗначения")
Функция ПолучитьОшибкуНеподдерживаемогоТипаJSON() Экспорт

	Попытка
		Запись = Новый ЗаписьJSON;
		Запись.УстановитьСтроку();
		Запись.ЗаписатьЗначение(Новый Массив);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка неподдерживаемого типа JSON не возникла";

КонецФункции

&ОжидаемыйКодОшибки("JSONФорматДатыНеПоддерживается")
Функция ПолучитьОшибкуНеподдерживаемогоФорматаДатыJSON() Экспорт

	Попытка
		Кавычка = Символ(34);
		ТекстJSON = Символ(123) + Кавычка + "date" + Кавычка + ":" + Кавычка
			+ "2020-01-01T00:00:00" + Кавычка + Символ(125);
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(ТекстJSON);
		ПрочитатьJSON(Чтение, Ложь, "date", ФорматДатыJSON.JavaScript);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка формата даты JSON не возникла";

КонецФункции

&ОжидаемыйКодОшибки("ПотокНеПоддерживаетЗапись")
Функция ПолучитьОшибкуПотокаБезПоддержкиЗаписи() Экспорт

	Попытка
		Поток = Новый ПотокВПамяти;
		ПотокТолькоДляЧтения = Поток.ПолучитьПотокТолькоДляЧтения();
		Запись = Новый ЗаписьJSON;
		Запись.ОткрытьПоток(ПотокТолькоДляЧтения);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка потока без поддержки записи не возникла";

КонецФункции

#КонецОбласти
