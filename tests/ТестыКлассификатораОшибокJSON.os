&ОжидаемыйКодОшибки("JSONФорматДатыНеПоддерживается")
Функция ПолучитьОшибкуНеподдерживаемогоФорматаДатыJSON() Экспорт

	Попытка
		Кавычка = Символ(34);
		ТекстJSON = Символ(123) + Кавычка + "date" + Кавычка + ":" + Кавычка
			+ "2020-01-01T00:00:00" + Кавычка + Символ(125);
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(ТекстJSON);
		ПрочитатьJSON(Чтение, Ложь, "date", ФорматДатыJSON.JavaScript);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка формата даты JSON не возникла";

КонецФункции

