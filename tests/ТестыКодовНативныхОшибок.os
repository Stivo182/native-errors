#Использовать asserts
#Использовать "../src"

#Область ОбработчикиСобытий

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_ПредоставлятьСтабильныеПредметныеКоды() Экспорт

	// Действие и Проверка
	Ожидаем.Что(КодыНативныхОшибок.ФайловаяСистемаРесурсНеНайден())
		.Равно("filesystem.not_found");
	Ожидаем.Что(КодыНативныхОшибок.ФайловаяСистемаРесурсУжеСуществует())
		.Равно("filesystem.already_exists");
	Ожидаем.Что(КодыНативныхОшибок.ФайловаяСистемаРесурсЗанят())
		.Равно("filesystem.resource_busy");
	Ожидаем.Что(КодыНативныхОшибок.ФайловаяСистемаДоступЗапрещен())
		.Равно("filesystem.permission_denied");
	Ожидаем.Что(КодыНативныхОшибок.СвойствоОбъектаНеНайдено())
		.Равно("object.property_not_found");
	Ожидаем.Что(КодыНативныхОшибок.СвойствоОбъектаНедоступноДляЗаписи())
		.Равно("object.property_not_writable");
	Ожидаем.Что(КодыНативныхОшибок.ТаблицаНекорректноеИмяКолонки())
		.Равно("table.invalid_column_name");
	Ожидаем.Что(КодыНативныхОшибок.ТаблицаКолонкаУжеСуществует())
		.Равно("table.column_already_exists");
	Ожидаем.Что(КодыНативныхОшибок.ТаблицаКонфликтРолиКолонки())
		.Равно("table.column_role_conflict");
	Ожидаем.Что(КодыНативныхОшибок.КоллекцияИндексВнеДиапазона())
		.Равно("collection.index_out_of_range");
	Ожидаем.Что(КодыНативныхОшибок.КоллекцияКлючНеНайден())
		.Равно("collection.key_not_found");
	Ожидаем.Что(КодыНативныхОшибок.КоллекцияИндексированноеЗначениеТолькоДляЧтения())
		.Равно("collection.indexed_value_read_only");
	Ожидаем.Что(КодыНативныхОшибок.КоллекцияНекорректныйАргументКонструктора())
		.Равно("collection.invalid_constructor_argument");
	Ожидаем.Что(КодыНативныхОшибок.JSONНекорректныйСинтаксис())
		.Равно("json.invalid_syntax");
	Ожидаем.Что(КодыНативныхОшибок.JSONЧтениеНеОткрыто())
		.Равно("json.reader_not_open");
	Ожидаем.Что(КодыНативныхОшибок.JSONЗаписьНеОткрыта())
		.Равно("json.writer_not_open");
	Ожидаем.Что(КодыНативныхОшибок.JSONТекущееЗначениеНедоступно())
		.Равно("json.value_unavailable");
	Ожидаем.Что(КодыНативныхОшибок.JSONНеподдерживаемыйТипЗначения())
		.Равно("json.unsupported_value_type");
	Ожидаем.Что(КодыНативныхОшибок.ТаблицаНекорректноеСмещение())
		.Равно("table.invalid_offset");
	Ожидаем.Что(КодыНативныхОшибок.ПреобразованиеТипаНеПоддерживается())
		.Равно("type.conversion_not_supported");
	Ожидаем.Что(КодыНативныхОшибок.КонструкторТипаНеНайден())
		.Равно("type.constructor_not_found");
	Ожидаем.Что(КодыНативныхОшибок.МетодОбъектаНеНайден())
		.Равно("object.method_not_found");
	Ожидаем.Что(КодыНативныхОшибок.ТребуетсяЗначениеОбъектногоТипа())
		.Равно("type.object_required");
	Ожидаем.Что(КодыНативныхОшибок.ВызовСлишкомМногоАргументов())
		.Равно("call.too_many_arguments");
	Ожидаем.Что(КодыНативныхОшибок.ВызовНедостаточноАргументов())
		.Равно("call.too_few_arguments");
	Ожидаем.Что(КодыНативныхОшибок.ПотокНеПоддерживаетЗапись())
		.Равно("stream.not_writable");
	Ожидаем.Что(КодыНативныхОшибок.XMLНекорректныйСинтаксис())
		.Равно("xml.invalid_syntax");
	Ожидаем.Что(КодыНативныхОшибок.XMLЗаписьНеОткрыта())
		.Равно("xml.writer_not_open");
	Ожидаем.Что(КодыНативныхОшибок.XMLНекорректноеСостояниеЗаписи())
		.Равно("xml.invalid_write_state");
	Ожидаем.Что(КодыНативныхОшибок.ДвоичныеДанныеНекорректныйHex())
		.Равно("binary.invalid_hex");
	Ожидаем.Что(КодыНативныхОшибок.ДвоичныеДанныеВыходЗаГраницыБуфера())
		.Равно("binary.buffer_out_of_bounds");
	Ожидаем.Что(КодыНативныхОшибок.ДвоичныеДанныеТолькоДляЧтения())
		.Равно("binary.read_only");
	Ожидаем.Что(КодыНативныхОшибок.ТекстНеизвестнаяКодировка())
		.Равно("text.unknown_encoding");
	Ожидаем.Что(КодыНативныхОшибок.ТекстНеОткрыт())
		.Равно("text.not_open");
	Ожидаем.Что(КодыНативныхОшибок.ПотокЗакрыт())
		.Равно("stream.closed");
	Ожидаем.Что(КодыНативныхОшибок.ПотокВыходЗаГраницыБуфера())
		.Равно("stream.buffer_out_of_bounds");
	Ожидаем.Что(КодыНативныхОшибок.HTTPТаймаутЗапроса())
		.Равно("http.request_timeout");
	Ожидаем.Что(КодыНативныхОшибок.HTTPНекорректныйМетод())
		.Равно("http.invalid_method");
	Ожидаем.Что(КодыНативныхОшибок.HTTPНекорректныйЗаголовок())
		.Равно("http.invalid_header");
	Ожидаем.Что(КодыНативныхОшибок.HTTPНекорректныйОтвет())
		.Равно("http.invalid_response");
	Ожидаем.Что(КодыНативныхОшибок.HTTPНеполныйОтвет())
		.Равно("http.incomplete_response");
	Ожидаем.Что(КодыНативныхОшибок.HTTPПользовательскоеTLSНеПоддерживается())
		.Равно("http.custom_tls_unsupported");
	Ожидаем.Что(КодыНативныхОшибок.ПроксиТребуетсяАутентификация())
		.Равно("proxy.authentication_required");
	Ожидаем.Что(КодыНативныхОшибок.ПроксиТуннельНеУстановлен())
		.Равно("proxy.tunnel_failed");
	Ожидаем.Что(КодыНативныхОшибок.СетьИмяУзлаНеРазрешено())
		.Равно("network.name_resolution_failed");
	Ожидаем.Что(КодыНативныхОшибок.СетьСоединениеОтклонено())
		.Равно("network.connection_refused");
	Ожидаем.Что(КодыНативныхОшибок.СетьСоединениеСброшено())
		.Равно("network.connection_reset");
	Ожидаем.Что(КодыНативныхОшибок.СетьОшибкаTLSHandshake())
		.Равно("network.tls_handshake_failed");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВозвращатьВсеПредметныеКоды() Экспорт

	// Действие
	Коды = КодыНативныхОшибок.Все();

	// Проверка
	Ожидаем.Что(Коды).ИмеетТип("ФиксированныйМассив");
	Ожидаем.Что(Коды.Количество()).Равно(52);
	Ожидаем.Что(Коды[0]).Равно(КодыНативныхОшибок.ФайловаяСистемаРесурсНеНайден());
	Ожидаем.Что(Коды[51]).Равно(КодыНативныхОшибок.СетьОшибкаTLSHandshake());

КонецПроцедуры

#КонецОбласти
