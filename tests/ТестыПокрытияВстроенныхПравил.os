#Использовать asserts
#Использовать "../src"
#Использовать "../src/internal"
#Использовать "./internal"

#Область Тесты

&Тест
Процедура ТестДолжен_ИметьНепустыеУникальныеИдентификаторыВстроенныхПравил() Экспорт

	// Подготовка
	Правила = Новый ПравилаНативныхОшибок().Все();
	Идентификаторы = Новый Соответствие;

	// Действие и Проверка
	Для Каждого Правило Из Правила Цикл
		Ожидаем.Что(ПустаяСтрока(Правило.Идентификатор)).Равно(Ложь);
		Ожидаем.Что(Идентификаторы.Получить(Правило.Идентификатор)).Равно(Неопределено);
		Идентификаторы.Вставить(Правило.Идентификатор, Истина);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИметьАннотированныйИсточникДляКаждогоВстроенногоПравила() Экспорт

	// Подготовка
	Правила = Новый ПравилаНативныхОшибок().Все();
	ПравилаПоИдентификаторам = Новый Соответствие;
	Для Каждого Правило Из Правила Цикл
		ПравилаПоИдентификаторам.Вставить(Правило.Идентификатор, Правило);
	КонецЦикла;
	ПокрытыеПравила = Новый Соответствие;
	ФайлыНаборов = НайтиФайлы(ТекущийСценарий().Каталог, "ТестыКлассификатора*.os");

	// Действие
	Для Каждого ФайлНабора Из ФайлыНаборов Цикл
		Контекст = ЗагрузитьСценарий(ФайлНабора.ПолноеИмя);
		Для Каждого Источник Из МатрицаИсточниковОшибок.ИсточникиПравил(Контекст) Цикл
			Правило = ПравилаПоИдентификаторам.Получить(Источник.Правило);
			Если Правило = Неопределено Тогда
				ВызватьИсключение СтрШаблон(
					"Источник %1.%2 ссылается на неизвестное правило %3",
					ФайлНабора.Имя,
					Источник.Метод,
					Источник.Правило
				);
			КонецЕсли;
			Ожидаем.Что(Источник.КодОшибки).Равно(Правило.КодОшибки);
			ПокрытыеПравила.Вставить(Источник.Правило, Истина);
		КонецЦикла;
	КонецЦикла;

	// Проверка
	НепокрытыеПравила = Новый Массив;
	Для Каждого Правило Из Правила Цикл
		Если ПокрытыеПравила.Получить(Правило.Идентификатор) <> Истина Тогда
			НепокрытыеПравила.Добавить(Правило.Идентификатор + " (" + Правило.КодОшибки + ")");
		КонецЕсли;
	КонецЦикла;
	Если НепокрытыеПравила.Количество() > 0 Тогда
		ВызватьИсключение "Нет аннотированных воспроизводимых источников у правил: "
			+ СтрСоединить(НепокрытыеПравила, ", ");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
