	Возврат Новый Структура(
		"Способ, НативныйТип, ШаблонСообщения, Префикс, Фрагмент, Окончание, КодОшибки, Сообщение",
		СпособыСопоставленияНативныхОшибок.Точное(),
		"",
		Сообщение,
		"",
		"",
		"",
		КодОшибки,
		"Пользовательская ошибка"
	);

