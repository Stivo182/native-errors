Функция ПолучитьОшибкуЗаписиВФиксированныйМассив() Экспорт

	Попытка
		ИсходныйМассив = Новый Массив;
		ИсходныйМассив.Добавить("Значение");
		Массив = Новый ФиксированныйМассив(ИсходныйМассив);
		Массив[0] = "Значение";
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка записи в фиксированный массив не возникла";

