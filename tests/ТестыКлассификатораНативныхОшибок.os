Процедура ТестДолжен_ВызватьПользовательскийКлассификаторДобавленныйДоПользовательскихПравил() Экспорт

	// Подготовка
	Классификатор = Новый КлассификаторНативныхОшибок;
	Классификатор.ДобавитьПользовательскийКлассификатор(Новый ТестовыйКлассификаторОшибок("test.custom"));
	Правила = Новый Массив;
	Правила.Добавить(СоздатьТочноеПользовательскоеПравило(
		"Источник данных JSON не открыт",
		"custom.json_source_not_open"
	));
	Классификатор.ДобавитьПравила(Правила);
	ИсходнаяОшибка = ПолучитьОшибкуССообщением("Источник данных JSON не открыт");

	// Действие
	Результат = Классификатор.Классифицировать(ИсходнаяОшибка);

	// Проверка
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Результат)).Равно("test.custom");

КонецПроцедуры

&Тест
Процедура ТестДолжен_КлассифицироватьПравилаИзНесколькихДобавлений() Экспорт

	// Подготовка
	Классификатор = Новый КлассификаторНативныхОшибок;
	ПервыеПравила = Новый Массив;
	ПервыеПравила.Добавить(СоздатьТочноеПользовательскоеПравило(
		"Первое пользовательское сообщение",
		"custom.first"
	));
	ВторыеПравила = Новый Массив;
	ВторыеПравила.Добавить(СоздатьТочноеПользовательскоеПравило(
		"Второе пользовательское сообщение",
		"custom.second"
	));
	Классификатор.ДобавитьПравила(ПервыеПравила);
	Классификатор.ДобавитьПравила(ВторыеПравила);

	// Действие
	ПервыйРезультат = Классификатор.Классифицировать(
		ПолучитьОшибкуССообщением("Первое пользовательское сообщение")
	);
	ВторойРезультат = Классификатор.Классифицировать(
		ПолучитьОшибкуССообщением("Второе пользовательское сообщение")
	);

	// Проверка
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(ПервыйРезультат)).Равно("custom.first");
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(ВторойРезультат)).Равно("custom.second");

КонецПроцедуры

&Тест
Процедура ТестДолжен_КопироватьПользовательскиеПравилаПриДобавлении() Экспорт

	// Подготовка
	Правило = СоздатьТочноеПользовательскоеПравило(
		"Пользовательское сообщение",
		"custom.original"
	);
	Классификатор = Новый КлассификаторНативныхОшибок;
	Правила = Новый Массив;
	Правила.Добавить(Правило);
	Классификатор.ДобавитьПравила(Правила);
	Правило.ШаблонСообщения = "Другое сообщение";
	Правило.КодОшибки = "custom.changed";
	ИсходнаяОшибка = ПолучитьОшибкуССообщением("Пользовательское сообщение");

	// Действие
	Результат = Классификатор.Классифицировать(ИсходнаяОшибка);

	// Проверка
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Результат)).Равно("custom.original");

КонецПроцедуры

&Тест
Процедура ТестДолжен_КлассифицироватьАнглийскиеСигнатурыОшибокОбъектов() Экспорт

	// Подготовка
	Сигнатуры = Новый Массив;
	Сигнатуры.Добавить(Новый Структура(
		"Сообщение, КодОшибки",
		"Index is out of range",
		КодыНативныхОшибок.ИндексКоллекцииВнеДиапазона()));
	Сигнатуры.Добавить(Новый Структура(
		"Сообщение, КодОшибки",
		"Wrong column name 'Name'",
		КодыНативныхОшибок.ТаблицаНекорректноеИмяКолонки()));
	Сигнатуры.Добавить(Новый Структура(
		"Сообщение, КодОшибки",
		"Column Name already exists",
		КодыНативныхОшибок.ТаблицаКолонкаУжеСуществует()));
	Сигнатуры.Добавить(Новый Структура(
		"Сообщение, КодОшибки",
		"Column Name is a summation column",
		КодыНативныхОшибок.ТаблицаКонфликтРолейКолонки()));
	Сигнатуры.Добавить(Новый Структура(
		"Сообщение, КодОшибки",
		"Object property is not found (Name)",
		КодыНативныхОшибок.СвойствоОбъектаНеНайдено()));
	Сигнатуры.Добавить(Новый Структура(
		"Сообщение, КодОшибки",
		"Property Name is not writable",
		КодыНативныхОшибок.СвойствоОбъектаНедоступноДляЗаписи()));
	Сигнатуры.Добавить(Новый Структура(
		"Сообщение, КодОшибки",
		"Property Name is not readable",
		КодыНативныхОшибок.СвойствоОбъектаНедоступноДляЧтения()));
	Сигнатуры.Добавить(Новый Структура(
		"Сообщение, КодОшибки",
		"Tasks are completed with errors",
		КодыНативныхОшибок.ФоновыеЗадачиЗавершилисьСОшибками()));
	// Действие и Проверка
	Для Каждого Сигнатура Из Сигнатуры Цикл
		ТестовыйПробросПодробногоПредставления.ПроверитьКодВариантами(
			ПолучитьОшибкуССообщением(Сигнатура.Сообщение),
			Сигнатура.КодОшибки);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьТочноеПользовательскоеПравило(Сообщение, КодОшибки)

	Возврат Новый Структура(
		"Способ, НативныйТип, ШаблонСообщения, Префикс, Фрагмент, Окончание, КодОшибки, Сообщение",
		СпособыСопоставленияНативныхОшибок.Точное(),
		"",
		Сообщение,
		"",
		"",
		"",
		КодОшибки,
		"Пользовательская ошибка"
	);

КонецФункции

Функция ПолучитьОшибкуНекорректногоJSON()

	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку("{ ""field"": }");
		ПрочитатьJSON(Чтение);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка чтения JSON не возникла";

КонецФункции

Функция ПолучитьОшибкуНекорректногоXML()

	Попытка
		Чтение = Новый ЧтениеXML;
		Чтение.УстановитьСтроку("<root><child></root>");
		Пока Чтение.Прочитать() Цикл
		КонецЦикла;
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка чтения XML не возникла";

КонецФункции

