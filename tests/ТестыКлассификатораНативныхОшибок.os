&Тест
Процедура ТестДолжен_СохранятьПриоритетПравилПриТочномСовпаденииВПричине() Экспорт

	// Подготовка
	Параметры = Новый Структура("Источник", "Тест");
	Причина = Новый ИнформацияОбОшибке(
		"Значение не является значением объектного типа",
		Параметры
	);
	ИсходнаяОшибка = Новый ИнформацияОбОшибке(
		"Метод объекта не обнаружен (НетМетода)",
		Параметры,
		Причина
	);
	Классификатор = Новый КлассификаторНативныхОшибок;

	// Действие
	Результат = Классификатор.Классифицировать(ИсходнаяОшибка);

	// Проверка
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Результат))
		.Равно(КодыНативныхОшибок.МетодОбъектаНеНайден());

