#Область Тесты

&Тест
Процедура ТестДолжен_ДелегироватьКлассификациюJSON() Экспорт

	// Подготовка
	ИсходнаяОшибка = ПолучитьОшибкуНекорректногоJSON();

	// Действие
	Классификатор = Новый КлассификаторНативныхОшибок;
	НормализованнаяОшибка = Классификатор.Классифицировать(ИсходнаяОшибка);

	// Проверка
	Ожидаем.Что(НормализованнаяОшибка).ИмеетТип("ИнформацияОбОшибке");
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(НормализованнаяОшибка))
		.Равно(КодыНативныхОшибок.JSONНекорректныйСинтаксис());

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьУжеСтруктурированнуюОшибкуБезОбертывания() Экспорт

	// Подготовка
	ИсходнаяОшибка = ФабрикаОшибок.Создать("test.failure", "Тестовая ошибка");

	// Действие
	Классификатор = Новый КлассификаторНативныхОшибок;
	Результат = Классификатор.Классифицировать(ИсходнаяОшибка);

	// Проверка
	Ожидаем.Что(Результат).Идентично(ИсходнаяОшибка);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьНеопределеноДляНеизвестнойОшибки() Экспорт

	// Подготовка
	Попытка
		РезультатПреобразования = Число("не число");
	Исключение
		ИсходнаяОшибка = ИнформацияОбОшибке();
	КонецПопытки;

	// Действие
	Классификатор = Новый КлассификаторНативныхОшибок;
	Результат = Классификатор.Классифицировать(ИсходнаяОшибка);

	// Проверка
	Ожидаем.Что(Результат).ЭтоНеопределено();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВызватьПользовательскийКлассификаторДляНеизвестнойОшибки() Экспорт

	// Подготовка
	Классификатор = Новый КлассификаторНативныхОшибок;
	Классификатор.ДобавитьКлассификатор(Новый ТестовыйКлассификаторОшибок("test.custom"));
	ИсходнаяОшибка = ПолучитьНеизвестнуюОшибку();

	// Действие
	Результат = Классификатор.Классифицировать(ИсходнаяОшибка);

	// Проверка
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Результат)).Равно("test.custom");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПродолжитьПользовательскуюКлассификациюПослеНеопределено() Экспорт

	// Подготовка
	Классификатор = Новый КлассификаторНативныхОшибок;
	Классификатор.ДобавитьКлассификатор(Новый ТестовыйКлассификаторОшибок);
	Классификатор.ДобавитьКлассификатор(Новый ТестовыйКлассификаторОшибок("test.next"));
	ИсходнаяОшибка = ПолучитьНеизвестнуюОшибку();

	// Действие
	Результат = Классификатор.Классифицировать(ИсходнаяОшибка);

	// Проверка
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Результат)).Равно("test.next");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПродолжитьВстроеннуюКлассификациюПослеНеопределено() Экспорт

	// Подготовка
	Классификатор = Новый КлассификаторНативныхОшибок;
