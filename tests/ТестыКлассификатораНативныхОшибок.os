&Тест
Процедура ТестДолжен_ДелегироватьКлассификациюJSON() Экспорт

	// Подготовка
	ИсходнаяОшибка = ПолучитьОшибкуНекорректногоJSON();

	// Действие и Проверка
	ТестовыйПробросПодробногоПредставления.ПроверитьКодВариантами(
		ИсходнаяОшибка,
		КодыНативныхОшибок.JSONНекорректныйСинтаксис());

КонецПроцедуры

&ПараметризованныйТест
&ИсточникВыражение("() -> ПараметрыИсточниковОшибок()")
Процедура ТестДолжен_КлассифицироватьИсточникОшибки(ИдентификаторПравила, ИмяИсточника) Экспорт

	МатрицаИсточниковОшибок.ПроверитьИсточник(ЭтотОбъект, ИмяИсточника);

КонецПроцедуры

Функция ПараметрыИсточниковОшибок() Экспорт

	Возврат МатрицаИсточниковОшибок.ПараметрыИсточников(ЭтотОбъект, 52);

КонецФункции

&Тест
Процедура ТестДолжен_ИметьСообщениеПравилаДляКаждогоПубличногоКода() Экспорт

	// Подготовка
	СообщенияКодов = Новый Соответствие;
	Для Каждого Правило Из Новый ПравилаНативныхОшибок().Все() Цикл
		Если СообщенияКодов.Получить(Правило.КодОшибки) = Неопределено Тогда
			СообщенияКодов.Вставить(Правило.КодОшибки, Правило.Сообщение);
		КонецЕсли;
	КонецЦикла;

	// Действие и Проверка
	Для Каждого Код Из КодыНативныхОшибок.Все() Цикл
		Сообщение = СообщенияКодов.Получить(Код);
		Если ПустаяСтрока(Сообщение) Тогда
			ВызватьИсключение СтрШаблон("Для кода %1 не найдено сообщение правила", Код);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЛокализоватьСообщениеОшибкиНедопустимогоТипаАргумента() Экспорт

	// Подготовка
	КоличествоПравил = 0;

	// Действие
	Для Каждого Правило Из Новый ПравилаНативныхОшибок().Все() Цикл
		Если Правило.КодОшибки = КодыНативныхОшибок.НедопустимыйТипАргумента() Тогда
			// Проверка
			Ожидаем.Что(Правило.Сообщение).Равно(
				"ru = 'Недопустимый тип аргумента'; en = 'Invalid argument type'"
			);
			КоличествоПравил = КоличествоПравил + 1;
		КонецЕсли;
	КонецЦикла;

	// Проверка
	Ожидаем.Что(КоличествоПравил).Равно(4);

КонецПроцедуры

