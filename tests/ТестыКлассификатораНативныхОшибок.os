#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьОшибкуНекорректногоJSON()

	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку("{ ""field"": }");
		ПрочитатьJSON(Чтение);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка чтения JSON не возникла";

КонецФункции

Функция ПолучитьНеизвестнуюОшибку()

	Попытка
		РезультатПреобразования = Число("не число");
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая неизвестная ошибка не возникла";

КонецФункции

#КонецОбласти
