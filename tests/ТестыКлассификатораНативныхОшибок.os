	Классификатор.ДобавитьПользовательскийКлассификатор(Новый ТестовыйКлассификаторОшибок("test.custom"));
	Правила = Новый Массив;
	Правила.Добавить(СоздатьТочноеПользовательскоеПравило(
		"Источник данных JSON не открыт",
		"custom.json_source_not_open"
	));
	Классификатор.ДобавитьПравила(Правила);
	ИсходнаяОшибка = ПолучитьОшибкуССообщением("Источник данных JSON не открыт");

	// Действие
	Результат = Классификатор.Классифицировать(ИсходнаяОшибка);

	// Проверка
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Результат)).Равно("test.custom");

КонецПроцедуры

&Тест
Процедура ТестДолжен_КлассифицироватьПравилаИзНесколькихДобавлений() Экспорт

	// Подготовка
	Классификатор = Новый КлассификаторНативныхОшибок;
	ПервыеПравила = Новый Массив;
	ПервыеПравила.Добавить(СоздатьТочноеПользовательскоеПравило(
		"Первое пользовательское сообщение",
		"custom.first"
	));
	ВторыеПравила = Новый Массив;
	ВторыеПравила.Добавить(СоздатьТочноеПользовательскоеПравило(
		"Второе пользовательское сообщение",
		"custom.second"
	));
	Классификатор.ДобавитьПравила(ПервыеПравила);
	Классификатор.ДобавитьПравила(ВторыеПравила);

	// Действие
	ПервыйРезультат = Классификатор.Классифицировать(
		ПолучитьОшибкуССообщением("Первое пользовательское сообщение")
	);
	ВторойРезультат = Классификатор.Классифицировать(
		ПолучитьОшибкуССообщением("Второе пользовательское сообщение")
	);

	// Проверка
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(ПервыйРезультат)).Равно("custom.first");
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(ВторойРезультат)).Равно("custom.second");

КонецПроцедуры

