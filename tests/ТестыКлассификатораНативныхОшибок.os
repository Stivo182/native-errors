	);
	Классификатор = Новый КлассификаторНативныхОшибок;
	Правила = Новый Массив;
	Правила.Добавить(Правило);
	Классификатор.ДобавитьПравила(Правила);
	Правило.ШаблонСообщения = "Другое сообщение";
	Правило.КодОшибки = "custom.changed";
	ИсходнаяОшибка = ПолучитьОшибкуССообщением("Пользовательское сообщение");

	// Действие
	Результат = Классификатор.Классифицировать(ИсходнаяОшибка);

	// Проверка
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Результат)).Равно("custom.original");

КонецПроцедуры

&Тест
Процедура ТестДолжен_КлассифицироватьАнглийскиеСигнатурыОшибокОбъектов() Экспорт

	// Подготовка
	Сигнатуры = Новый Массив;
	Сигнатуры.Добавить(Новый Структура(
		"Сообщение, КодОшибки",
		"Index is out of range",
		КодыНативныхОшибок.ИндексКоллекцииВнеДиапазона()));
	Сигнатуры.Добавить(Новый Структура(
		"Сообщение, КодОшибки",
		"Wrong column name 'Name'",
		КодыНативныхОшибок.ТаблицаНекорректноеИмяКолонки()));
	Сигнатуры.Добавить(Новый Структура(
		"Сообщение, КодОшибки",
		"Column Name already exists",
		КодыНативныхОшибок.ТаблицаКолонкаУжеСуществует()));
	Сигнатуры.Добавить(Новый Структура(
		"Сообщение, КодОшибки",
		"Column Name is a summation column",
		КодыНативныхОшибок.ТаблицаКонфликтРолейКолонки()));
	Сигнатуры.Добавить(Новый Структура(
		"Сообщение, КодОшибки",
		"Object property is not found (Name)",
		КодыНативныхОшибок.СвойствоОбъектаНеНайдено()));
	Сигнатуры.Добавить(Новый Структура(
		"Сообщение, КодОшибки",
		"Property Name is not writable",
		КодыНативныхОшибок.СвойствоОбъектаНедоступноДляЗаписи()));
	Сигнатуры.Добавить(Новый Структура(
		"Сообщение, КодОшибки",
		"Property Name is not readable",
		КодыНативныхОшибок.СвойствоОбъектаНедоступноДляЧтения()));
	Сигнатуры.Добавить(Новый Структура(
		"Сообщение, КодОшибки",
		"Tasks are completed with errors",
		КодыНативныхОшибок.ФоновыеЗадачиЗавершилисьСОшибками()));
	// Действие и Проверка
	Для Каждого Сигнатура Из Сигнатуры Цикл
		ТестовыйПробросПодробногоПредставления.ПроверитьКодВариантами(
			ПолучитьОшибкуССообщением(Сигнатура.Сообщение),
			Сигнатура.КодОшибки);
	КонецЦикла;

КонецПроцедуры

