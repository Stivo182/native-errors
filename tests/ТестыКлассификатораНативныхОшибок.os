&ОжидаемыйКодОшибки("КоллекцияИндексированноеЗначениеТолькоДляЧтения")
Функция ПолучитьОшибкуЗаписиВФиксированноеСоответствие() Экспорт

	Попытка
		ИсходноеСоответствие = Новый Соответствие;
		ИсходноеСоответствие.Вставить("Ключ", "Значение");
		Соответствие = Новый ФиксированноеСоответствие(ИсходноеСоответствие);
		Соответствие["Ключ"] = "Значение";
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка записи в фиксированное соответствие не возникла";

КонецФункции

&ОжидаемыйКодОшибки("КоллекцияИндексированноеЗначениеТолькоДляЧтения")
Функция ПолучитьОшибкуЗаписиВЭлементСпискаЗначений() Экспорт

	Попытка
		Список = Новый СписокЗначений;
		Список.Добавить("Первое значение");
		Список[0] = "Второе значение";
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка записи в элемент списка значений не возникла";

КонецФункции

