Процедура ТестДолжен_КлассифицироватьОшибкуDNSПроксиКакСетевую() Экспорт
	
	// Действие и Проверка
	ИсходнаяОшибка = ПолучитьОшибкуDNSПрокси();
	ПроверитьКодСНеопределяемойОбёрткой(
		ИсходнаяОшибка, КодыНативныхОшибок.СетьИмяУзлаНеРазрешено());

КонецПроцедуры

&Тест
Процедура ТестДолжен_КлассифицироватьТаймаутПроксиКакHTTPТаймаут() Экспорт
	
	// Действие и Проверка
	ИсходнаяОшибка = ВыполнитьЗапросЧерезTCPПрокси(
		ПолучитьСвободныйПорт(),
		"",
		Истина,
		"http",
		1,
		2000
	);
	ПроверитьКод(ИсходнаяОшибка, КодыНативныхОшибок.HTTPТаймаутЗапроса());

КонецПроцедуры

&Тест
Процедура ТестДолжен_КлассифицироватьТаймаутHTTPОперации() Экспорт

	// Подготовка
	_HttpBin = Новый HttpBin("127.0.0.1", ПолучитьСвободныйПорт());
	_HttpBin.Запустить();

	ИсходнаяОшибка = ПолучитьОшибкуТаймаута(_HttpBin.Порт());

	// Действие
	НормализованнаяОшибка = Новый КлассификаторНативныхОшибок.Классифицировать(ИсходнаяОшибка);

	// Проверка
	Ожидаем.Что(НормализованнаяОшибка).ИмеетТип("ИнформацияОбОшибке");
	Снимок = Новый СнимокКадраОшибки(НормализованнаяОшибка);
	Ожидаем.Что(Снимок.КодОшибки()).Равно(КодыНативныхОшибок.HTTPТаймаутЗапроса());
	Ожидаем.Что(НормализованнаяОшибка.Причина).Идентично(ИсходнаяОшибка);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьОшибкуТаймаута(Порт)

	Попытка
		Соединение = Новый HTTPСоединение("127.0.0.1", Порт,,,, 1);
		Соединение.Получить(Новый HTTPЗапрос("/delay/3"));
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемый таймаут HTTP не возник";

КонецФункции

Функция ПолучитьСетевуюОшибку(Сервер, Порт)
	
	Попытка
		Прокси = Новый ИнтернетПрокси(Ложь);
		Соединение = Новый HTTPСоединение(Сервер, Порт,,, Прокси, 5);
		HTTPОтвет = Соединение.Получить(Новый HTTPЗапрос("/"));
		HTTPОтвет.ПолучитьТелоКакДвоичныеДанные();
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая сетевая ошибка не возникла";

КонецФункции

