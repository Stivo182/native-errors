&Тест
Процедура ТестДолжен_ВозвращатьHTTPСтатусыКакОтвет() Экспорт
	
	// Подготовка
	_HttpBin = Новый HttpBin("127.0.0.1", ПолучитьСвободныйПорт());
	_HttpBin.Запустить();
	
	Прокси = Новый ИнтернетПрокси(Ложь);
	Соединение = Новый HTTPСоединение("http://127.0.0.1", _HttpBin.Порт(),,, Прокси, 3);
	
	Коды = Новый Массив;
	Коды.Добавить(401);
	Коды.Добавить(404);
	Коды.Добавить(500);

	// Действие и Проверка
	Для Каждого Код Из Коды Цикл
		Ответ = Соединение.Получить(Новый HTTPЗапрос("/status/" + Код));
		Ожидаем.Что(Ответ.КодСостояния).Равно(Код);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВозвращатьRedirectКакОтвет() Экспорт
	
	// Подготовка
	_HttpBin = Новый HttpBin("127.0.0.1", ПолучитьСвободныйПорт());
	_HttpBin.Запустить();
	
	Прокси = Новый ИнтернетПрокси(Ложь);
	Соединение = Новый HTTPСоединение("http://127.0.0.1", _HttpBin.Порт(),,, Прокси, 3);
	
	// Действие и Проверка
	Ответ = Соединение.Получить(Новый HTTPЗапрос("/redirect/1"));
	Ожидаем.Что(Ответ.КодСостояния).Равно(200);
	
	Соединение.РазрешитьАвтоматическоеПеренаправление = Ложь;
	Ответ = Соединение.Получить(Новый HTTPЗапрос("/redirect/1"));
	Ожидаем.Что(Ответ.КодСостояния).Равно(302);
	
	Соединение.РазрешитьАвтоматическоеПеренаправление = Истина;
	Ответ = Соединение.Получить(Новый HTTPЗапрос("/redirect/100"));
	Ожидаем.Что(Ответ.КодСостояния).Равно(302);

КонецПроцедуры

