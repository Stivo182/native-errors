Процедура ТестДолжен_ВозвращатьProxy407КакОтвет() Экспорт
	
	// Подготовка
	ОтветПрокси = "HTTP/1.1 407 Proxy Authentication Required" + CRLF()
		+ "Content-Length: 0" + CRLF() + "Connection: close" + CRLF() + CRLF();
	
		// Действие и Проверка
	Результат = ВыполнитьЗапросЧерезTCPПрокси(ПолучитьСвободныйПорт(), ОтветПрокси);
	Ожидаем.Что(Результат).ИмеетТип("HTTPОтвет");
	Ожидаем.Что(Результат.КодСостояния).Равно(407);

