Функция ВыполнитьЗапросЧерезTCPПрокси(
	Порт,
	ОтветПрокси,
	ПрочитатьЗапросПолностью = Истина,
	Схема = "http",
	Таймаут = 3,
	ЗадержкаПередОтветом = 0
)
	ЗапуститьTCPСервер(Порт, ОтветПрокси, ПрочитатьЗапросПолностью, ЗадержкаПередОтветом);
	
	Попытка
		Прокси = Новый ИнтернетПрокси(Ложь);
		Прокси.Установить(Схема, "http://127.0.0.1", Порт);
		Соединение = Новый HTTPСоединение(Схема + "://example.com", 0,,, Прокси, Таймаут);
		Возврат Соединение.Получить(Новый HTTPЗапрос("/"));
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

КонецФункции

Функция ПолучитьОшибкуОтправкиТела(Порт)

	ЗапуститьTCPСервер(Порт, "", Ложь);

	Попытка
		Буфер = Новый БуферДвоичныхДанных(1024 * 1024);
		ДвоичныеДанные = ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Буфер);
		Запрос = Новый HTTPЗапрос("/");
		Запрос.УстановитьТелоИзДвоичныхДанных(ДвоичныеДанные);
		Прокси = Новый ИнтернетПрокси(Ложь);
		Соединение = Новый HTTPСоединение("http://127.0.0.1", Порт,,, Прокси, 3);
		Соединение.ОтправитьДляОбработки(Запрос);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка отправки тела HTTP не возникла";

КонецФункции

Функция ПолучитьОшибкуПользовательскогоTLS()

	Попытка
		Соединение = Новый HTTPСоединение("https://127.0.0.1", 443,,,, 3, Истина);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка пользовательского TLS не возникла";

КонецФункции

Функция ПолучитьОшибкуПараметраHTTP(Сценарий)

	Попытка
		Если Сценарий = "Сервер" Тогда
			Соединение = Новый HTTPСоединение("http://[");
		ИначеЕсли Сценарий = "Схема" Тогда
			Соединение = Новый HTTPСоединение("ftp://127.0.0.1");
		ИначеЕсли Сценарий = "Ресурс" Тогда
			Соединение = Новый HTTPСоединение(
				"http://127.0.0.1",
				ПолучитьСвободныйПорт(),
				,,,
				1
			);
			Соединение.Получить(Новый HTTPЗапрос("http://["));
		ИначеЕсли Сценарий = "Таймаут" Тогда
			Соединение = Новый HTTPСоединение(
				"http://127.0.0.1",
				ПолучитьСвободныйПорт(),
				,,,
				-1
			);
			Соединение.Получить(Новый HTTPЗапрос("/"));
		КонецЕсли;
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка параметра HTTP не возникла";

КонецФункции

Функция ПолучитьСвободныйПорт()

	ДиапазонПортов = 40000;
	НачальныйПорт = 20000;

	Для НомерПопытки = 1 По ДиапазонПортов Цикл
		Порт = НачальныйПорт
			+ ((ТекущийПроцесс().Идентификатор + _НомерСледующейПроверкиПорта) % ДиапазонПортов);
		_НомерСледующейПроверкиПорта = _НомерСледующейПроверкиПорта + 1;

		Попытка
			Сервер = Новый TCPСервер(Порт);
			Сервер.Запустить();
			Сервер.Остановить();
			Возврат Порт;
		Исключение
		КонецПопытки;
	КонецЦикла;

	ВызватьИсключение "Не удалось найти свободный порт для HTTP-фикстуры";

КонецФункции

Функция ПолучитьОшибкуTCPСервера(
	Порт,
	Ответ,
	Схема = "http",
	ПрочитатьЗапросПолностью = Истина,
	ПрочитатьКакСтроку = Ложь
)
	ЗапуститьTCPСервер(Порт, Ответ, ПрочитатьЗапросПолностью);

	Попытка
		Прокси = Новый ИнтернетПрокси(Ложь);
		Соединение = Новый HTTPСоединение(Схема + "://127.0.0.1", Порт,,, Прокси, 3);
		HTTPОтвет = Соединение.Получить(Новый HTTPЗапрос("/"));
		
		Если ПрочитатьКакСтроку Тогда
			HTTPОтвет.ПолучитьТелоКакСтроку();
		Иначе
			HTTPОтвет.ПолучитьТелоКакДвоичныеДанные();
		КонецЕсли;
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка TCP fixture не возникла";

КонецФункции

Процедура ЗапуститьTCPСервер(Порт, Ответ, ПрочитатьЗапросПолностью, ЗадержкаПередОтветом = 0)
	
	_TCPСерверГотов = Ложь;
	_МенеджерФоновыхЗаданий = Новый МенеджерФоновыхЗаданий;
	
	Параметры = Новый Массив;
	Параметры.Добавить(Порт);
	Параметры.Добавить(Ответ);
	Параметры.Добавить(ПрочитатьЗапросПолностью);
	Параметры.Добавить(ЗадержкаПередОтветом);
	
	_МенеджерФоновыхЗаданий.Выполнить(ЭтотОбъект, "ОбслужитьTCPЗапрос", Параметры);
	ДождатьсяTCPСервера();

КонецПроцедуры

Процедура ДождатьсяTCPСервера()
	
	Таймаут = ТекущаяУниверсальнаяДатаВМиллисекундах() + 3000;

	Пока Не _TCPСерверГотов Цикл
		Если ТекущаяУниверсальнаяДатаВМиллисекундах() > Таймаут Тогда
			ВызватьИсключение "TCP fixture не запустился";
		КонецЕсли;
		Приостановить(10);
	КонецЦикла;

КонецПроцедуры

Процедура ОбслужитьTCPЗапрос(Порт, Ответ, ПрочитатьЗапросПолностью, ЗадержкаПередОтветом) Экспорт
	
	Сервер = Новый TCPСервер(Порт);
	Сервер.Запустить();
	
	_TCPСерверГотов = Истина;
	
	Соединение = Сервер.ОжидатьСоединения();
	Соединение.ПрочитатьДвоичныеДанные(1);
	
	Если ПрочитатьЗапросПолностью Тогда
		Приостановить(50);
		Соединение.ПрочитатьДвоичныеДанные();
	КонецЕсли;
	
	Если ЗадержкаПередОтветом > 0 Тогда
		Приостановить(ЗадержкаПередОтветом);
	КонецЕсли;

	Соединение.ОтправитьСтроку(Ответ, "utf-8");
	Соединение.Закрыть();
	Сервер.Остановить();

КонецПроцедуры

Функция CRLF()
	Возврат Символ(13) + Символ(10);
КонецФункции

Функция ЗаголовокChunked()
	Возврат "HTTP/1.1 200 OK" + CRLF()
		+ "Transfer-Encoding: chunked" + CRLF()
		+ "Connection: close" + CRLF() + CRLF();
КонецФункции

Процедура ПроверитьКод(ИсходнаяОшибка, ОжидаемыйКод)

	_Проброс.ПроверитьКодВариантами(ИсходнаяОшибка, ОжидаемыйКод);

КонецПроцедуры

Процедура ПроверитьКодСНеопределяемойОбёрткой(ИсходнаяОшибка, ОжидаемыйКод)

	_Проброс.ПроверитьКодСНеопределяемойОбёрткой(ИсходнаяОшибка, ОжидаемыйКод);

КонецПроцедуры

Процедура ПроверитьНеКлассифицирована(ИсходнаяОшибка)

	_Проброс.ПроверитьНеклассифицированностьВариантами(ИсходнаяОшибка);

КонецПроцедуры

