&ОжидаемыйКодОшибки("HTTPМетодНеРазрешен")
&ОжидаемоеПравилоОшибки("http.method_not_allowed")
Функция ПолучитьОшибкуЗапрещенногоHTTPМетода() Экспорт

	_HttpBin = Новый HttpBin("127.0.0.1", ТестовыеСетевыеФикстуры.ПолучитьСвободныйПорт());
	_HttpBin.Запустить();

	Приемник = ПолучитьИмяВременногоФайла();

	Ошибка = Неопределено;
	Попытка
		КопироватьФайл(_HttpBin.URL("/status/405"), Приемник);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	УдалитьФайлы(Приемник);

	_HttpBin.Остановить();
	_HttpBin = Неопределено;

	Если Ошибка <> Неопределено Тогда
		Возврат Ошибка;
	КонецЕсли;

	ВызватьИсключение "Ожидаемая ошибка запрещенного HTTP-метода не возникла";

КонецФункции

