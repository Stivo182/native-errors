КонецФункции

&Тест
Процедура ТестНеДолжен_КлассифицироватьОбщуюОшибкуПоврежденногоGzip() Экспорт

	// Подготовка
	Ответ = "HTTP/1.1 200 OK" + CRLF()
		+ "Content-Encoding: gzip" + CRLF()
		+ "Content-Length: 3" + CRLF()
		+ "Connection: close" + CRLF() + CRLF() + "abc";

	// Действие и Проверка
	ИсходнаяОшибка = ПолучитьОшибкуTCPСервера(ТестовыеСетевыеФикстуры.ПолучитьСвободныйПорт(), Ответ);
	ПроверитьНеКлассифицирована(ИсходнаяОшибка);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВозвращатьHTTPСтатусыКакОтвет() Экспорт

	// Подготовка
	_HttpBin = Новый HttpBin("127.0.0.1", ТестовыеСетевыеФикстуры.ПолучитьСвободныйПорт());
	_HttpBin.Запустить();

	Прокси = Новый ИнтернетПрокси(Ложь);
	Соединение = Новый HTTPСоединение("http://127.0.0.1", _HttpBin.Порт(),,, Прокси, 3);

	Коды = Новый Массив;
	Коды.Добавить(401);
	Коды.Добавить(404);
	Коды.Добавить(500);

	// Действие и Проверка
	Для Каждого Код Из Коды Цикл
		Ответ = Соединение.Получить(Новый HTTPЗапрос("/status/" + Код));
		Ожидаем.Что(Ответ.КодСостояния).Равно(Код);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВозвращатьRedirectКакОтвет() Экспорт

	// Подготовка
	_HttpBin = Новый HttpBin("127.0.0.1", ТестовыеСетевыеФикстуры.ПолучитьСвободныйПорт());
	_HttpBin.Запустить();

	Прокси = Новый ИнтернетПрокси(Ложь);
	Соединение = Новый HTTPСоединение("http://127.0.0.1", _HttpBin.Порт(),,, Прокси, 3);

	// Действие и Проверка
	Ответ = Соединение.Получить(Новый HTTPЗапрос("/redirect/1"));
	Ожидаем.Что(Ответ.КодСостояния).Равно(200);

	Соединение.РазрешитьАвтоматическоеПеренаправление = Ложь;
	Ответ = Соединение.Получить(Новый HTTPЗапрос("/redirect/1"));
	Ожидаем.Что(Ответ.КодСостояния).Равно(302);

	Соединение.РазрешитьАвтоматическоеПеренаправление = Истина;
	Ответ = Соединение.Получить(Новый HTTPЗапрос("/redirect/100"));
	Ожидаем.Что(Ответ.КодСостояния).Равно(302);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВозвращатьProxy407КакОтвет() Экспорт

	// Подготовка
	ОтветПрокси = "HTTP/1.1 407 Proxy Authentication Required" + CRLF()
		+ "Content-Length: 0" + CRLF() + "Connection: close" + CRLF() + CRLF();

	// Действие и Проверка
	Результат = ВыполнитьЗапросЧерезTCPПрокси(ТестовыеСетевыеФикстуры.ПолучитьСвободныйПорт(), ОтветПрокси);
	Ожидаем.Что(Результат).ИмеетТип("HTTPОтвет");
	Ожидаем.Что(Результат.КодСостояния).Равно(407);

КонецПроцедуры

