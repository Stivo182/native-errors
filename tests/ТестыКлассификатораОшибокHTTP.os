Функция ПолучитьОшибкуDNSПрокси()

	Попытка
		Прокси = Новый ИнтернетПрокси(Ложь);
		Прокси.Установить("http", "http://nonexistent.invalid", ПолучитьСвободныйПорт());
		Соединение = Новый HTTPСоединение("http://example.com", 0,,, Прокси, 3);
		Соединение.Получить(Новый HTTPЗапрос("/"));
	Исключение
		Возврат ИнформацияОбОшибке();
