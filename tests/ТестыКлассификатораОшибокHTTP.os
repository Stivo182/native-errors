&ОжидаемыйКодОшибки("HTTPТаймаутОперации")
Функция ПолучитьОшибкуТаймаутаHTTPОперации() Экспорт

	_HttpBin = Новый HttpBin("127.0.0.1", ПолучитьСвободныйПорт());
	_HttpBin.Запустить();
	ИсходнаяОшибка = ПолучитьОшибкуТаймаута(_HttpBin.Порт());
	_HttpBin.Остановить();
	_HttpBin = Неопределено;

	Возврат ИсходнаяОшибка;

КонецФункции

Функция ПолучитьОшибкуТаймаута(Порт)

	Попытка
		Соединение = Новый HTTPСоединение("127.0.0.1", Порт,,,, 1);
		Соединение.Получить(Новый HTTPЗапрос("/delay/3"));
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемый таймаут HTTP не возник";

КонецФункции

Функция ПолучитьСетевуюОшибку(Сервер, Порт)
	
	Попытка
		Прокси = Новый ИнтернетПрокси(Ложь);
		Соединение = Новый HTTPСоединение(Сервер, Порт,,, Прокси, 5);
		HTTPОтвет = Соединение.Получить(Новый HTTPЗапрос("/"));
		HTTPОтвет.ПолучитьТелоКакДвоичныеДанные();
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая сетевая ошибка не возникла";

КонецФункции

Функция ПолучитьОшибкуМетода()

	Попытка
		Соединение = Новый HTTPСоединение("127.0.0.1", ПолучитьСвободныйПорт(),,,, 1);
		Соединение.ВызватьHTTPМетод("ПЛОХОЙ МЕТОД", Новый HTTPЗапрос("/"));
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка HTTP-метода не возникла";

КонецФункции

Функция ПолучитьОшибкуЗаголовка(ИмяЗаголовка, Значение = "некорректно")

	Попытка
		Запрос = Новый HTTPЗапрос("/");
		Запрос.Заголовки.Вставить(ИмяЗаголовка, Значение);
		Соединение = Новый HTTPСоединение("127.0.0.1", ПолучитьСвободныйПорт(),,,, 1);
		Соединение.Получить(Запрос);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

