#Использовать asserts
#Использовать errors
#Использовать httpbin
#Использовать "../src"
#Использовать "./internal"

Перем _HttpBin; // HttpBin, Неопределено
Перем _МенеджерФоновыхЗаданий; // МенеджерФоновыхЗаданий, Неопределено
Перем _TCPСерверГотов; // Булево, Неопределено
Перем _Проброс; // ТестовыйПробросПодробногоПредставления
Перем _НомерСледующейПроверкиПорта; // Число

#Область ОбработчикиСобытий

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПередВсеми() Экспорт

	_Проброс = Новый ТестовыйПробросПодробногоПредставления;
	_НомерСледующейПроверкиПорта = 0;

КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждого() Экспорт

	Если _HttpBin <> Неопределено Тогда
		_HttpBin.Остановить();
		_HttpBin = Неопределено;
	КонецЕсли;

	Если _МенеджерФоновыхЗаданий <> Неопределено Тогда
		_МенеджерФоновыхЗаданий.Очистить();
		_МенеджерФоновыхЗаданий = Неопределено;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Тесты

