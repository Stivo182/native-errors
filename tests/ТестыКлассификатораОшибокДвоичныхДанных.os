#Область СлужебныеПроцедурыИФункции

Функция ПолучитьОшибкуПереполненияБуфера()

	Попытка
		Буфер = ПолучитьБуферДвоичныхДанныхИзHexСтроки("01 02 03");
		Источник = ПолучитьБуферДвоичныхДанныхИзHexСтроки("04 05 06 07");
		Буфер.ЗаписатьПобитовоеИсключительноеИли(1, Источник);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка переполнения буфера не возникла";

КонецФункции

Функция ПолучитьОшибкуНекорректнойHexСтроки()

	Попытка
		Буфер = ПолучитьБуферДвоичныхДанныхИзHexСтроки("0xA1B2C3");
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка преобразования Hex-строки не возникла";

КонецФункции

Функция ПолучитьОшибкуЧтенияЗаГраницейБуфера()

	Попытка
		Буфер = Новый БуферДвоичныхДанных(3);
		Результат = Буфер.Прочитать(2, 2);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка чтения за границей буфера не возникла";

КонецФункции

Функция ПолучитьОшибкуЗаписиЗаГраницейБуфера()

	Попытка
		Буфер = Новый БуферДвоичныхДанных(3);
		Буфер.Записать(2, Новый БуферДвоичныхДанных(2));
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка записи за границей буфера не возникла";

КонецФункции

Функция ПолучитьОшибкуИзмененияБуфераТолькоДляЧтения()

	Попытка
		Буфер = Новый БуферДвоичныхДанных(2);
		Буфер.УстановитьТолькоЧтение();
		Буфер.Установить(0, 1);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка изменения буфера только для чтения не возникла";

КонецФункции

#КонецОбласти
