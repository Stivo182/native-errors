#Использовать errors
#Использовать "../src"
#Использовать "./internal"

#Область ОбработчикиСобытий

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_КлассифицироватьАннотированныеИсточникиОшибок() Экспорт

	// Действие и Проверка
	МатрицаИсточниковОшибок.Проверить(ЭтотОбъект, 7);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&ОжидаемыйКодОшибки("НедопустимоеЗначениеАргумента")
Функция ПолучитьОшибкуНедопустимогоЗначенияБайтаБуфера() Экспорт

	Попытка
		Буфер = Новый БуферДвоичныхДанных(1);
		Буфер.Установить(0, 256);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка недопустимого значения байта не возникла";

КонецФункции

&ОжидаемыйКодОшибки("ДвоичныеДанныеВыходЗаГраницыБуфера")
Функция ПолучитьОшибкуПереполненияБуфера() Экспорт

	Попытка
		Буфер = ПолучитьБуферДвоичныхДанныхИзHexСтроки("01 02 03");
		Источник = ПолучитьБуферДвоичныхДанныхИзHexСтроки("04 05 06 07");
		Буфер.ЗаписатьПобитовоеИсключительноеИли(1, Источник);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка переполнения буфера не возникла";

КонецФункции

&ОжидаемыйКодОшибки("ДвоичныеДанныеНекорректнаяHexСтрока")
Функция ПолучитьОшибкуНекорректнойHexСтроки() Экспорт

	Попытка
		Буфер = ПолучитьБуферДвоичныхДанныхИзHexСтроки("0xA1B2C3");
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка преобразования Hex-строки не возникла";

КонецФункции

&ОжидаемыйКодОшибки("ДвоичныеДанныеВыходЗаГраницыБуфера")
Функция ПолучитьОшибкуЧтенияЗаГраницейБуфера() Экспорт

	Попытка
		Буфер = Новый БуферДвоичныхДанных(3);
		Результат = Буфер.Прочитать(2, 2);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка чтения за границей буфера не возникла";

КонецФункции

&ОжидаемыйКодОшибки("ДвоичныеДанныеВыходЗаГраницыБуфера")
Функция ПолучитьОшибкуЗаписиЗаГраницейБуфера() Экспорт

	Попытка
		Буфер = Новый БуферДвоичныхДанных(3);
		Буфер.Записать(2, Новый БуферДвоичныхДанных(2));
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка записи за границей буфера не возникла";

КонецФункции

&ОжидаемыйКодОшибки("ДвоичныеДанныеТолькоДляЧтения")
Функция ПолучитьОшибкуИзмененияБуфераТолькоДляЧтения() Экспорт

	Попытка
		Буфер = Новый БуферДвоичныхДанных(2);
		Буфер.УстановитьТолькоЧтение();
		Буфер.Установить(0, 1);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка изменения буфера только для чтения не возникла";

КонецФункции

&ОжидаемыйКодОшибки("НедопустимыйТипАргумента")
Функция ПолучитьОшибкуНедопустимогоТипаИсточникаЧтенияДанных() Экспорт

	Попытка
		Чтение = Новый ЧтениеДанных(Новый Структура);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка недопустимого типа источника чтения данных не возникла";

КонецФункции

#КонецОбласти
