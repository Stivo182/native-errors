#Использовать asserts
#Использовать errors
#Использовать "../src"
#Использовать "./internal"

Перем _Проброс; // ТестовыйПробросПодробногоПредставления

#Область ОбработчикиСобытий

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПередВсеми() Экспорт

	_Проброс = Новый ТестовыйПробросПодробногоПредставления;

КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_КлассифицироватьВыходЗаГраницыБуфера() Экспорт

	// Подготовка
	ИсходнаяОшибка = ПолучитьОшибкуПереполненияБуфера();

	// Действие
	НормализованнаяОшибка = Новый КлассификаторНативныхОшибок.Классифицировать(ИсходнаяОшибка);

	// Проверка
	Ожидаем.Что(НормализованнаяОшибка).ИмеетТип("ИнформацияОбОшибке");
	Снимок = Новый СнимокКадраОшибки(НормализованнаяОшибка);
	Ожидаем.Что(Снимок.КодОшибки()).Равно(КодыНативныхОшибок.ДвоичныеДанныеВыходЗаГраницыБуфера());
	Ожидаем.Что(НормализованнаяОшибка.Причина).Идентично(ИсходнаяОшибка);
	Проброс = _Проброс;
	Проброс.ПроверитьКодВариантами(Новый КлассификаторНативныхОшибок, ИсходнаяОшибка,
		КодыНативныхОшибок.ДвоичныеДанныеВыходЗаГраницыБуфера());

КонецПроцедуры

