#Использовать errors
#Использовать "../src"
#Использовать "./internal"

#Область ОбработчикиСобытий

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

#КонецОбласти

#Область Тесты

&ПараметризованныйТест
&ИсточникВыражение("() -> ПараметрыИсточниковОшибок()")
Процедура ТестДолжен_КлассифицироватьИсточникОшибки(ИдентификаторПравила, ИмяИсточника) Экспорт

	МатрицаИсточниковОшибок.ПроверитьИсточник(ЭтотОбъект, ИмяИсточника);

КонецПроцедуры

Функция ПараметрыИсточниковОшибок() Экспорт

	Возврат МатрицаИсточниковОшибок.ПараметрыИсточников(ЭтотОбъект, 1);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&ОжидаемыйКодОшибки("XMLНекорректныйСинтаксис")
&ОжидаемоеПравилоОшибки("xml.invalid_syntax.xml_exception")
Функция ПолучитьОшибкуНекорректногоXMLСхемыXDTO() Экспорт

	Попытка
		Чтение = Новый ЧтениеXML;
		Чтение.УстановитьСтроку("<xs:schema xmlns:xs=""http://www.w3.org/2001/XMLSchema""><xs:element>");
		Чтение.Прочитать();
		Сериализатор = Новый СериализаторXDTO;
		Сериализатор.ПрочитатьXML(Чтение, Тип("СхемаXML"));
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка синтаксиса XML-схемы XDTO не возникла";

КонецФункции

#КонецОбласти
