#Использовать errors
#Использовать "../src"
#Использовать "./internal"

#Область ОбработчикиСобытий

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

#КонецОбласти

#Область Тесты

&ПараметризованныйТест
&ИсточникВыражение("() -> ПараметрыИсточниковОшибок()")
Процедура ТестДолжен_КлассифицироватьИсточникОшибки(ИдентификаторПравила, ИмяИсточника) Экспорт

	МатрицаИсточниковОшибок.ПроверитьИсточник(ЭтотОбъект, ИмяИсточника);

КонецПроцедуры

Функция ПараметрыИсточниковОшибок() Экспорт

	Возврат МатрицаИсточниковОшибок.ПараметрыИсточников(ЭтотОбъект, 1);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&ОжидаемыйКодОшибки("COMПолучениеАктивногоОбъектаНеПоддерживается")
&ОжидаемоеПравилоОшибки("com.active_object_not_supported")
Функция ПолучитьОшибкуПолученияАктивногоCOMОбъекта() Экспорт

	Попытка
		ПолучитьCOMОбъект(Неопределено, "Scripting.Dictionary");
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка получения активного COM-объекта не возникла";

КонецФункции

#КонецОбласти
