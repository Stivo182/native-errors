#Использовать asserts
#Использовать errors
#Использовать "../src"
#Использовать "./internal"

Перем _ВебСервер; // ВебСервер, Неопределено
Перем _ЗаданиеВебСервера; // ФоновоеЗадание, Неопределено
Перем _ПортВебСервера; // Число
Перем _ОшибкаIPАдреса; // ИнформацияОбОшибке, Неопределено

#Область ОбработчикиСобытий

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждого() Экспорт

	ОстановитьВебСервер();

КонецПроцедуры

#КонецОбласти

#Область Тесты

&ПараметризованныйТест()
&ИсточникВыражение("() -> ПараметрыИсточниковОшибок()")
Процедура ТестДолжен_КлассифицироватьИсточникОшибки(
	ИдентификаторПравила,
	ИмяИсточника) Экспорт

	// Действие и Проверка
	МатрицаИсточниковОшибок.ПроверитьИсточник(ЭтотОбъект, ИмяИсточника);

КонецПроцедуры

Функция ПараметрыИсточниковОшибок() Экспорт

	Возврат МатрицаИсточниковОшибок.ПараметрыИсточников(ЭтотОбъект, 3);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗапуститьВебСервер()

	_ПортВебСервера = ТестовыеСетевыеФикстуры.ПолучитьСвободныйПорт();
	_ВебСервер = Новый ВебСервер(_ПортВебСервера);
	_ВебСервер.ДобавитьОбработчикЗапросов(
		ЭтотОбъект,
		"ОбработатьЗапрос"
	);

	Параметры = Новый Массив;
	Параметры.Добавить(_ВебСервер);
	_ЗаданиеВебСервера = ФоновыеЗадания.Выполнить(
		ЭтотОбъект,
		"ВыполнитьВебСервер",
		Параметры
	);

КонецПроцедуры

Процедура ОстановитьВебСервер()

	Если _ВебСервер <> Неопределено Тогда
		_ВебСервер.Остановить();
		_ВебСервер = Неопределено;
	КонецЕсли;

	Если _ЗаданиеВебСервера <> Неопределено Тогда
		_ЗаданиеВебСервера.ОжидатьЗавершения(3000);
		_ЗаданиеВебСервера = Неопределено;
	КонецЕсли;

	ФоновыеЗадания.Очистить();

КонецПроцедуры

Функция ПолучитьОтветВебСервера()

	Для ПопыткаНомера = 1 По 30 Цикл
		Попытка
			Соединение = Новый HTTPСоединение(
				"http://127.0.0.1:" + _ПортВебСервера
			);
			Ответ = Соединение.Получить(Новый HTTPЗапрос("/"));
			Возврат Ответ.ПолучитьТелоКакСтроку();
		Исключение
			Приостановить(100);
		КонецПопытки;
	КонецЦикла;

	ВызватьИсключение "Тестовый веб-сервер не запустился";

КонецФункции

&ОжидаемыйКодОшибки("СетьНекорректныйIPАдрес")
&ОжидаемоеПравилоОшибки("network.invalid_ip_address")
Функция ПолучитьОшибкуНекорректногоIPАдресаСоединения() Экспорт

	_ОшибкаIPАдреса = Неопределено;
	ЗапуститьВебСервер();
	ПолучитьОтветВебСервера();
	ОстановитьВебСервер();

	Если _ОшибкаIPАдреса <> Неопределено Тогда
		Возврат _ОшибкаIPАдреса;
	КонецЕсли;

	ВызватьИсключение "Ожидаемая ошибка некорректного IP-адреса соединения не возникла";

КонецФункции

&ОжидаемыйКодОшибки("СетьАдресЗанят")
&ОжидаемоеПравилоОшибки("network.address_in_use.web_server")
Функция ПолучитьОшибкуЗанятогоПорта() Экспорт

	ЗапуститьВебСервер();
	ПолучитьОтветВебСервера();

	Попытка
		ВторойВебСервер = Новый ВебСервер(_ПортВебСервера);
		ВторойВебСервер.Запустить();
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка занятого сетевого адреса не возникла";

КонецФункции

&ОжидаемыйКодОшибки("СетьНекорректныйПорт")
&ОжидаемоеПравилоОшибки("network.invalid_port")
Функция ПолучитьОшибкуНекорректногоПорта() Экспорт

	Попытка
		ВебСервер = Новый ВебСервер(-1);
		ВебСервер.Запустить();
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка некорректного сетевого порта не возникла";

КонецФункции

Процедура ВыполнитьВебСервер(ВебСервер) Экспорт

	ВебСервер.Запустить();

КонецПроцедуры

Процедура ОбработатьЗапрос(
	Контекст,
	СледующийОбработчик
) Экспорт

	Попытка
		Соединение = Контекст.Соединение;
		Соединение.УдаленныйIPАдрес = "не-IP-адрес";
	Исключение
		_ОшибкаIPАдреса = ИнформацияОбОшибке();
	КонецПопытки;
	Контекст.Ответ.Записать("Проверка IP-адреса завершена");

КонецПроцедуры

#КонецОбласти
