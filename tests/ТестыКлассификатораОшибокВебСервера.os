#Использовать asserts
#Использовать errors
#Использовать "../src"
#Использовать "./internal"

Перем _ВебСервер; // ВебСервер, Неопределено
Перем _ЗаданиеВебСервера; // ФоновоеЗадание, Неопределено
Перем _ПортВебСервера; // Число

#Область ОбработчикиСобытий

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждого() Экспорт

	ОстановитьВебСервер();

КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_IPАдресСоединенияНекорректен() Экспорт

	// Подготовка
	ЗапуститьВебСервер();

	// Действие
	Результат = ПолучитьОтветВебСервера();

	// Проверка
	Ожидаем.Что(Результат)
		.Равно(КодыНативныхОшибок.СетьНекорректныйIPАдрес());

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗапуститьВебСервер()

	Менеджер = Новый МенеджерФоновыхЗаданий;
	_ПортВебСервера = ТестовыеСетевыеФикстуры.ПолучитьСвободныйПорт();
	_ВебСервер = Новый ВебСервер(_ПортВебСервера);
	_ВебСервер.ДобавитьОбработчикЗапросов(
		ЭтотОбъект,
		"ОбработатьЗапрос"
	);

	Параметры = Новый Массив;
	Параметры.Добавить(_ВебСервер);
	_ЗаданиеВебСервера = Менеджер.Выполнить(
		ЭтотОбъект,
		"ВыполнитьВебСервер",
		Параметры
	);

КонецПроцедуры

Процедура ОстановитьВебСервер()

	Если _ВебСервер <> Неопределено Тогда
		_ВебСервер.Остановить();
		_ВебСервер = Неопределено;
	КонецЕсли;

	Если _ЗаданиеВебСервера <> Неопределено Тогда
		_ЗаданиеВебСервера.ОжидатьЗавершения(3000);
		_ЗаданиеВебСервера = Неопределено;
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьОтветВебСервера()

	Для ПопыткаНомера = 1 По 30 Цикл
		Попытка
			Соединение = Новый HTTPСоединение(
				"http://127.0.0.1:" + _ПортВебСервера
			);
			Ответ = Соединение.Получить(Новый HTTPЗапрос("/"));
			Возврат Ответ.ПолучитьТелоКакСтроку();
		Исключение
			Приостановить(100);
		КонецПопытки;
	КонецЦикла;

	ВызватьИсключение "Тестовый веб-сервер не запустился";

КонецФункции

Процедура ВыполнитьВебСервер(ВебСервер) Экспорт

	ВебСервер.Запустить();

КонецПроцедуры

Процедура ОбработатьЗапрос(
	Контекст,
	СледующийОбработчик
) Экспорт

	Попытка
		Соединение = Контекст.Соединение;
		Соединение.УдаленныйIPАдрес = "не-IP-адрес";
	Исключение
		Классификатор = Новый КлассификаторНативныхОшибок();
		Ошибка = Классификатор.Классифицировать(ИнформацияОбОшибке());
		Контекст.Ответ.Записать(
			ДиагностикаОшибок.КодОшибки(Ошибка)
		);
	КонецПопытки;

КонецПроцедуры

#КонецОбласти
