#Использовать asserts
#Использовать errors
#Использовать "../src"
#Использовать "./internal"

#Область ОбработчикиСобытий

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

#КонецОбласти

#Область Тесты

&ПараметризованныйТест
&ИсточникВыражение("() -> ПараметрыИсточниковОшибок()")
Процедура ТестДолжен_КлассифицироватьИсточникОшибки(ИдентификаторПравила, ИмяИсточника) Экспорт

	МатрицаИсточниковОшибок.ПроверитьИсточник(ЭтотОбъект, ИмяИсточника);

КонецПроцедуры

Функция ПараметрыИсточниковОшибок() Экспорт

	Возврат МатрицаИсточниковОшибок.ПараметрыИсточников(ЭтотОбъект, 2);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&ОжидаемыйКодОшибки("НедопустимыйТипАргумента")
&ОжидаемоеПравилоОшибки("argument.invalid_type.generic")
Функция ПолучитьОшибкуДобавленияОтсутствующегоФайлаВХеширование() Экспорт

	Путь = ОбъединитьПути(
		ТекущийСценарий().Каталог,
		"fixtures/гарантированно-отсутствующий-файл-для-хеширования-native-errors.txt");
	Ожидаем.Что(
		Новый Файл(Путь).Существует(),
		"Файл для проверки хеширования должен отсутствовать"
	).Равно(Ложь);
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);

	Попытка
		Хеширование.ДобавитьФайл(Путь);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка добавления отсутствующего файла в хеширование не возникла";

КонецФункции

&ОжидаемыйКодОшибки("ПотокЗакрыт")
&ОжидаемоеПравилоОшибки("stream.closed.dotnet_stream")
Функция ПолучитьОшибкуДобавленияЗакрытогоПотокаВХеширование() Экспорт

	Поток = Новый ПотокВПамяти;
	Поток.Закрыть();
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);

	Попытка
		Хеширование.Добавить(Поток);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка добавления закрытого потока в хеширование не возникла";

КонецФункции

#КонецОбласти
