&Тест
Процедура ТестДолжен_СохранятьПравилаНезависимоОтВходногоМассива() Экспорт

	// Подготовка
	Правила = Новый Массив;
	ИсходноеПравило = Правило(СпособыСопоставленияНативныхОшибок.Точное(), "Сообщение");
	Правила.Добавить(ИсходноеПравило);
	Индекс = Новый ИндексПравилКлассификацииНативныхОшибок(Правила, "ТестовыеПравила");
	Кандидаты = Новый Массив;

	// Действие
	ИсходноеПравило.ШаблонСообщения = "Другой текст";
	ИсходноеПравило.КодОшибки = КодыНативныхОшибок.XMLЗаписьНеОткрыта();
	Правила.Очистить();
	Индекс.СобратьКандидаты(Кадр("Сообщение"), Кандидаты);

	// Проверка
	Ожидаем.Что(Кандидаты.Количество()).Равно(1);
	Ожидаем.Что(Кандидаты[0].Код).Равно(КодыНативныхОшибок.JSONЧтениеНеОткрыто());
	Ожидаем.Что(Кандидаты[0].Данные).ИмеетТип("ФиксированнаяСтруктура");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Правило(Способ, Шаблон, Окончание = "", НативныйТип = "")

	ШаблонСообщения = "";
	Префикс = "";
	Фрагмент = "";
	Если Способ = СпособыСопоставленияНативныхОшибок.Точное() Тогда
		ШаблонСообщения = Шаблон;
	ИначеЕсли Способ = СпособыСопоставленияНативныхОшибок.Префикс()
		Или Способ = СпособыСопоставленияНативныхОшибок.ПрефиксОкончание() Тогда
		Префикс = Шаблон;
	ИначеЕсли Способ = СпособыСопоставленияНативныхОшибок.ТипИФрагмент()
		Или Способ = СпособыСопоставленияНативныхОшибок.ТипИОбрамление() Тогда
		Фрагмент = Шаблон;
	КонецЕсли;

	Возврат Новый ПравилоКлассификацииНативныхОшибок(
		Способ,
		КодыНативныхОшибок.JSONЧтениеНеОткрыто(),
		"Тестовое описание",
		НативныйТип,
		ШаблонСообщения,
		Префикс,
		Фрагмент,
		Окончание
	);

КонецФункции

Функция Кадр(Описание, НативныйТип = Неопределено, РазрешенДляПоиска = Истина)

	Возврат Новый ФиксированнаяСтруктура(
		Новый Структура("Описание, НативныйТип, РазрешенДляПоиска", Описание, НативныйТип, РазрешенДляПоиска)
	);

КонецФункции

#КонецОбласти
