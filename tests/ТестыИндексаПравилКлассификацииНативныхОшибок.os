&Тест
Процедура ТестДолжен_СохранятьПравилаНезависимоОтВходногоМассива() Экспорт

	// Подготовка
	Правила = Новый Массив;
	ИсходноеПравило = Правило(СпособыСопоставленияНативныхОшибок.Точное(), "Сообщение");
	Правила.Добавить(ИсходноеПравило);
	Индекс = Новый ИндексПравилКлассификацииНативныхОшибок(Правила, "ТестовыеПравила");
	Кандидаты = Новый Массив;

	// Действие
	ИсходноеПравило.ШаблонСообщения = "Другой текст";
	ИсходноеПравило.КодОшибки = КодыНативныхОшибок.XMLЗаписьНеОткрыта();
	Правила.Очистить();
	Индекс.СобратьКандидаты(Кадр("Сообщение"), Кандидаты);

	// Проверка
	Ожидаем.Что(Кандидаты.Количество()).Равно(1);
	Ожидаем.Что(Кандидаты[0].Код).Равно(КодыНативныхОшибок.JSONЧтениеНеОткрыто());
	Ожидаем.Что(Кандидаты[0].Данные).ИмеетТип("ФиксированнаяСтруктура");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонятьПравилоБезОбязательногоПрефикса() Экспорт

	// Подготовка
	Правила = Новый Массив;
	Правила.Добавить(ФабрикаПравилНативныхОшибок.Префикс(
		"",
		"custom.invalid",
		"Некорректное правило"
	));

	// Действие
	ТекстОшибки = "";
	Попытка
		Индекс = Новый ИндексПравилКлассификацииНативныхОшибок(Правила, "ТестовыеПравила");
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;

	// Проверка
	Ожидаем.Что(ТекстОшибки).Содержит("Префикс");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранятьИдентификаторПравилаВКандидате() Экспорт

	// Подготовка
	Правила = Новый Массив;
	Правила.Добавить(ФабрикаПравилНативныхОшибок.Точное(
		"Тестовое сообщение",
		"custom.test",
		"Тестовая ошибка"
	));
	Индекс = Новый ИндексПравилКлассификацииНативныхОшибок(Правила, "ТестовыеПравила");
	Кандидаты = Новый Массив;

	// Действие
	Индекс.СобратьКандидаты(Кадр("Тестовое сообщение"), Кандидаты);

	// Проверка
	Ожидаем.Что(Кандидаты[0].Данные.Правило).Равно("ТестовыеПравила.1");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонятьВсеНезаполненныеОбязательныеПоляПравила() Экспорт

	// Подготовка
	ТестовыеСлучаи = Новый Массив;
	ДобавитьТестовыйСлучай(
		ТестовыеСлучаи,
		ФабрикаПравилНативныхОшибок.Точное("", "custom.invalid", ""),
		"ШаблонСообщения"
	);
	ДобавитьТестовыйСлучай(ТестовыеСлучаи, ФабрикаПравилНативныхОшибок.Префикс("", "custom.invalid", ""), "Префикс");
	ДобавитьТестовыйСлучай(
		ТестовыеСлучаи,
		ФабрикаПравилНативныхОшибок.ПрефиксИФрагмент("Префикс", "", "custom.invalid", ""),
		"Фрагмент"
	);
	ДобавитьТестовыйСлучай(ТестовыеСлучаи, ФабрикаПравилНативныхОшибок.ПоТипу("", "custom.invalid", ""), "НативныйТип");
	ДобавитьТестовыйСлучай(
		ТестовыеСлучаи,
		ФабрикаПравилНативныхОшибок.ТипИОкончание("System.Exception", "", "custom.invalid", ""),
		"Окончание"
	);
	ДобавитьТестовыйСлучай(
		ТестовыеСлучаи,
		ФабрикаПравилНативныхОшибок.ТипИФрагмент("System.Exception", "", "custom.invalid", ""),
		"Фрагмент"
	);

	// Действие и Проверка
	Для Каждого ТестовыйСлучай Из ТестовыеСлучаи Цикл
		ПроверитьОшибкаИндексацииПравила(ТестовыйСлучай.Правило, ТестовыйСлучай.ИмяПоля);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыбрасыватьСтруктурированнуюОшибкуДляНеизвестногоСпособаСопоставления() Экспорт

	// Подготовка
	Правило = Новый ПравилоКлассификацииНативныхОшибок(
		999,
		"custom.invalid",
		"Тестовая ошибка"
	);
	Правила = Новый Массив;
	Правила.Добавить(Правило);

	// Действие
	Ошибка = Неопределено;
	Попытка
		Индекс = Новый ИндексПравилКлассификацииНативныхОшибок(Правила, "ТестовыеПравила");
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	// Проверка
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно(
		КодыСтандартныхОшибок.НедопустимоеЗначениеАргумента()
	);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИметьРусскийИАнглийскийВариантыСообщенияКаждогоВстроенногоПравила() Экспорт

	// Действие и Проверка
	Для Каждого Правило Из Новый ПравилаНативныхОшибок().Все() Цикл
		НормализованноеСообщение = СтрЗаменить(НРег(Правило.Сообщение), " ", "");
		Ожидаем.Что(СтрНайти(НормализованноеСообщение, "ru=")).Больше(0);
		Ожидаем.Что(СтрНайти(НормализованноеСообщение, "en=")).Больше(0);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеСопоставлятьОтрицательныеВариантыВсехТекстовыхПравил() Экспорт

	// Подготовка
	Правила = Новый ПравилаНативныхОшибок().Все();
	Индекс = Новый ИндексПравилКлассификацииНативныхОшибок(Правила, "ВстроенныеПравила");
	КоличествоТекстовыхПравил = 0;

	// Действие и Проверка
	Для Каждого Правило Из Правила Цикл
		Если Не ЭтоТекстовоеПравило(Правило) Тогда
			Продолжить;
		КонецЕсли;

		КоличествоТекстовыхПравил = КоличествоТекстовыхПравил + 1;
		Кандидаты = Новый Массив;
		Индекс.СобратьКандидаты(
			Кадр(ПолучитьОтрицательныйВариант(Правило), Правило.НативныйТип),
			Кандидаты
		);
		ПроверитьОтсутствиеПравила(Кандидаты, Правило.Идентификатор);
	КонецЦикла;

	Ожидаем.Что(КоличествоТекстовыхПравил).Больше(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИметьУникальныеИдентификаторыВстроенныхПравил() Экспорт

	// Подготовка
	Идентификаторы = Новый Соответствие;

	// Действие и Проверка
	Для Каждого Правило Из Новый ПравилаНативныхОшибок().Все() Цикл
		Ожидаем.Что(ПустаяСтрока(Правило.Идентификатор)).ЭтоЛожь();
		Ожидаем.Что(Идентификаторы.Получить(Правило.Идентификатор)).Идентично(Неопределено);
		Идентификаторы.Вставить(Правило.Идентификатор, Истина);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Правило(Способ, Шаблон, Окончание = "", НативныйТип = "")

	ШаблонСообщения = "";
	Префикс = "";
	Фрагмент = "";
	Если Способ = СпособыСопоставленияНативныхОшибок.Точное() Тогда
		ШаблонСообщения = Шаблон;
	ИначеЕсли Способ = СпособыСопоставленияНативныхОшибок.Префикс()
		Или Способ = СпособыСопоставленияНативныхОшибок.ПрефиксОкончание() Тогда
		Префикс = Шаблон;
	ИначеЕсли Способ = СпособыСопоставленияНативныхОшибок.ТипИФрагмент()
		Или Способ = СпособыСопоставленияНативныхОшибок.ТипИОбрамление() Тогда
		Фрагмент = Шаблон;
	КонецЕсли;

	Возврат Новый ПравилоКлассификацииНативныхОшибок(
		Способ,
		КодыНативныхОшибок.JSONЧтениеНеОткрыто(),
		"Тестовое описание",
		НативныйТип,
		ШаблонСообщения,
		Префикс,
		Фрагмент,
		Окончание
	);

КонецФункции

Функция Кадр(Описание, НативныйТип = Неопределено, РазрешенДляПоиска = Истина)

	Возврат Новый ФиксированнаяСтруктура(
		Новый Структура("Описание, НативныйТип, РазрешенДляПоиска", Описание, НативныйТип, РазрешенДляПоиска)
	);

КонецФункции

Функция ЭтоТекстовоеПравило(Правило)

	Возврат Правило.Способ <> СпособыСопоставленияНативныхОшибок.ПоТипу();

КонецФункции

Функция ПолучитьОтрицательныйВариант(Правило)

	Если Правило.Способ = СпособыСопоставленияНативныхОшибок.Точное() Тогда
		Возврат ТекстШаблона(Правило.ШаблонСообщения) + "!";
	ИначеЕсли Правило.Способ = СпособыСопоставленияНативныхОшибок.Префикс()
		Или Правило.Способ = СпособыСопоставленияНативныхОшибок.ПрефиксОкончание()
		Или Правило.Способ = СпособыСопоставленияНативныхОшибок.ПрефиксИФрагмент() Тогда
		Возврат "!" + ТекстШаблона(Правило.Префикс);
	ИначеЕсли Правило.Способ = СпособыСопоставленияНативныхОшибок.ТипИОкончание() Тогда
		Возврат ТекстШаблона(Правило.Окончание) + "!";
	КонецЕсли;

	Фрагмент = ТекстШаблона(Правило.Фрагмент);
	Возврат Символ(1) + Сред(Фрагмент, 2);

КонецФункции

Функция ТекстШаблона(Шаблон)

	НормализованныйШаблон = СтрЗаменить(НРег(Шаблон), " ", "");
	Если СтрНайти(НормализованныйШаблон, "ru=") > 0 Тогда
		Возврат НСтр(Шаблон, "ru");
	ИначеЕсли СтрНайти(НормализованныйШаблон, "en=") > 0 Тогда
		Возврат НСтр(Шаблон, "en");
	КонецЕсли;

	Возврат Шаблон;

КонецФункции

Процедура ПроверитьОтсутствиеПравила(Кандидаты, ИдентификаторПравила)

	Для Каждого Кандидат Из Кандидаты Цикл
		Если Кандидат.Данные.Правило = ИдентификаторПравила Тогда
			ВызватьИсключение СтрШаблон(
				"Отрицательный вариант ошибочно совпал с правилом %1",
				ИдентификаторПравила
			);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьТестовыйСлучай(ТестовыеСлучаи, Правило, ИмяПоля)

	ТестовыеСлучаи.Добавить(Новый Структура("Правило, ИмяПоля", Правило, ИмяПоля));

КонецПроцедуры

Процедура ПроверитьОшибкаИндексацииПравила(Правило, ИмяПоля)

	Правила = Новый Массив;
	Правила.Добавить(Правило);
	Ошибка = Неопределено;
	Попытка
		Индекс = Новый ИндексПравилКлассификацииНативныхОшибок(Правила, "ТестовыеПравила");
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	Ожидаем.Что(Ошибка.Описание).Содержит(ИмяПоля);
	Ожидаем.Что(ДиагностикаОшибок.КодОшибки(Ошибка)).Равно(
		КодыСтандартныхОшибок.НедопустимоеЗначениеАргумента()
	);

КонецПроцедуры

#КонецОбласти
