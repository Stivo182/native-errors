#Область Тесты

&Тест
Процедура ТестДолжен_НаходитьТочныеСообщенияНаОбоихЯзыках() Экспорт

	// Подготовка
	Правила = Новый Массив;
	Правила.Добавить(Правило(
		СпособыСопоставленияНативныхОшибок.Точное(),
		"ru = 'Источник не открыт'; en = 'Source is not opened'"
	));
	Индекс = Новый ИндексПравилКлассификацииНативныхОшибок(Правила, "ТестовыеПравила");
	РусскиеКандидаты = Новый Массив;
	АнглийскиеКандидаты = Новый Массив;
	ПосторонниеКандидаты = Новый Массив;

	// Действие
	Индекс.СобратьКандидаты(Кадр("Источник не открыт"), РусскиеКандидаты);
	Индекс.СобратьКандидаты(Кадр("Source is not opened"), АнглийскиеКандидаты);
	Индекс.СобратьКандидаты(Кадр("Source is not opened completely"), ПосторонниеКандидаты);

	// Проверка
	Ожидаем.Что(РусскиеКандидаты.Количество()).Равно(1);
	Ожидаем.Что(АнглийскиеКандидаты.Количество()).Равно(1);
	Ожидаем.Что(ПосторонниеКандидаты.Количество()).Равно(0);
	Ожидаем.Что(РусскиеКандидаты[0].Код).Равно(КодыНативныхОшибок.JSONЧтениеНеОткрыто());

КонецПроцедуры

