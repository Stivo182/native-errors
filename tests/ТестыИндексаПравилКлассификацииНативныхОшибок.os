&Тест
Процедура ТестДолжен_СохранятьСогласованностьЯзыкаОбрамления() Экспорт

	// Подготовка
	Правила = Новый Массив;
	Правила.Добавить(Правило(
		СпособыСопоставленияНативныхОшибок.ПрефиксОкончание(),
		"ru = 'Начало'; en = 'Start'",
		"ru = 'конец'; en = 'end'"
	));
