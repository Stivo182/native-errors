&Тест
Процедура ТестДолжен_СопоставлятьТипИОкончаниеОдногоКадра() Экспорт

	// Подготовка
	Правила = Новый Массив;
	Правила.Добавить(Правило(СпособыСопоставленияНативныхОшибок.ТипИОкончание(), "", "expected suffix", "System.IO.IOException"));
	Индекс = Новый ИндексПравилКлассификацииНативныхОшибок(Правила, "ТестовыеПравила");
	Кандидаты = Новый Массив;

	// Действие
	Индекс.СобратьКандидаты(Кадр("outer message", "System.IO.IOException"), Кандидаты);
	Индекс.СобратьКандидаты(Кадр("inner expected suffix", "System.ArgumentException"), Кандидаты);

	// Проверка
	Ожидаем.Что(Кандидаты.Количество()).Равно(0);

	// Действие
	Индекс.СобратьКандидаты(Кадр("message expected suffix", "System.IO.IOException"), Кандидаты);

	// Проверка
	Ожидаем.Что(Кандидаты.Количество()).Равно(1);
	Ожидаем.Что(Кандидаты[0].Данные.НативныйТип).Равно("System.IO.IOException");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СобиратьВсеСовпаденияРазныхСпособов() Экспорт

	// Подготовка
	Правила = Новый Массив;
	Правила.Добавить(Правило(СпособыСопоставленияНативныхОшибок.ПоТипу(), "", "", "System.IO.IOException"));
	Правила.Добавить(Правило(СпособыСопоставленияНативныхОшибок.Точное(), "Начало значение конец"));
	Правила.Добавить(Правило(СпособыСопоставленияНативныхОшибок.Префикс(), "Начало"));
	Правила.Добавить(Правило(СпособыСопоставленияНативныхОшибок.ПрефиксОкончание(), "Начало", "конец"));
	Правила.Добавить(Правило(СпособыСопоставленияНативныхОшибок.ТипИОкончание(), "", "конец", "System.IO.IOException"));
	Правила.Добавить(Правило(СпособыСопоставленияНативныхОшибок.ТипИФрагмент(), "значение", "", "System.IO.IOException"));
	Правила.Добавить(Правило(СпособыСопоставленияНативныхОшибок.ТипИОбрамление(), "значение", "конец", "System.IO.IOException"));
	Коды = КодыНативныхОшибок.Все();
	Для НомерПравила = 0 По Правила.ВГраница() Цикл
		Правила[НомерПравила].КодОшибки = Коды[НомерПравила];
	КонецЦикла;

	Индекс = Новый ИндексПравилКлассификацииНативныхОшибок(Правила, "ТестовыеПравила");
	Кандидаты = Новый Массив;

	// Действие
	Индекс.СобратьКандидаты(Кадр("Начало значение конец", "System.IO.IOException"), Кандидаты);

	// Проверка
	Ожидаем.Что(Кандидаты.Количество()).Равно(7);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОбъединятьОдинаковыеКодыСохраняяПроверенныйТип() Экспорт

	// Подготовка
	Правила = Новый Массив;
	Правила.Добавить(Правило(СпособыСопоставленияНативныхОшибок.Точное(), "Сообщение"));
	Правила.Добавить(Правило(СпособыСопоставленияНативныхОшибок.ПоТипу(), "", "", "System.IO.IOException"));
	Индекс = Новый ИндексПравилКлассификацииНативныхОшибок(Правила, "ТестовыеПравила");
	Кандидаты = Новый Массив;

	// Действие
	Индекс.СобратьКандидаты(Кадр("Сообщение", "System.IO.IOException"), Кандидаты);
	Индекс.СобратьКандидаты(Кадр("Сообщение", "System.IO.IOException"), Кандидаты);

	// Проверка
	Ожидаем.Что(Кандидаты.Количество()).Равно(2);
	Ожидаем.Что(Кандидаты[0].Данные.НативныйТип).Равно("System.IO.IOException");
	Ожидаем.Что(Кандидаты[1].Данные.НативныйТип).Равно("System.IO.IOException");

КонецПроцедуры

