&Тест
Процедура ТестДолжен_СопоставлятьПрефиксИФрагментНаОбоихЯзыках() Экспорт

	// Подготовка
	Правила = Новый Массив;
	Правила.Добавить(ФабрикаПравилНативныхОшибок.ПрефиксИФрагмент(
		"ru = 'Ошибка метода ('; en = 'Method error ('",
		"ru = '): Недопустимое значение'; en = '): Invalid value'",
		КодыНативныхОшибок.НедопустимоеЗначениеАргумента(),
		"Тестовое описание"
	));
	Индекс = Новый ИндексПравилКлассификацииНативныхОшибок(Правила, "ТестовыеПравила");
	РусскиеКандидаты = Новый Массив;
	АнглийскиеКандидаты = Новый Массив;
	НеполныеКандидаты = Новый Массив;

	// Действие
	Индекс.СобратьКандидаты(Кадр("Ошибка метода (Тест): Недопустимое значение"), РусскиеКандидаты);
	Индекс.СобратьКандидаты(Кадр("Method error (Test): Invalid value"), АнглийскиеКандидаты);
	Индекс.СобратьКандидаты(Кадр("Method error (Test): Other value"), НеполныеКандидаты);

	// Проверка
	Ожидаем.Что(РусскиеКандидаты.Количество()).Равно(1);
	Ожидаем.Что(АнглийскиеКандидаты.Количество()).Равно(1);
	Ожидаем.Что(НеполныеКандидаты.Количество()).Равно(0);

КонецПроцедуры

