&Тест
Процедура ТестДолжен_СохранятьСогласованностьЯзыкаОбрамления() Экспорт

	// Подготовка
	Правила = Новый Массив;
	Правила.Добавить(Правило(
		СпособыСопоставленияНативныхОшибок.ПрефиксОкончание(),
		"ru = 'Начало'; en = 'Start'",
		"ru = 'конец'; en = 'end'"
	));
	Индекс = Новый ИндексПравилКлассификацииНативныхОшибок(Правила, "ТестовыеПравила");
	Кандидаты = Новый Массив;

	// Действие
	Индекс.СобратьКандидаты(Кадр("Начало значение end"), Кандидаты);
	Индекс.СобратьКандидаты(Кадр("Start value конец"), Кандидаты);

	// Проверка
	Ожидаем.Что(Кандидаты.Количество()).Равно(0);

	// Действие
	Индекс.СобратьКандидаты(Кадр("Начало значение конец"), Кандидаты);
	Индекс.СобратьКандидаты(Кадр("Start value end"), Кандидаты);

	// Проверка
	Ожидаем.Что(Кандидаты.Количество()).Равно(2);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеИспользоватьЗапрещенныйДляПоискаКадр() Экспорт

	// Подготовка
	Правила = Новый Массив;
	Правила.Добавить(Правило(СпособыСопоставленияНативныхОшибок.Точное(), "Сообщение"));
	Правила.Добавить(Правило(СпособыСопоставленияНативныхОшибок.ПоТипу(), "", "", "System.IO.IOException"));
	Индекс = Новый ИндексПравилКлассификацииНативныхОшибок(Правила, "ТестовыеПравила");
	Кандидаты = Новый Массив;

	// Действие
	Индекс.СобратьКандидаты(Кадр("Сообщение", "System.IO.IOException", Ложь), Кандидаты);

	// Проверка
	Ожидаем.Что(Кандидаты.Количество()).Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранятьПравилаНезависимоОтВходногоМассива() Экспорт

	// Подготовка
	Правила = Новый Массив;
	ИсходноеПравило = Правило(СпособыСопоставленияНативныхОшибок.Точное(), "Сообщение");
	Правила.Добавить(ИсходноеПравило);
	Индекс = Новый ИндексПравилКлассификацииНативныхОшибок(Правила, "ТестовыеПравила");
	Кандидаты = Новый Массив;

	// Действие
	ИсходноеПравило.Начало = "Другой текст";
	ИсходноеПравило.КодОшибки = КодыНативныхОшибок.XMLЗаписьНеОткрыта();
	Правила.Очистить();
	Индекс.СобратьКандидаты(Кадр("Сообщение"), Кандидаты);

	// Проверка
	Ожидаем.Что(Кандидаты.Количество()).Равно(1);
	Ожидаем.Что(Кандидаты[0].Код).Равно(КодыНативныхОшибок.JSONЧтениеНеОткрыто());
	Ожидаем.Что(Кандидаты[0].Данные).ИмеетТип("ФиксированнаяСтруктура");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Правило(Способ, Начало, Окончание = "", НативныйТип = "")

	Возврат Новый ПравилоКлассификацииНативныхОшибок(
		Способ,
		НативныйТип,
		Начало,
		Окончание,
		КодыНативныхОшибок.JSONЧтениеНеОткрыто(),
		"Тестовое описание"
	);

КонецФункции

Функция Кадр(Описание, НативныйТип = Неопределено, РазрешенДляПоиска = Истина)

	Возврат Новый ФиксированнаяСтруктура(
		Новый Структура("Описание, НативныйТип, РазрешенДляПоиска", Описание, НативныйТип, РазрешенДляПоиска)
	);

КонецФункции

#КонецОбласти
