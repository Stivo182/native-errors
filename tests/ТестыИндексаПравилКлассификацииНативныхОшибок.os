&Тест
Процедура ТестДолжен_СопоставлятьОдноязычныеИИнвариантныеШаблоны() Экспорт

	// Подготовка
	КодОшибки = КодыНативныхОшибок.JSONЧтениеНеОткрыто();
	ТестовыеСлучаи = Новый Массив;
	ТестовыеСлучаи.Добавить(Новый Структура(
		"Правило, Описание, НативныйТип, ОжидаемоеКоличество",
		ФабрикаПравилНативныхОшибок.Префикс("en = 'English prefix'", КодОшибки, "Тестовое описание"),
		"English prefix value",
		Неопределено,
		1
	));
	ТестовыеСлучаи.Добавить(Новый Структура(
		"Правило, Описание, НативныйТип, ОжидаемоеКоличество",
		ФабрикаПравилНативныхОшибок.Префикс("en = 'English prefix'", КодОшибки, "Тестовое описание"),
		"Постороннее сообщение",
		Неопределено,
		0
	));
	ТестовыеСлучаи.Добавить(Новый Структура(
		"Правило, Описание, НативныйТип, ОжидаемоеКоличество",
		ФабрикаПравилНативныхОшибок.Префикс("ru = 'Русский префикс'", КодОшибки, "Тестовое описание"),
		"Русский префикс значение",
		Неопределено,
		1
	));
	ТестовыеСлучаи.Добавить(Новый Структура(
		"Правило, Описание, НативныйТип, ОжидаемоеКоличество",
		ФабрикаПравилНативныхОшибок.ТипИФрагмент(
			"System.IO.IOException",
			"en = 'English fragment'",
			КодОшибки,
			"Тестовое описание"
		),
		"Значение English fragment",
		"System.IO.IOException",
		1
	));
	ТестовыеСлучаи.Добавить(Новый Структура(
		"Правило, Описание, НативныйТип, ОжидаемоеКоличество",
		ФабрикаПравилНативныхОшибок.ТипИФрагмент(
			"System.IO.IOException",
			"en = 'English fragment'",
			КодОшибки,
			"Тестовое описание"
		),
		"Постороннее сообщение",
		"System.IO.IOException",
		0
	));
	ТестовыеСлучаи.Добавить(Новый Структура(
		"Правило, Описание, НативныйТип, ОжидаемоеКоличество",
		ФабрикаПравилНативныхОшибок.ПрефиксОкончание(
			"Инвариантный префикс ",
			"en = 'English end'",
			КодОшибки,
			"Тестовое описание"
		),
		"Инвариантный префикс значение English end",
		Неопределено,
		1
	));
	ТестовыеСлучаи.Добавить(Новый Структура(
		"Правило, Описание, НативныйТип, ОжидаемоеКоличество",
		Новый ПравилоКлассификацииНативныхОшибок(
			СпособыСопоставленияНативныхОшибок.ПрефиксОкончание(),
			КодОшибки,
			"Тестовое описание",
			"",
			"",
			"ru = 'Русский префикс'",
			"",
			"en = 'English end'"
		),
		"Русский префикс значение English end",
		Неопределено,
		0
	));

	Для Каждого ТестовыйСлучай Из ТестовыеСлучаи Цикл
		Правила = Новый Массив;
		Правила.Добавить(ТестовыйСлучай.Правило);
		Индекс = Новый ИндексПравилКлассификацииНативныхОшибок(Правила, "ТестовыеПравила");
		Кандидаты = Новый Массив;

		// Действие
		Индекс.СобратьКандидаты(
			Кадр(ТестовыйСлучай.Описание, ТестовыйСлучай.НативныйТип),
			Кандидаты
		);

		// Проверка
		Ожидаем.Что(Кандидаты.Количество()).Равно(ТестовыйСлучай.ОжидаемоеКоличество);
	КонецЦикла;

КонецПроцедуры

