#Использовать errors
#Использовать "../src"
#Использовать "./internal"

#Область ОбработчикиСобытий

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

#КонецОбласти

#Область Тесты

&ПараметризованныйТест()
&ИсточникВыражение("() -> ПараметрыИсточниковОшибок()")
Процедура ТестДолжен_КлассифицироватьИсточникОшибки(
	ИдентификаторПравила,
	ИмяИсточника) Экспорт

	// Действие и Проверка
	МатрицаИсточниковОшибок.ПроверитьИсточник(ЭтотОбъект, ИмяИсточника);

КонецПроцедуры

Функция ПараметрыИсточниковОшибок() Экспорт

	Возврат МатрицаИсточниковОшибок.ПараметрыИсточников(ЭтотОбъект, 3);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&ОжидаемыйКодОшибки("СтроковыйШаблонНекорректныйСинтаксис")
&ОжидаемоеПравилоОшибки("string.invalid_template")
Функция ПолучитьОшибкуНекорректногоНомераПодстановки() Экспорт

	Попытка
		Результат = СтрШаблон("%0");
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка некорректного номера подстановки не возникла";

КонецФункции

&ОжидаемыйКодОшибки("СлишкомМногоАргументовВызова")
&ОжидаемоеПравилоОшибки("argument.too_many")
Функция ПолучитьОшибкуИзбыточныхАргументовСтроковогоШаблона() Экспорт

	Попытка
		Результат = СтрШаблон("%1", "Первый", "Второй");
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка избыточных аргументов строкового шаблона не возникла";

КонецФункции

&ОжидаемыйКодОшибки("СтроковыйШаблонНекорректныйСинтаксис")
&ОжидаемоеПравилоОшибки("string.invalid_template")
Функция ПолучитьОшибкуНекорректногоСинтаксисаШаблона() Экспорт

	Попытка
		Результат = СтрШаблон("%x");
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка некорректного синтаксиса шаблона не возникла";

КонецФункции

#КонецОбласти
