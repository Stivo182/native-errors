#Использовать asserts
#Использовать errors
#Использовать "../src"
#Использовать "./internal"

#Область ОбработчикиСобытий

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

#КонецОбласти

#Область Тесты

&ПараметризованныйТест
&ИсточникВыражение("() -> ПараметрыИсточниковОшибок()")
Процедура ТестДолжен_КлассифицироватьИсточникОшибки(ИдентификаторПравила, ИмяИсточника) Экспорт

	МатрицаИсточниковОшибок.ПроверитьИсточник(ЭтотОбъект, ИмяИсточника);

КонецПроцедуры

Функция ПараметрыИсточниковОшибок() Экспорт

	Возврат МатрицаИсточниковОшибок.ПараметрыИсточников(ЭтотОбъект, 2);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&ВключенНаОС("Linux", Причина = "Сообщение Process.Start для Linux")
&ОжидаемыйКодОшибки("ПроцессИсполняемыйФайлНеНайден")
&ОжидаемоеПравилоОшибки("process.executable_not_found.unix")
Функция ПолучитьОшибкуОтсутствующегоПриложенияLinux() Экспорт

	Возврат ПолучитьОшибкуОтсутствующегоПриложенияUnix();

КонецФункции

&ВключенНаОС("MacOS", Причина = "Сообщение Process.Start для macOS")
&ОжидаемыйКодОшибки("ПроцессИсполняемыйФайлНеНайден")
&ОжидаемоеПравилоОшибки("process.executable_not_found.unix")
Функция ПолучитьОшибкуОтсутствующегоПриложенияMacOS() Экспорт

	Возврат ПолучитьОшибкуОтсутствующегоПриложенияUnix();

КонецФункции

Функция ПолучитьОшибкуОтсутствующегоПриложенияUnix()

	Путь = ОбъединитьПути(
		ТекущийСценарий().Каталог,
		"fixtures",
		"гарантированно-отсутствующее-приложение-native-errors"
	);
	Ожидаем.Что(Новый Файл(Путь).Существует()).ЭтоЛожь();

	Попытка
		Процесс = СоздатьПроцесс(Путь);
		Процесс.Запустить();
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка запуска отсутствующего приложения не возникла";

КонецФункции

#КонецОбласти
