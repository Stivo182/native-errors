#Область СлужебныеПроцедурыИФункции

&ОжидаемыйКодОшибки("ПроцессИсполняемыйФайлНеНайден")
&ОжидаемоеПравилоОшибки("process.executable_not_found.unix")
Функция ПолучитьОшибкуОтсутствующегоПриложенияUnix() Экспорт

	Путь = ОбъединитьПути(
		ТекущийСценарий().Каталог,
		"fixtures",
		"гарантированно-отсутствующее-приложение-native-errors"
	);
	Ожидаем.Что(Новый Файл(Путь).Существует()).ЭтоЛожь();

	Попытка
		ЗапуститьПриложение(Путь);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ТекстОшибки = "Ожидаемая ошибка запуска "
		+ "отсутствующего приложения не возникла";
	ВызватьИсключение ТекстОшибки;

КонецФункции

#КонецОбласти
