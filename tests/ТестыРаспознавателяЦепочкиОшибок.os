#Использовать asserts
#Использовать "../src"
#Использовать "../src/internal"

#Область Тесты

&Тест
Процедура ТестДолжен_ИскатьНативныеТипыВПорядкеПереданногоСписка() Экспорт

	// Подготовка
	Ошибка = СоздатьЦепочкуНативныхОшибок();
	Распознаватель = Новый РаспознавательЦепочкиОшибок(Ошибка);
	НативныеТипы = Новый Массив;
	НативныеТипы.Добавить("System.Net.Sockets.SocketException");
	НативныеТипы.Добавить("System.Net.WebException");

	// Действие
	НайденныйТип = Распознаватель.НайтиТип(НативныеТипы);

	// Проверка
	Ожидаем.Что(НайденныйТип).Равно("System.Net.Sockets.SocketException");

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеСопоставлятьТипИОкончаниеИзРазныхКадров() Экспорт

	// Подготовка
	Причина = СоздатьВнешнююОшибку("External exception (System.IO.IOException): inner suffix");
	Ошибка = СоздатьВнешнююОшибку(
		"External exception (System.Net.WebException): outer message",
		Причина
	);
	Распознаватель = Новый РаспознавательЦепочкиОшибок(Ошибка);

	// Действие
	Результат = Распознаватель.СодержитТипИОкончаниеСообщения(
		"System.Net.WebException",
		"inner suffix"
	);

	// Проверка
	Ожидаем.Что(Результат).Равно(Ложь);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НаходитьТочноеОбычноеСообщение() Экспорт

	// Подготовка
	Ошибка = СоздатьВнешнююОшибку("Обычное сообщение");
	Распознаватель = Новый РаспознавательЦепочкиОшибок(Ошибка);

	// Действие
	Результат = Распознаватель.СодержитТочноеСообщение("Обычное сообщение");

	// Проверка
	Ожидаем.Что(Результат).Равно(Истина);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИндексироватьРусскийИАнглийскийМаркерыТипа() Экспорт

	// Подготовка
	Причина = СоздатьВнешнююОшибку("External exception (System.IO.IOException): en");
	Ошибка = СоздатьВнешнююОшибку(
		"Внешнее исключение (System.Net.WebException): ru",
		Причина
	);
	Распознаватель = Новый РаспознавательЦепочкиОшибок(Ошибка);

	// Действие
	НайденРусскийТип = Распознаватель.СодержитТип("System.Net.WebException");
	НайденАнглийскийТип = Распознаватель.СодержитТип("System.IO.IOException");

	// Проверка
	Ожидаем.Что(НайденРусскийТип).Равно(Истина);
	Ожидаем.Что(НайденАнглийскийТип).Равно(Истина);

КонецПроцедуры

&Тест
Процедура ТестДолжен_КлассифицироватьБезСостоянияКлассификатора() Экспорт

	// Подготовка
	Ошибка = ПолучитьОшибкуЧтенияJSONДоОткрытия();
	Распознаватель = Новый РаспознавательЦепочкиОшибок(Ошибка);
	Классификатор = Новый КлассификаторОшибокJSON;

	// Действие
	Результат = Классификатор.Классифицировать(Ошибка, Распознаватель);

	// Проверка
	Ожидаем.Что(Результат).ИмеетТип("ИнформацияОбОшибке");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИндексироватьНативныеИсключенияИзПодробногоПредставления() Экспорт

	// Подготовка
	Описание = "{Модуль Тест / Ошибка в строке: 1 / "
		+ "Внешнее исключение (System.Net.WebException): внешняя ошибка}" + Символы.ПС
		+ "по причине:" + Символы.ПС
		+ "External exception (System.IO.IOException): глубинная ошибка";
	Ошибка = СоздатьВнешнююОшибку(Описание);
	Распознаватель = Новый РаспознавательЦепочкиОшибок(Ошибка);

	// Действие
	НайденВнешнийТип = Распознаватель.СодержитТип("System.Net.WebException");
	НайденГлубинныйТип = Распознаватель.СодержитТип("System.IO.IOException");

	// Проверка
	Ожидаем.Что(НайденВнешнийТип).ЭтоИстина();
	Ожидаем.Что(НайденГлубинныйТип).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИндексироватьПричиныИзПодробногоПредставления() Экспорт

	// Подготовка
	Описание = "{Модуль Тест / Ошибка в строке: 1 / "
		+ "Внешнее исключение (System.Net.WebException): внешняя ошибка}" + Символы.ПС
		+ "по причине:" + Символы.ПС
		+ "промежуточная причина" + Символы.ПС + Символы.ПС
		+ "по причине:" + Символы.ПС
		+ "глубинная причина";
	Ошибка = СоздатьВнешнююОшибку(Описание);
	Распознаватель = Новый РаспознавательЦепочкиОшибок(Ошибка);

	// Действие
	НайденаПромежуточнаяПричина = Распознаватель.СодержитТочноеСообщение(
		"промежуточная причина");
	НайденаГлубиннаяПричина = Распознаватель.СодержитТочноеСообщение(
		"глубинная причина");

	// Проверка
	Ожидаем.Что(НайденаПромежуточнаяПричина).ЭтоИстина();
	Ожидаем.Что(НайденаГлубиннаяПричина).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьЦепочкуНативныхОшибок()

	Причина = СоздатьВнешнююОшибку(
		"External exception (System.Net.WebException): web exception"
	);
	Возврат СоздатьВнешнююОшибку(
		"External exception (System.Net.Sockets.SocketException): socket exception",
		Причина
	);

КонецФункции

Функция СоздатьВнешнююОшибку(Описание, Причина = Неопределено)

	Параметры = Новый Структура("Источник", "Тест");
	Если Причина = Неопределено Тогда
		Возврат Новый ИнформацияОбОшибке(Описание, Параметры);
	КонецЕсли;

	Возврат Новый ИнформацияОбОшибке(Описание, Параметры, Причина);

КонецФункции

Функция ПолучитьОшибкуЧтенияJSONДоОткрытия()

	Попытка
		Чтение = Новый ЧтениеJSON;
		Результат = Чтение.Прочитать();
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка чтения JSON не возникла";

КонецФункции

#КонецОбласти
