Процедура ТестДолжен_НаходитьДвуязычныйШаблонСАнглийскимВариантомПервым() Экспорт

	// Подготовка
	Ошибка = СоздатьВнешнююОшибку("русское сообщение");
	Распознаватель = Новый РаспознавательЦепочкиОшибок(Ошибка);

	// Действие
	Результат = Распознаватель.СодержитТочноеСообщение(
		"en = 'english message'; ru = 'русское сообщение'"
	);

	// Проверка
	Ожидаем.Что(Результат).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИндексироватьРусскийИАнглийскийМаркерыТипа() Экспорт

	// Подготовка
	Причина = СоздатьВнешнююОшибку("External exception (System.IO.IOException): en");
	Ошибка = СоздатьВнешнююОшибку(
		"Внешнее исключение (System.Net.WebException): ru",
		Причина
	);
	Распознаватель = Новый РаспознавательЦепочкиОшибок(Ошибка);

	// Действие
	НайденРусскийТип = Распознаватель.СодержитТип("System.Net.WebException");
	НайденАнглийскийТип = Распознаватель.СодержитТип("System.IO.IOException");

	// Проверка
	Ожидаем.Что(НайденРусскийТип).Равно(Истина);
	Ожидаем.Что(НайденАнглийскийТип).Равно(Истина);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НаходитьАнглийскийПрефиксСообщения() Экспорт

	// Подготовка
	Ошибка = СоздатьВнешнююОшибку("English prefix and continuation");
	Распознаватель = Новый РаспознавательЦепочкиОшибок(Ошибка);

	// Действие
	НайденПрефикс = Распознаватель.СодержитПрефиксСообщения(
		"en = 'English prefix'; ru = 'Русский префикс'"
	);
	НеНайденПрефикс = Распознаватель.СодержитПрефиксСообщения("Отсутствующий префикс");

	// Проверка
	Ожидаем.Что(НайденПрефикс).ЭтоИстина();
	Ожидаем.Что(НеНайденПрефикс).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИскатьФрагментыОбычныхИЛокализованныхШаблонов() Экспорт

	// Подготовка
	Ошибка = СоздатьВнешнююОшибку("Префикс English fragment окончание");
	Распознаватель = Новый РаспознавательЦепочкиОшибок(Ошибка);

	// Действие
	НайденАнглийскийФрагмент = Распознаватель.СодержитФрагментСообщения(
		"ru = 'Русский фрагмент'; en = 'English fragment'"
	);
	НайденОтсутствующийФрагмент = Распознаватель.СодержитФрагментСообщения(
		"Отсутствующий фрагмент"
	);

	// Проверка
	Ожидаем.Что(НайденАнглийскийФрагмент).ЭтоИстина();
	Ожидаем.Что(НайденОтсутствующийФрагмент).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИскатьФрагментСОкончаниемПоОбычномуИЛокализованномуШаблону() Экспорт

	// Подготовка
	Ошибка = СоздатьВнешнююОшибку("English start значение English end");
	Распознаватель = Новый РаспознавательЦепочкиОшибок(Ошибка);

	// Действие
	НайденоАнглийскоеСообщение = Распознаватель.СодержитФрагментИОкончаниеСообщения(
		"ru = 'Русское начало'; en = 'English start'",
		"ru = 'Русское окончание'; en = 'English end'"
	);
	НайденоСообщениеСОтсутствующимФрагментом = Распознаватель.СодержитФрагментИОкончаниеСообщения(
		"Отсутствующий фрагмент",
		"English end"
	);

	// Проверка
	Ожидаем.Что(НайденоАнглийскоеСообщение).ЭтоИстина();
	Ожидаем.Что(НайденоСообщениеСОтсутствующимФрагментом).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_НаходитьФрагментВСообщенииНативногоТипа() Экспорт

	// Подготовка
	Ошибка = СоздатьВнешнююОшибку(
		"External exception (System.IO.IOException): начало English fragment окончание"
	);
	Распознаватель = Новый РаспознавательЦепочкиОшибок(Ошибка);

	// Действие
	НайденФрагмент = Распознаватель.СодержитТипИФрагментСообщения(
		"System.IO.IOException",
		"en = 'English fragment'; ru = 'Русский фрагмент'"
	);
	НеНайденФрагмент = Распознаватель.СодержитТипИФрагментСообщения(
		"System.Net.WebException",
		"English fragment"
	);

	// Проверка
	Ожидаем.Что(НайденФрагмент).ЭтоИстина();
	Ожидаем.Что(НеНайденФрагмент).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_НаходитьАнглийскоеОбрамлениеСообщенияНативногоТипа() Экспорт

	// Подготовка
	Ошибка = СоздатьВнешнююОшибку(
		"External exception (System.IO.IOException): English start значение English end"
	);
	Распознаватель = Новый РаспознавательЦепочкиОшибок(Ошибка);

	// Действие
	НайденоОбрамление = Распознаватель.СодержитТипИОбрамлениеСообщения(
		"System.IO.IOException",
		"en = 'English start'; ru = 'Русское начало'",
		"en = 'English end'; ru = 'Русское окончание'"
	);
	НеНайденоОбрамление = Распознаватель.СодержитТипИОбрамлениеСообщения(
		"System.Net.WebException",
		"English start",
		"English end"
	);

	// Проверка
	Ожидаем.Что(НайденоОбрамление).ЭтоИстина();
	Ожидаем.Что(НеНайденоОбрамление).ЭтоЛожь();

КонецПроцедуры

