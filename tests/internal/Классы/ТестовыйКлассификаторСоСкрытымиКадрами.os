#Использовать errors

#Область ПрограммныйИнтерфейс

Функция Классифицировать(Ошибка, Распознаватель) Экспорт

	Если Не Распознаватель.СодержитТочноеСообщение("Неизвестная ошибка классификации") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Распознаватель.Кадры();
	Исключение
		Возврат ФабрикаОшибок.Обернуть(
			Ошибка,
			"test.frames_hidden",
			"Кадры распознавателя скрыты",
			Новый Структура
		);
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

#КонецОбласти
