Перем _НомерСледующейПроверкиПорта; // Число

#Область СлужебныйПрограммныйИнтерфейс

// Возвращает TCP-порт, свободный в момент проверки.
//
// Возвращаемое значение:
//  Число - Номер свободного TCP-порта.
//
// Исключения:
//  Если в проверяемом диапазоне не найден свободный TCP-порт.
Функция ПолучитьСвободныйПорт() Экспорт

	ДиапазонПортов = 40000;
	НачальныйПорт = 20000;

	Для НомерПопытки = 1 По ДиапазонПортов Цикл
		Порт = НачальныйПорт
			+ ((ТекущийПроцесс().Идентификатор + _НомерСледующейПроверкиПорта) % ДиапазонПортов);
		_НомерСледующейПроверкиПорта = _НомерСледующейПроверкиПорта + 1;

		Попытка
			Сервер = Новый TCPСервер(Порт);
			Сервер.Запустить();
			Сервер.Остановить();
			Возврат Порт;
		Исключение
		КонецПопытки;
	КонецЦикла;

	ВызватьИсключение "Не удалось найти свободный TCP-порт для тестовой фикстуры";

КонецФункции

#КонецОбласти

_НомерСледующейПроверкиПорта = 0;
