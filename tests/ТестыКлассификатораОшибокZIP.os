#Использовать errors
#Использовать "../src"
#Использовать "./internal"

#Область ОбработчикиСобытий

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

#КонецОбласти

#Область Тесты

&ПараметризованныйТест
&ИсточникВыражение("() -> ПараметрыИсточниковОшибок()")
Процедура ТестДолжен_КлассифицироватьИсточникОшибки(ИдентификаторПравила, ИмяИсточника) Экспорт

	МатрицаИсточниковОшибок.ПроверитьИсточник(ЭтотОбъект, ИмяИсточника);

КонецПроцедуры

Функция ПараметрыИсточниковОшибок() Экспорт

	Возврат МатрицаИсточниковОшибок.ПараметрыИсточников(ЭтотОбъект, 2);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&ОжидаемыйКодОшибки("АрхивНеОткрыт")
&ОжидаемоеПравилоОшибки("zip.not_open")
Функция ПолучитьОшибкуЧтенияZIPДоОткрытия() Экспорт

	Попытка
		Чтение = Новый ЧтениеZipФайла;
		Элементы = Чтение.Элементы;
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка чтения ZIP до открытия не возникла";

КонецФункции

&ОжидаемыйКодОшибки("АрхивНеОткрыт")
&ОжидаемоеПравилоОшибки("zip.not_open")
Функция ПолучитьОшибкуЗаписиZIPДоОткрытия() Экспорт

	Попытка
		Запись = Новый ЗаписьZipФайла;
		Запись.Записать();
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка записи ZIP до открытия не возникла";

КонецФункции

#КонецОбласти
