&ОжидаемыйКодОшибки("НедопустимоеЗначениеАргумента")
&ОжидаемоеПравилоОшибки("argument.invalid_value.stream_buffer_size")
Функция ПолучитьОшибкуОтрицательногоРазмераБуфераФайловогоПотока() Экспорт

	ИмяФайла = ПолучитьИмяВременногоФайла();
	ИсходнаяОшибка = Неопределено;

	Попытка
		Поток = Новый ФайловыйПоток(
			ИмяФайла,
			РежимОткрытияФайла.ОткрытьИлиСоздать,
			-1
		);
	Исключение
		ИсходнаяОшибка = ИнформацияОбОшибке();
	КонецПопытки;

	УдалитьФайлы(ИмяФайла);
	Если ИсходнаяОшибка <> Неопределено Тогда
		Возврат ИсходнаяОшибка;
	КонецЕсли;

	ВызватьИсключение "Ожидаемая ошибка отрицательного размера буфера файлового потока не возникла";

КонецФункции

