	Описания.Добавить("Stream was not readable.");
	Описания.Добавить("External exception (System.IO.IOException): Stream was not readable.");
	Описания.Добавить("External exception (System.ArgumentException): Stream was not writable.");
	Описания.Добавить("External exception (System.ArgumentException): Stream was not readable. Details");

	// Действие и Проверка
	Для Каждого Описание Из Описания Цикл
		Ошибка = Новый ИнформацияОбОшибке(Описание, Новый Структура("Источник", "Тест"));
		ТестовыйПробросПодробногоПредставления.ПроверитьНеклассифицированностьВариантами(Ошибка);
	КонецЦикла;

