#Область СлужебныеПроцедурыИФункции

&ОжидаемыйКодОшибки("ПотокЗакрыт")
Функция ПолучитьОшибкуЗакрытогоПотока() Экспорт

	Попытка
		Поток = Новый ПотокВПамяти;
		Поток.Закрыть();
		Поток.Записать(Новый БуферДвоичныхДанных(1), 0, 1);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка закрытого потока не возникла";

КонецФункции

&ОжидаемыйКодОшибки("ПотокЗакрыт")
Функция ПолучитьОшибкуЗакрытогоФайловогоПотока() Экспорт

	ИмяФайла = ПолучитьИмяВременногоФайла();
	Поток = ФайловыеПотоки.ОткрытьДляЗаписи(ИмяФайла);
	Поток.Закрыть();
	ИсходнаяОшибка = Неопределено;

	Попытка
		Позиция = Поток.ТекущаяПозиция();
	Исключение
		ИсходнаяОшибка = ИнформацияОбОшибке();
	КонецПопытки;

	УдалитьФайлы(ИмяФайла);
	Если ИсходнаяОшибка <> Неопределено Тогда
		Возврат ИсходнаяОшибка;
	КонецЕсли;

	ВызватьИсключение "Ожидаемая ошибка закрытого файлового потока не возникла";

КонецФункции

&ОжидаемыйКодОшибки("ПотокВыходЗаГраницыБуфера")
Функция ПолучитьОшибкуНеверногоДиапазонаБуфера() Экспорт

	Попытка
		Поток = Новый ПотокВПамяти;
		Поток.Записать(Новый БуферДвоичныхДанных(2), 1, 2);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка неверного диапазона буфера не возникла";

КонецФункции

&ОжидаемыйКодОшибки("ПотокНеПоддерживаетЗапись")
Функция ПолучитьОшибкуЗаписиВПотокТолькоДляЧтения() Экспорт

	Попытка
		Поток = Новый ПотокВПамяти;
		ПотокТолькоДляЧтения = Поток.ПолучитьПотокТолькоДляЧтения();
		ПотокТолькоДляЧтения.Записать(Новый БуферДвоичныхДанных(1), 0, 1);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка записи в поток только для чтения не возникла";

КонецФункции

&ОжидаемыйКодОшибки("ПотокЗакрыт")
