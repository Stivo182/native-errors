&ОжидаемыйКодОшибки("ПотокНеПоддерживаетТаймауты")
&ОжидаемоеПравилоОшибки("stream.timeout_not_supported")
Функция ПолучитьОшибкуТаймаутаФайловогоПотока() Экспорт

	ИмяФайла = ПолучитьИмяВременногоФайла();
	Поток = ФайловыеПотоки.ОткрытьДляЗаписи(ИмяФайла);
	ИсходнаяОшибка = Неопределено;

	Попытка
		Таймаут = Поток.ТаймаутЗаписи;
	Исключение
		ИсходнаяОшибка = ИнформацияОбОшибке();
	КонецПопытки;

	Поток.Закрыть();
	УдалитьФайлы(ИмяФайла);
	Если ИсходнаяОшибка <> Неопределено Тогда
		Возврат ИсходнаяОшибка;
	КонецЕсли;

