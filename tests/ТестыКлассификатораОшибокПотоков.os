#Область СлужебныеПроцедурыИФункции

&ОжидаемыйКодОшибки("ПотокНедоступенДляЧтения")
&ОжидаемоеПравилоОшибки("stream.not_readable")
Функция ПолучитьОшибкуЧтенияСтрокиИзЗакрытогоПотока() Экспорт

	Поток = Новый ПотокВПамяти;
	Чтение = Новый ЧтениеДанных(Поток);
	Поток.Закрыть();

	Попытка
		Чтение.ПрочитатьСтроку();
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка чтения строки из закрытого потока не возникла";

КонецФункции

&ОжидаемыйКодОшибки("ПотокЗакрыт")
&ОжидаемоеПравилоОшибки("stream.closed.dotnet_stream")
Функция ПолучитьОшибкуЗакрытогоПотока() Экспорт

	Попытка
		Поток = Новый ПотокВПамяти;
		Поток.Закрыть();
		Поток.Записать(Новый БуферДвоичныхДанных(1), 0, 1);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка закрытого потока не возникла";

КонецФункции

&ОжидаемыйКодОшибки("ПотокЗакрыт")
&ОжидаемоеПравилоОшибки("stream.closed.dotnet_file")
Функция ПолучитьОшибкуЗакрытогоФайловогоПотока() Экспорт

	ИмяФайла = ПолучитьИмяВременногоФайла();
	Поток = ФайловыеПотоки.ОткрытьДляЗаписи(ИмяФайла);
	Поток.Закрыть();
	ИсходнаяОшибка = Неопределено;

	Попытка
		Позиция = Поток.ТекущаяПозиция();
	Исключение
		ИсходнаяОшибка = ИнформацияОбОшибке();
	КонецПопытки;

	УдалитьФайлы(ИмяФайла);
	Если ИсходнаяОшибка <> Неопределено Тогда
		Возврат ИсходнаяОшибка;
	КонецЕсли;

	ВызватьИсключение "Ожидаемая ошибка закрытого файлового потока не возникла";

КонецФункции

