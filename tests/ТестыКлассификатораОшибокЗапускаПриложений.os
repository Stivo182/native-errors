#Область СлужебныеПроцедурыИФункции

&ОжидаемыйКодОшибки("ПроцессИсполняемыйФайлНеНайден")
&ОжидаемоеПравилоОшибки("process.executable_not_found")
Функция ПолучитьОшибкуЗапускаОтсутствующегоПриложения() Экспорт

	Путь = ОбъединитьПути(
		ТекущийСценарий().Каталог,
		"fixtures",
		"гарантированно-отсутствующее-приложение-native-errors.exe"
	);
	Ожидаем.Что(Новый Файл(Путь).Существует()).Равно(Ложь);

	Попытка
		ЗапуститьПриложение(Путь);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка запуска отсутствующего приложения не возникла";

КонецФункции

#КонецОбласти
