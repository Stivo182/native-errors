#Использовать errors
#Использовать "../src"
#Использовать "./internal"

#Область ОбработчикиСобытий

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

#КонецОбласти

#Область Тесты

&ПараметризованныйТест()
&ИсточникВыражение("() -> ПараметрыИсточниковОшибок()")
Процедура ТестДолжен_КлассифицироватьИсточникОшибки(
	ИдентификаторПравила,
	ИмяИсточника) Экспорт

	// Действие и Проверка
	МатрицаИсточниковОшибок.ПроверитьИсточник(ЭтотОбъект, ИмяИсточника);

КонецПроцедуры

Функция ПараметрыИсточниковОшибок() Экспорт

	Возврат МатрицаИсточниковОшибок.ПараметрыИсточников(ЭтотОбъект, 1);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&ВключенНаОС("Windows", Причина = "Сообщение Process.Start для Windows")
&ОжидаемыйКодОшибки("ПроцессИсполняемыйФайлНеНайден")
&ОжидаемоеПравилоОшибки("process.executable_not_found")
Функция ПолучитьОшибкуЗапускаОтсутствующегоПриложения() Экспорт

	Путь = ОбъединитьПути(
		ТекущийСценарий().Каталог,
		"fixtures",
		"гарантированно-отсутствующее-приложение-native-errors.exe"
	);
	Ожидаем.Что(Новый Файл(Путь).Существует()).Равно(Ложь);

	Попытка
		ЗапуститьПриложение(Путь);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка запуска отсутствующего приложения не возникла";

КонецФункции

#КонецОбласти
