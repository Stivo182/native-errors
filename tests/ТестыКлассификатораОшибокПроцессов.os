#Область СлужебныеПроцедурыИФункции

&ОжидаемыйКодОшибки("ПроцессКодВозвратаНедоступен")
&ОжидаемоеПравилоОшибки("process.exit_code_unavailable")
Функция ПолучитьОшибкуКодаВозвратаНезавершенногоПроцесса() Экспорт

	Процесс = ТекущийПроцесс();
	Ожидаем.Что(Процесс.Завершен).Равно(Ложь);

	Попытка
		КодВозврата = Процесс.КодВозврата;
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка получения кода возврата незавершенного процесса не возникла";

КонецФункции

#КонецОбласти
