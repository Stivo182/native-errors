#Использовать "../src"
#Использовать "../src/internal"

Перем _Ошибка; // ИнформацияОбОшибке
Перем _ОшибкаВПодробномПредставлении; // ИнформацияОбОшибке
Перем _ГлубокаяОшибка; // ИнформацияОбОшибке
Перем _ПлоскаяОшибка; // ИнформацияОбОшибке
Перем _Распознаватель; // РаспознавательОшибки
Перем _НативныеТипы; // Массив из Строка

#Область ОбработчикиСобытий

&МониторингПамяти
&КолонкаМакс
Процедура ПриСозданииОбъекта() Экспорт

КонецПроцедуры

&ПередКаждымКейсом
Процедура ПодготовитьДанные(Контекст) Экспорт

	_Ошибка = СоздатьЦепочкуОшибок();
	_ОшибкаВПодробномПредставлении = ПолучитьОшибкуСПодробнымПредставлением(_Ошибка);
	_ГлубокаяОшибка = СоздатьГлубокуюЦепочкуОшибок();
	_ПлоскаяОшибка = СоздатьВнешнююОшибку(
		"External exception (System.Net.WebException): web exception"
	);
	_Распознаватель = СоздатьРаспознаватель(_Ошибка);
	_НативныеТипы = Новый Массив;
	_НативныеТипы.Добавить("System.Net.Sockets.SocketException");
	_НативныеТипы.Добавить("System.Net.WebException");

КонецПроцедуры

#КонецОбласти

#Область Бенчмарки

&Бенчмарк(Наименование = "Распознавание: создание цепочки и распознавателя")
Процедура СоздатьРаспознавательЦепочкиИОшибки() Экспорт

	Результат = СоздатьРаспознаватель(_Ошибка);

КонецПроцедуры

&Бенчмарк(Наименование = "Распознавание: плоская ошибка")
Процедура СоздатьРаспознавательПлоскойОшибки() Экспорт

	Результат = СоздатьРаспознаватель(_ПлоскаяОшибка);

КонецПроцедуры

&Бенчмарк(Наименование = "Распознавание: глубокая цепочка")
Процедура СоздатьРаспознавательГлубокойЦепочки() Экспорт

	Результат = СоздатьРаспознаватель(_ГлубокаяОшибка);

КонецПроцедуры

&Бенчмарк(Наименование = "Распознавание: подробное представление")
Процедура СоздатьРаспознавательПодробногоПредставления() Экспорт

	Результат = СоздатьРаспознаватель(_ОшибкаВПодробномПредставлении);

КонецПроцедуры

&Бенчмарк(Наименование = "Распознавание: проверка нативного типа")
Процедура ПроверитьНативныйТип() Экспорт

	Результат = _Распознаватель.СодержитТип("System.Net.Sockets.SocketException");

КонецПроцедуры

&Бенчмарк(Наименование = "Распознавание: поиск нативного типа")
Процедура НайтиНативныйТип() Экспорт

	Результат = _Распознаватель.НайтиТип(_НативныеТипы);

КонецПроцедуры

&Бенчмарк(Наименование = "Распознавание: точное сообщение")
Процедура ПроверитьТочноеСообщение() Экспорт

	Результат = _Распознаватель.СодержитТочноеСообщение(
		"External exception (System.Net.Sockets.SocketException): socket exception"
	);

КонецПроцедуры

&Бенчмарк(Наименование = "Распознавание: префикс сообщения")
Процедура ПроверитьПрефиксСообщения() Экспорт

	Результат = _Распознаватель.СодержитПрефиксСообщения("External exception (");

КонецПроцедуры

&Бенчмарк(Наименование = "Распознавание: тип и окончание сообщения")
Процедура ПроверитьТипИОкончаниеСообщения() Экспорт

	Результат = _Распознаватель.СодержитТипИОкончаниеСообщения(
		"System.Net.Sockets.SocketException",
		"socket exception"
	);

КонецПроцедуры

&Бенчмарк(Наименование = "Распознавание: тип и фрагмент сообщения")
Процедура ПроверитьТипИФрагментСообщения() Экспорт

	Результат = _Распознаватель.СодержитТипИФрагментСообщения(
		"System.Net.WebException",
		"web exception"
	);

КонецПроцедуры

&Бенчмарк(Наименование = "Распознавание: тип и обрамление сообщения")
Процедура ПроверитьТипИОбрамлениеСообщения() Экспорт

	Результат = _Распознаватель.СодержитТипИОбрамлениеСообщения(
		"System.Net.WebException",
		"External exception (",
		"web exception"
	);

КонецПроцедуры

&Бенчмарк(Наименование = "Распознавание: префикс и окончание сообщения")
Процедура ПроверитьПрефиксИОкончаниеСообщения() Экспорт

	Результат = _Распознаватель.СодержитПрефиксИОкончаниеСообщения(
		"External exception (",
		"web exception"
	);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьРаспознаватель(Ошибка)

	Цепочка = Новый ЦепочкаКадровОшибки(Новый СнимокКадраОшибки(Ошибка));
	Возврат Новый РаспознавательОшибки(Цепочка.Кадры());

КонецФункции

Функция СоздатьЦепочкуОшибок()

	Причина = СоздатьВнешнююОшибку(
		"External exception (System.Net.WebException): web exception"
	);
	Возврат СоздатьВнешнююОшибку(
		"External exception (System.Net.Sockets.SocketException): socket exception",
		Причина
	);

КонецФункции

Функция СоздатьГлубокуюЦепочкуОшибок()

	Причина = СоздатьВнешнююОшибку("External exception (System.Exception): level 0");
	Для Уровень = 1 По 5 Цикл
		Причина = СоздатьВнешнююОшибку(
			СтрШаблон("External exception (System.Exception): level %1", Уровень),
			Причина
		);
	КонецЦикла;

	Возврат Причина;

КонецФункции

Функция ПолучитьОшибкуСПодробнымПредставлением(Ошибка)

	Попытка
		ВызватьИсключение ПодробноеПредставлениеОшибки(Ошибка);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка подробного представления не возникла";

КонецФункции

Функция СоздатьВнешнююОшибку(Описание, Причина = Неопределено)

	Параметры = Новый Структура("Источник", "Бенчмарк");
	Если Причина = Неопределено Тогда
		Возврат Новый ИнформацияОбОшибке(Описание, Параметры);
	КонецЕсли;

	Возврат Новый ИнформацияОбОшибке(Описание, Параметры, Причина);

КонецФункции

#КонецОбласти
