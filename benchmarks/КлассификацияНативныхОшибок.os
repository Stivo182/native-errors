#Использовать "../src"
#Использовать "./Поддержка"

Перем _ОшибкаJSON; // ИнформацияОбОшибке
Перем _ОшибкаJSONВПодробномПредставлении; // ИнформацияОбОшибке
Перем _ОшибкаФайловойСистемы; // ИнформацияОбОшибке
Перем _ОшибкаПотока; // ИнформацияОбОшибке
Перем _ОшибкаXML; // ИнформацияОбОшибке
Перем _ОшибкаТекста; // ИнформацияОбОшибке
Перем _ОшибкаДвоичныхДанных; // ИнформацияОбОшибке
Перем _ОшибкаHTTP; // ИнформацияОбОшибке
Перем _НераспознаннаяОшибка; // ИнформацияОбОшибке
Перем _НераспознаннаяОшибкаВПодробномПредставлении; // ИнформацияОбОшибке
Перем _НормализованнаяОшибка; // ИнформацияОбОшибке
Перем _Классификатор; // КлассификаторНативныхОшибок
Перем _КлассификаторСПользовательскимУспехом; // КлассификаторНативныхОшибок
Перем _КлассификаторСПользовательскимПромахом; // КлассификаторНативныхОшибок

#Область ОбработчикиСобытий

&ПередКаждымКейсом
Процедура ПодготовитьДанные(Контекст) Экспорт

	_Классификатор = Новый КлассификаторНативныхОшибок;

	_ОшибкаJSON = ПолучитьОшибкуЧтенияJSONДоОткрытия();
	_ОшибкаФайловойСистемы = ПолучитьОшибкуЧтенияОтсутствующегоФайла();
	_ОшибкаПотока = ПолучитьОшибкуЗакрытогоПотока();
	_ОшибкаXML = ПолучитьОшибкуЗаписиXMLДоОткрытия();
	_ОшибкаТекста = ПолучитьОшибкуЧтенияТекстаДоОткрытия();
	_ОшибкаДвоичныхДанных = ПолучитьОшибкуНекорректнойHexСтроки();
	_ОшибкаHTTP = ПолучитьОшибкуНекорректногоHTTPМетода();

	_НераспознаннаяОшибка = Новый ИнформацияОбОшибке(
		"External exception (System.InvalidOperationException): unknown error",
		Новый Структура("Источник", "Бенчмарк")
	);
	_ОшибкаJSONВПодробномПредставлении = ПолучитьОшибкуСПодробнымПредставлением(_ОшибкаJSON);
	_НераспознаннаяОшибкаВПодробномПредставлении = ПолучитьОшибкуСПодробнымПредставлением(
		_НераспознаннаяОшибка
	);
	_НормализованнаяОшибка = _Классификатор.Классифицировать(_ОшибкаJSON);

	_КлассификаторСПользовательскимУспехом = Новый КлассификаторНативныхОшибок;
	_КлассификаторСПользовательскимУспехом.ДобавитьКлассификатор(
		Новый ПользовательскийКлассификаторБенчмарка("benchmark.custom")
	);

	_КлассификаторСПользовательскимПромахом = Новый КлассификаторНативныхОшибок;
	_КлассификаторСПользовательскимПромахом.ДобавитьКлассификатор(
		Новый ПользовательскийКлассификаторБенчмарка
	);

КонецПроцедуры

#КонецОбласти

#Область Бенчмарки

&Бенчмарк(Наименование = "Классификация: создание классификатора")
Процедура СоздатьКлассификаторНативныхОшибок() Экспорт

	Результат = Новый КлассификаторНативныхОшибок;

КонецПроцедуры

&Бенчмарк(Наименование = "Классификация: чтение отсутствующего файла")
Процедура КлассифицироватьОшибкуФайловойСистемы() Экспорт

	Результат = _Классификатор.Классифицировать(_ОшибкаФайловойСистемы);

КонецПроцедуры

&Бенчмарк(Наименование = "Классификация: запись в закрытый поток")
Процедура КлассифицироватьОшибкуПотока() Экспорт

	Результат = _Классификатор.Классифицировать(_ОшибкаПотока);

КонецПроцедуры

&Бенчмарк(Наименование = "Классификация: чтение JSON до открытия")
Процедура КлассифицироватьРаспознаннуюОшибкуJSON() Экспорт

	Результат = _Классификатор.Классифицировать(_ОшибкаJSON);

КонецПроцедуры

&Бенчмарк(Наименование = "Классификация: запись XML до открытия")
Процедура КлассифицироватьОшибкуXML() Экспорт

	Результат = _Классификатор.Классифицировать(_ОшибкаXML);

КонецПроцедуры

&Бенчмарк(Наименование = "Классификация: чтение текста до открытия")
Процедура КлассифицироватьОшибкуТекста() Экспорт

	Результат = _Классификатор.Классифицировать(_ОшибкаТекста);

КонецПроцедуры

&Бенчмарк(Наименование = "Классификация: преобразование Hex-строки")
Процедура КлассифицироватьОшибкуДвоичныхДанных() Экспорт

	Результат = _Классификатор.Классифицировать(_ОшибкаДвоичныхДанных);

КонецПроцедуры

&Бенчмарк(Наименование = "Классификация: некорректный HTTP-метод")
Процедура КлассифицироватьОшибкуHTTP() Экспорт

	Результат = _Классификатор.Классифицировать(_ОшибкаHTTP);

КонецПроцедуры

&Бенчмарк(Наименование = "Классификация: нераспознанная ошибка")
Процедура КлассифицироватьНераспознаннуюОшибку() Экспорт

	Результат = _Классификатор.Классифицировать(_НераспознаннаяОшибка);

КонецПроцедуры

&Бенчмарк(Наименование = "Классификация: уже нормализованная ошибка")
Процедура ПропуститьУжеНормализованнуюОшибку() Экспорт

	Результат = _Классификатор.Классифицировать(_НормализованнаяОшибка);

КонецПроцедуры

&Бенчмарк(Наименование = "Классификация: пользовательский классификатор")
Процедура КлассифицироватьПользовательскимКлассификатором() Экспорт

	Результат = _КлассификаторСПользовательскимУспехом.Классифицировать(_ОшибкаJSON);

КонецПроцедуры

&Бенчмарк(Наименование = "Классификация: промах пользовательского классификатора")
Процедура ПерейтиОтПользовательскогоКоВстроенномуКлассификатору() Экспорт

	Результат = _КлассификаторСПользовательскимПромахом.Классифицировать(_ОшибкаJSON);

КонецПроцедуры

&Бенчмарк(Наименование = "Классификация: JSON в подробном представлении")
Процедура КлассифицироватьJSONВПодробномПредставлении() Экспорт

	Результат = _Классификатор.Классифицировать(_ОшибкаJSONВПодробномПредставлении);

КонецПроцедуры

&Бенчмарк(Наименование = "Классификация: нераспознанная ошибка в подробном представлении")
Процедура КлассифицироватьНераспознаннуюОшибкуВПодробномПредставлении() Экспорт

	Результат = _Классификатор.Классифицировать(_НераспознаннаяОшибкаВПодробномПредставлении);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьОшибкуЧтенияJSONДоОткрытия()

	Попытка
		Чтение = Новый ЧтениеJSON;
		Результат = Чтение.Прочитать();
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка чтения JSON не возникла";

КонецФункции

Функция ПолучитьОшибкуЧтенияОтсутствующегоФайла()

	Попытка
		Путь = ПолучитьИмяВременногоФайла();
		Чтение = Новый ЧтениеТекста(Путь);
		Результат = Чтение.Прочитать();
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка чтения отсутствующего файла не возникла";

КонецФункции

Функция ПолучитьОшибкуЗакрытогоПотока()

	Попытка
		Поток = Новый ПотокВПамяти;
		Поток.Закрыть();
		Поток.Записать(Новый БуферДвоичныхДанных(1), 0, 1);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка закрытого потока не возникла";

КонецФункции

Функция ПолучитьОшибкуЗаписиXMLДоОткрытия()

	Попытка
		Запись = Новый ЗаписьXML;
		Запись.ЗаписатьНачалоЭлемента("root");
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка записи XML не возникла";

КонецФункции

Функция ПолучитьОшибкуЧтенияТекстаДоОткрытия()

	Попытка
		Чтение = Новый ЧтениеТекста;
		Результат = Чтение.Прочитать();
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка чтения текста не возникла";

КонецФункции

Функция ПолучитьОшибкуНекорректнойHexСтроки()

	Попытка
		Буфер = ПолучитьБуферДвоичныхДанныхИзHexСтроки("0xA1B2C3");
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка преобразования Hex-строки не возникла";

КонецФункции

Функция ПолучитьОшибкуНекорректногоHTTPМетода()

	Попытка
		Соединение = Новый HTTPСоединение("127.0.0.1", 39782,,,, 1);
		Соединение.ВызватьHTTPМетод("ПЛОХОЙ МЕТОД", Новый HTTPЗапрос("/"));
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка HTTP-метода не возникла";

КонецФункции

Функция ПолучитьОшибкуСПодробнымПредставлением(Ошибка)

	Попытка
		ВызватьИсключение ПодробноеПредставлениеОшибки(Ошибка);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидаемая ошибка подробного представления не возникла";

КонецФункции

#КонецОбласти
